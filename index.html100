<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="logo.jpg"><title>مُحكم | Muhkam — تدقيق العقود وفق الأنظمة السعودية</title>

<!-- الخطوط: ثمانية (إن كانت مثبتة أو مرفقة) ثم Tajawal كبديل تلقائي -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>

<style>
/*
  خط ثمانية: حمّل الخط من fonts.thmanyah.com وضع الملفات بجانب index.html
  ثم فعّل الأسطر التالية (عدّل أسماء الملفات حسب ما حمّلته):

  @font-face{font-family:'Thmanyah Sans';font-weight:400;src:url('ThmanyahSans-Regular.woff2') format('woff2');}
  @font-face{font-family:'Thmanyah Sans';font-weight:700;src:url('ThmanyahSans-Bold.woff2') format('woff2');}
*/
:root{
  --ink:#ffffff; --muted:#cbd8ea;
  --violet:#2f7a78; --indigo:#263065; --sky:#1f9d74; --gold:#8DA7C7; --gold2:#BBBECC;
}
html{scroll-behavior:smooth}
body{
  font-family:'Thmanyah Sans','Thmanyah Serif Display','Tajawal',system-ui,sans-serif;
  color:var(--ink); background:#fff; overflow-x:hidden;
}
/* خلفية متدرجة على طراز دليل المشارك */
.aurora{position:fixed;inset:0;z-index:-1;pointer-events:none}
.aurora i{position:absolute;border-radius:50%;filter:blur(100px);opacity:.35}
.aurora i:nth-child(1){width:520px;height:520px;top:-160px;right:-140px;background:#8DA7C7}
.aurora i:nth-child(2){width:460px;height:460px;top:40%;left:-180px;background:#BBBECC}
.aurora i:nth-child(3){width:420px;height:420px;bottom:-140px;right:25%;background:#8DA7C7;opacity:.18}
.aurora::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.03) 0 1px,transparent 1px 96px)}
.grad-text{background:linear-gradient(100deg,var(--indigo),var(--violet) 45%,var(--sky));-webkit-background-clip:text;background-clip:text;color:transparent}
.gold-text{background:linear-gradient(100deg,#3F5F8A,var(--gold),var(--gold2));-webkit-background-clip:text;background-clip:text;color:transparent}

.glass{background:rgba(255,255,255,.72);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border:1px solid rgba(47,122,120,.14);box-shadow:0 20px 60px -24px rgba(38,48,101,.35)}
.ring-grad{position:relative}
.ring-grad::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;
  background:linear-gradient(135deg,var(--indigo),var(--violet),var(--sky),var(--gold));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}

.field{width:100%;background:#fff;border:1.5px solid #DCE3F0;border-radius:14px;padding:.8rem 1rem;color:var(--ink);transition:.2s}
.field:focus{outline:none;border-color:var(--violet);box-shadow:0 0 0 4px rgba(47,122,120,.13)}

.btn-main{background:linear-gradient(110deg,var(--indigo),var(--violet) 55%,var(--sky));color:#fff;font-weight:800;border-radius:14px;
  box-shadow:0 14px 30px -10px rgba(38,48,101,.6);transition:.25s;background-size:160% 100%}
.btn-main:hover:not(:disabled){background-position:100% 0;transform:translateY(-2px)}
.btn-main:disabled{opacity:.7;cursor:wait}
.btn-gold{background:linear-gradient(110deg,#3F5F8A,var(--gold),var(--gold2));color:#1F2D45;font-weight:700;border-radius:12px;transition:.2s}
.btn-gold:hover{filter:brightness(1.06);transform:translateY(-1px)}
.btn-ghost{background:#fff;border:1.5px solid #C9D4EA;color:var(--indigo);font-weight:700;border-radius:12px;transition:.2s}
.btn-ghost:hover{background:#EEF3FA}

.spinner{width:20px;height:20px;border-radius:50%;border:3px solid rgba(255,255,255,.4);border-top-color:#fff;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.pulse-dot{animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{50%{opacity:.35;transform:scale(.8)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* المذكرة القانونية */
.memo{background:#fff;border-radius:20px;border:1px solid #E3E9F5;box-shadow:0 30px 70px -30px rgba(38,48,101,.35);overflow:hidden}
.memo-head{background:linear-gradient(110deg,#E9EEFB,#EEF3FA 50%,#EAF7F2);border-bottom:3px solid var(--gold)}
.prose-ar{line-height:2;font-size:1.02rem;color:#263065}
.prose-ar h1,.prose-ar h2,.prose-ar h3{font-weight:800;margin:1.6rem 0 .7rem;line-height:1.5}
.prose-ar h1{font-size:1.5rem;color:var(--indigo)}
.prose-ar h2{font-size:1.25rem;color:var(--violet);padding-right:.8rem;border-right:4px solid var(--gold)}
.prose-ar h3{font-size:1.1rem;color:#1F7A6D}
.prose-ar p{margin:.6rem 0}
.prose-ar ul,.prose-ar ol{margin:.6rem 1.4rem .6rem 0;padding-right:.4rem}
.prose-ar ul{list-style:disc}.prose-ar ol{list-style:decimal}
.prose-ar li{margin:.3rem 0}
.prose-ar strong{color:var(--ink);font-weight:800}
.prose-ar blockquote{background:#FFFBEB;border-right:4px solid var(--gold);padding:.6rem 1rem;border-radius:10px;margin:1rem 0}
.prose-ar table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.95rem}
.prose-ar th{background:#E9EEFB;color:var(--indigo)}
.prose-ar th,.prose-ar td{border:1px solid #DCE3F0;padding:.55rem .7rem;text-align:right}
.prose-ar hr{border:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:1.5rem 0}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(30px);opacity:0;transition:.3s;z-index:50;
  background:var(--ink);color:#fff;padding:.7rem 1.2rem;border-radius:12px;font-weight:700}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media print{
  body *{visibility:hidden}
  #memo,#memo *{visibility:visible}
  #memo{position:absolute;inset:0;width:100%;box-shadow:none;border:0}
  .no-print{display:none!important}
  .aurora{display:none}
}

/* ===== طراز دليل المشارك: كحلي + أخضر مزرق + لمسة خضراء ===== */
:root{--mint:#8DA7C7}
body{background:linear-gradient(180deg,#263065 0%,#2c3d66 50%,#3c5d72 100%) fixed;color:#fff}
.grad-text{background-image:linear-gradient(100deg,#fff,#8DA7C7)}
.memo,#tplModal>div,.field{--ink:#263065;--muted:#5d6a8a;color:#263065}
.memo .grad-text,#tplModal .grad-text{background-image:linear-gradient(100deg,#263065,#2f7a78,#1f9d74)}
.glass{background:rgba(47,122,120,.28);border:1px solid rgba(255,255,255,.14);box-shadow:0 20px 60px -28px rgba(0,0,0,.5)}
.acc{position:relative}.acc::before{content:"";position:absolute;top:0;right:0;width:56px;height:3px;background:var(--mint);border-radius:0 0 0 3px}
.blk{background:#2f7a78;padding:0 .7rem;border-radius:4px;color:#fff}
.sec-title{display:flex;align-items:center;justify-content:center;gap:1rem}
.sec-title::before,.sec-title::after{content:"";height:1.5px;flex:1;max-width:150px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.6))}
.sec-title::after{transform:scaleX(-1)}
.toast{background:#0f1a3d}
@media print{body{background:#fff!important}}

/* ===== واجهة المحادثة ===== */
.avatar{width:34px;height:34px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;background:linear-gradient(135deg,#263065,#2f7a78 60%,#8DA7C7)}
.avatar-lg{width:42px;height:42px;font-size:1.2rem}
.chat-body{height:min(64vh,580px);min-height:380px;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:.9rem;scroll-behavior:smooth}
.bub{max-width:86%;padding:.7rem 1rem;border-radius:18px;line-height:1.9;font-size:.98rem;word-break:break-word}
.bub-u{background:linear-gradient(110deg,#2f7a78,#1f9d74);color:#fff;border-top-right-radius:6px;white-space:pre-wrap}
.bub-a{background:#fff;color:#263065;border-top-left-radius:6px;--ink:#263065;--muted:#5d6a8a}
.bub-memo{max-width:100%;width:100%}
.memo-top{font-weight:800;color:#263065;padding-bottom:.5rem;margin-bottom:.4rem;border-bottom:2px solid #8DA7C7}
.memo-top span{font-weight:600;color:#5d6a8a;font-size:.85rem}
.bub-a .prose-ar{font-size:.97rem}
.chip{display:inline-block;padding:.4rem .9rem;border-radius:999px;background:#EEF3FA;border:1px solid #C9D4EA;color:#263065;font-weight:700;font-size:.85rem;transition:.2s}
.chip:hover{background:#E3E9F5}
.chip-dark{padding:.4rem .9rem;border-radius:999px;border:1px solid rgba(255,255,255,.25);color:#fff;font-weight:700;font-size:.8rem}
.chip-dark:hover{background:rgba(255,255,255,.1)}
.seg{display:inline-flex;background:rgba(15,26,61,.4);border-radius:999px;padding:3px}
.seg button{background:transparent;padding:.35rem 1rem;border-radius:999px;font-weight:700;color:#cbd8ea;transition:.2s}
.seg button.on{background:#fff;color:#263065}
.composer{display:flex;align-items:flex-end;gap:.6rem;padding:.8rem;border-top:1px solid rgba(255,255,255,.12);background:rgba(15,26,61,.35)}
.composer textarea{flex:1;resize:none;max-height:160px;border-radius:20px;padding:.7rem 1rem}
.send-btn{width:46px;height:46px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;padding:0}
.send-btn span{display:inline-block;transform:scaleX(-1)}
.dots{display:inline-flex;gap:4px;margin-inline-end:.5rem;vertical-align:middle}
.dots span{width:7px;height:7px;border-radius:50%;background:#2f7a78;animation:pulse 1.2s ease-in-out infinite}
.dots span:nth-child(2){animation-delay:.2s}.dots span:nth-child(3){animation-delay:.4s}

/* ===== تظليل الثغرات داخل العقد ===== */
.contract-viewer{font-size:1.05rem;line-height:2.4;background:#fff;padding:16px;border-radius:12px;border:1px solid #E3E9F5;color:#1e293b;max-height:380px;overflow-y:auto;direction:rtl}
.highlight{padding:2px 6px;border-radius:6px;font-weight:700;cursor:pointer;transition:all .2s ease;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.highlight.active{outline:2px solid #263065;outline-offset:1px}
.highlight-high{background:#fee2e2;color:#991b1b;border-bottom:2px solid #ef4444}
.highlight-high:hover{background:#fecaca}
.highlight-medium{background:#fef3c7;color:#92400e;border-bottom:2px solid #f59e0b}
.highlight-medium:hover{background:#fde68a}
.highlight-term{background:#f3e8ff;color:#6b21a8;border-bottom:2px solid #a855f7}
.highlight-term:hover{background:#e9d5ff}
.hl-legend{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.8rem;font-weight:700;margin:.6rem 0}
.hl-legend span{padding:.15rem .6rem;border-radius:999px}
.flaw-card{margin-top:.8rem;padding:.9rem 1rem;border-radius:14px;border:1px solid #E3E9F5;border-right-width:5px;background:#fafbff;line-height:1.9;font-size:.95rem}
.flaw-card.sev-high{border-right-color:#ef4444}.flaw-card.sev-medium{border-right-color:#f59e0b}.flaw-card.sev-term{border-right-color:#a855f7}
.flaw-card h4{font-weight:800;margin-bottom:.3rem}
.flaw-card .lbl{font-weight:800;color:#2f7a78}
.flaw-card .alt{margin-top:.5rem;padding:.6rem .8rem;background:#ecfdf5;border-radius:10px;border:1px dashed #1f9d74}

/* ===================== مُحكم v2: طبقة التصميم الجديدة (الألوان الأصلية محفوظة) ===================== */
:root{--cream:#FAF9F6;--navy:#263065;--card:linear-gradient(160deg,#1F2D45 0%,#2B4468 55%,#3F5F8A 100%)}
body{font-family:'IBM Plex Sans Arabic','Thmanyah Sans','Tajawal',system-ui,sans-serif;background:var(--cream)!important;color:var(--navy);--muted:#5d6a8a}
.aurora{display:none}
.glass{background:var(--card)!important;border:1px solid rgba(38,48,101,.25);box-shadow:0 18px 40px -22px rgba(38,48,101,.55);color:#fff;--muted:#cbd8ea;--ink:#fff}
.grad-text{background-image:linear-gradient(100deg,#263065,#2f7a78 60%,#1f9d74)}
.glass .grad-text{background-image:linear-gradient(100deg,#fff,#8DA7C7)}
.sec-title::before,.sec-title::after{background:linear-gradient(90deg,transparent,rgba(38,48,101,.45))}
header.glass .grad-text{background-image:linear-gradient(100deg,#fff,#8DA7C7)}
.gov-bar{background:#17204a;color:#e8dcb8;font-size:.78rem;font-weight:600;text-align:center;padding:.4rem 1rem;line-height:1.7}
.gov-bar b{color:#BBBECC}
.tabs{display:flex;gap:.25rem;overflow-x:auto;max-width:100%;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{white-space:nowrap;padding:.5rem .8rem;border-radius:12px;color:#cbd8ea;font-weight:700;font-size:.85rem;transition:.2s}
.tab:hover{background:rgba(255,255,255,.1);color:#fff}
.tab.on{background:#fff;color:var(--navy)}
.nafath{background:linear-gradient(110deg,#3F5F8A,#8DA7C7,#BBBECC);color:#1F2D45;font-weight:800;border-radius:12px;padding:.5rem .9rem;font-size:.8rem;white-space:nowrap}
.card{background:var(--card);color:#fff;border-radius:20px;border:1px solid rgba(38,48,101,.25);box-shadow:0 18px 40px -22px rgba(38,48,101,.55)}
.stat{padding:1.3rem;text-align:right}
.stat .num{font-size:2.3rem;font-weight:800;line-height:1.2;background:linear-gradient(100deg,#fff,#8DA7C7);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat .lbl{font-weight:800;margin-top:.2rem}.stat .sub{font-size:.82rem;color:#cbd8ea;margin-top:.3rem;line-height:1.8}
.toolbar{display:flex;flex-wrap:wrap;gap:.5rem;padding:.7rem 1rem;border-bottom:1px solid rgba(255,255,255,.12);background:rgba(15,26,61,.25)}
.tbtn{padding:.4rem .85rem;border-radius:12px;font-weight:700;font-size:.82rem;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);color:#fff;transition:.2s}
.tbtn:hover{background:rgba(255,255,255,.2)}
.tbtn.gold{background:linear-gradient(110deg,#3F5F8A,#8DA7C7,#BBBECC);color:#1F2D45;border:0}
.panel{background:#fff;color:var(--navy);border-radius:16px;margin:.7rem 1rem;padding:1rem;border:1px solid #E3E9F5;--muted:#5d6a8a;--ink:#263065}
.bal-bar{display:flex;height:14px;border-radius:999px;overflow:hidden;background:#E3E9F5;margin:.5rem 0}
.bal-bar i{display:block;transition:width .8s}
.impr-res{white-space:pre-wrap;background:#ecfdf5;border:1px dashed #1f9d74;border-radius:12px;padding:.8rem;line-height:2}
.rk{padding:.15rem .7rem;border-radius:999px;font-weight:800;font-size:.78rem}
.rk-high{background:#fee2e2;color:#991b1b}.rk-medium{background:#fef3c7;color:#92400e}.rk-low{background:#dcfce7;color:#166534}
.doc-wrap{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:1rem;align-items:start}
@media(max-width:900px){.doc-wrap{grid-template-columns:1fr}}
.doc-bar{display:flex;flex-wrap:wrap;gap:.4rem;padding:.5rem;background:#EEF3FA;border:1px solid #DCE3F0;border-radius:12px 12px 0 0}
.doc-bar button{padding:.3rem .7rem;border-radius:8px;background:#fff;border:1px solid #C9D4EA;font-weight:700;font-size:.82rem;color:var(--navy)}
.doc-bar button:hover{background:#E3E9F5}
.doc-page{background:#fff;color:#1e293b;min-height:520px;padding:2.2rem 2rem;border:1px solid #DCE3F0;border-top:0;border-radius:0 0 12px 12px;box-shadow:0 20px 40px -28px rgba(38,48,101,.5);line-height:2.1;outline:none;font-size:1.02rem}
.doc-page:focus{box-shadow:0 0 0 3px rgba(47,122,120,.18)}
.side{position:sticky;top:76px;max-height:80vh;overflow-y:auto;padding:1rem}
.alert-i{background:#fff;color:var(--navy);border-radius:12px;padding:.7rem .8rem;margin-top:.6rem;border-right:5px solid #f59e0b;font-size:.86rem;line-height:1.8}
.alert-i.high{border-right-color:#ef4444}.alert-i.medium{border-right-color:#f59e0b}
.alert-i q{display:block;color:#5d6a8a;font-size:.8rem;margin:.2rem 0}
.tbl{width:100%;border-collapse:collapse;font-size:.92rem}
.tbl th{background:#EEF3FA;color:var(--navy);padding:.7rem;text-align:right}
.tbl td{padding:.7rem;border-top:1px solid #E3E9F5;text-align:right;vertical-align:middle}
.tgl{display:inline-flex;background:#EEF3FA;border-radius:999px;padding:3px;border:1px solid #C9D4EA}
.tgl button{padding:.35rem .9rem;border-radius:999px;font-weight:700;font-size:.82rem;color:#5d6a8a}
.tgl button.on{background:var(--navy);color:#fff}
.stp{display:flex;gap:.4rem;margin:.6rem 0}
.stp span{flex:1;text-align:center;padding:.35rem;border-radius:10px;font-size:.8rem;font-weight:700;background:#EEF3FA;color:#5d6a8a}
.stp span.on{background:#2f7a78;color:#fff}
.fld label{display:block;font-weight:700;font-size:.82rem;margin:.6rem 0 .2rem;color:#263065}
.fld input{width:100%;border:1.5px solid #DCE3F0;border-radius:10px;padding:.5rem .7rem;color:#263065;background:#fff}
.fld input:focus{outline:none;border-color:#2f7a78}
.hidden{display:none}

.doc-bar select{padding:.25rem .4rem;border-radius:8px;border:1px solid #C9D4EA;background:#fff;color:#263065;font-weight:700;font-size:.8rem}
.dlbl{display:inline-flex;align-items:center;gap:.3rem;font-size:.78rem;font-weight:700;color:#263065;background:#fff;border:1px solid #C9D4EA;border-radius:8px;padding:.15rem .5rem}
.dlbl input{width:26px;height:22px;border:0;padding:0;background:none;cursor:pointer}
#docPage{--ps:0px}#docPage div,#docPage p,#docPage li{margin-bottom:var(--ps)}
#docPage ul{list-style:disc;margin-right:1.6rem}#docPage ol{list-style:decimal;margin-right:1.6rem}
#docPage h2{font-size:1.4rem;font-weight:800;color:#263065}

.sec{max-width:72rem;margin:0 auto;padding:0 1.25rem 4rem;scroll-margin-top:90px}
.sec-sub{text-align:center;color:#5d6a8a;margin:-.2rem auto 2rem;max-width:40rem;line-height:2}
.fcard{padding:1.4rem;display:flex;flex-direction:column;gap:.5rem}
.fnum{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:800;color:#1F2D45;background:linear-gradient(135deg,#8DA7C7,#BBBECC)}
.fcard h3{font-weight:800;font-size:1.1rem}.fcard p{color:#cbd8ea;font-size:.9rem;line-height:1.9;flex:1}
.flink{align-self:flex-start;font-weight:700;font-size:.85rem;color:#8DA7C7;border-bottom:1px solid transparent}.flink:hover{border-color:#8DA7C7}
.gcard{background:#fff;border:1px solid #DCE3F0;border-right:5px solid #3F5F8A;border-radius:16px;padding:1.2rem 1.3rem;box-shadow:0 14px 30px -24px rgba(38,48,101,.5)}
.gcard h3{font-weight:800;color:#263065;margin-bottom:.3rem}.gcard p{color:#5d6a8a;font-size:.92rem;line-height:1.9}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;position:relative}
@media(max-width:860px){.steps{grid-template-columns:1fr 1fr}}@media(max-width:520px){.steps{grid-template-columns:1fr}}
.step{background:#fff;border:1px solid #DCE3F0;border-radius:18px;padding:1.3rem;text-align:center;position:relative}
.step b.n{display:inline-flex;width:44px;height:44px;border-radius:50%;align-items:center;justify-content:center;background:#263065;color:#fff;font-size:1.1rem;margin-bottom:.6rem}
.step h3{font-weight:800;color:#263065}.step p{color:#5d6a8a;font-size:.88rem;line-height:1.9;margin-top:.3rem}
.cov{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center}
.cov span{background:#fff;border:1px solid #C9D4EA;color:#263065;font-weight:700;font-size:.85rem;padding:.45rem .9rem;border-radius:999px}
.faq details{background:#fff;border:1px solid #DCE3F0;border-radius:14px;padding:.9rem 1.1rem;margin-bottom:.6rem;color:#263065}
.faq summary{font-weight:800;cursor:pointer}.faq details p{color:#5d6a8a;line-height:2;margin-top:.5rem;font-size:.92rem}
.gfoot{background:#17204a;color:#cbd8ea;margin-top:1rem}
.gfoot .in{max-width:72rem;margin:0 auto;padding:2.2rem 1.25rem;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:1.5rem;font-size:.88rem;line-height:2}
@media(max-width:760px){.gfoot .in{grid-template-columns:1fr}}
.gfoot h4{color:#BBBECC;font-weight:800;margin-bottom:.3rem}.gfoot button{display:block;color:#cbd8ea;text-align:right}.gfoot button:hover{color:#fff}
.gfoot .legal{border-top:1px solid rgba(255,255,255,.12);text-align:center;padding:.8rem 1rem;font-size:.78rem;color:#9fb0cc}

header.glass{position:sticky}
.menu-btn{width:46px;height:46px;border-radius:14px;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;transition:.2s;flex:none}
.menu-btn:hover{background:rgba(255,255,255,.18)}
.menu-btn span{display:block;width:22px;height:2.5px;border-radius:2px;background:#fff;transition:.25s}
.menu-btn[aria-expanded="true"] span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.menu-btn[aria-expanded="true"] span:nth-child(2){opacity:0}
.menu-btn[aria-expanded="true"] span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}
#tabs{display:none;position:absolute;top:calc(100% + 8px);left:1rem;width:min(290px,calc(100vw - 2rem));flex-direction:column;gap:.2rem;padding:.6rem;border-radius:18px;background:linear-gradient(160deg,#263065,#2B4468 55%,#3F5F8A);border:1px solid rgba(255,255,255,.18);box-shadow:0 24px 50px -16px rgba(15,26,61,.7);overflow:visible;z-index:50}
#tabs.open{display:flex;animation:mdrop .22s ease-out}
@keyframes mdrop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
#tabs .tab{display:block;width:100%;text-align:right;padding:.65rem .9rem;font-size:.92rem}
.login-btn{margin-top:.5rem;display:flex;align-items:center;justify-content:space-between;width:100%;padding:.75rem 1rem;border-radius:14px;font-weight:800;color:#1F2D45;background:linear-gradient(110deg,#3F5F8A,#8DA7C7,#BBBECC);box-shadow:0 0 0 0 rgba(242,213,139,.6);animation:lglow 2s infinite}
.login-btn .arr{animation:larr 1.2s ease-in-out infinite;filter:drop-shadow(0 0 4px rgba(255,255,255,.9))}
.login-btn:hover{filter:brightness(1.07)}
@keyframes larr{0%,100%{transform:translateX(0)}50%{transform:translateX(-7px)}}
@keyframes lglow{0%{box-shadow:0 0 0 0 rgba(242,213,139,.55)}70%{box-shadow:0 0 0 12px rgba(242,213,139,0)}100%{box-shadow:0 0 0 0 rgba(242,213,139,0)}}
.send-btn.rec{background:#dc2626!important;color:#fff;animation:pulse 1s infinite}
.chip.spk{background:#E9F5F0}

/* مشغل القراءة الصوتية */
.tts-player{width:100%;direction:rtl}
.tts-player .chip{background:#fff;border-color:#C9D4EA;color:#263065}
.tts-player select{min-width:76px;cursor:pointer}

/* ===== v3: الواجهة الرئيسية ===== */
.pill{display:inline-block;padding:.35rem 1rem;border-radius:999px;background:#fff;border:1px solid #C9D4EA;color:#3F5F8A;font-weight:800;font-size:.85rem}
.cd{background:#fff;border:1px solid #DCE3F0;border-radius:22px;padding:1.4rem;box-shadow:0 30px 60px -30px rgba(38,48,101,.5);line-height:2.3;font-size:.95rem;color:#1e293b;transform:rotate(-1.2deg)}
.cd mark{opacity:0;animation:mk .7s forwards}.cd mark:nth-of-type(1){animation-delay:.8s}.cd mark:nth-of-type(2){animation-delay:1.7s}.cd mark:nth-of-type(3){animation-delay:2.6s}.cd mark:nth-of-type(4){animation-delay:3.5s}
@keyframes mk{to{opacity:1}}
.rv{opacity:0;transform:translateY(24px);transition:.7s}.rv.in{opacity:1;transform:none}.cd.rv.in{transform:rotate(-1.2deg)}
.jr{display:flex;flex-direction:column;gap:.6rem}
.jp{background:var(--card);color:#fff;border-radius:20px;padding:1rem 1.2rem;cursor:pointer;overflow:hidden;position:relative;transition:flex .6s}
.jp .hd{display:flex;align-items:center;gap:.8rem;font-weight:800}
.jp .nm{width:38px;height:38px;flex:none;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#8DA7C7,#BBBECC);color:#1F2D45}
.jp .bd{max-height:0;opacity:0;transition:.5s;color:#cbd8ea;line-height:2;font-size:.92rem}
.jp.on .bd{max-height:240px;opacity:1;margin-top:.7rem}
.jp .pg{position:absolute;bottom:0;right:0;height:3px;width:0;background:#8DA7C7}.jp.on .pg{animation:pgr 5s linear forwards}
@keyframes pgr{to{width:100%}}
@media(min-width:820px){.jr{flex-direction:row;height:340px}.jp{flex:1}.jp.on{flex:5}.jp:not(.on) .hd{flex-direction:column}.jp:not(.on) .tt{writing-mode:vertical-rl}}
.svw{display:grid;grid-template-columns:320px 1fr;gap:1rem}@media(max-width:860px){.svw{grid-template-columns:1fr}}
.svb{display:block;width:100%;text-align:right;padding:1rem;border-radius:16px;border:1px solid #DCE3F0;background:#fff;color:#263065;font-weight:800;margin-bottom:.6rem;transition:.2s}
.svb.on{background:var(--card);color:#fff}.svb small{display:block;font-weight:600;opacity:.8}
.svp{padding:1.4rem}.svp ul{list-style:disc;margin:.6rem 1.2rem .8rem 0;line-height:2;color:#cbd8ea}.svp .pvx{background:#fff;border-radius:14px;padding:.4rem .8rem .8rem;margin-top:.8rem}
.tag{padding:.1rem .6rem;border-radius:999px;font-size:.75rem;font-weight:800;margin-inline-start:.4rem}.tag.ok{background:#dcfce7;color:#166534}.tag.soon{background:#fef3c7;color:#92400e}
.two{display:grid;grid-template-columns:1fr 1fr;gap:1rem}@media(max-width:760px){.two{grid-template-columns:1fr}}.two .card{padding:1.4rem}.two li{list-style:disc;margin-right:1.2rem;line-height:2;color:#cbd8ea}
.pipe{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center}.pn{background:var(--card);color:#fff;border-radius:16px;padding:.8rem 1rem;min-width:150px;text-align:center}.pn b{display:block}.pn span{font-size:.78rem;color:#cbd8ea}.pa{align-self:center;color:#3F5F8A;font-weight:800}
.tl{position:relative;padding-right:2rem}.tl::before{content:"";position:absolute;right:11px;top:0;bottom:0;width:2px;background:linear-gradient(#263065,#8DA7C7)}
.ti{position:relative;margin-bottom:1rem;background:#fff;border:1px solid #DCE3F0;border-radius:16px;padding:1rem;color:#263065}.ti p{color:#5d6a8a;font-size:.9rem;line-height:1.9;margin-top:.2rem}
.ti::before{content:"";position:absolute;right:-29px;top:1.2rem;width:14px;height:14px;border-radius:50%;background:#8DA7C7;border:3px solid #FAF9F6}.ti.cur::before{background:#8DA7C7;box-shadow:0 0 0 6px rgba(141,167,199,.3)}

.opt{padding:.5rem .9rem;border-radius:12px;border:1px solid rgba(255,255,255,.3);color:#fff;font-weight:700;font-size:.85rem;transition:.2s}.opt.on{background:#fff;color:#263065}.opt:disabled{opacity:.3;cursor:not-allowed}
#bk .fld label{color:#fff}#bk h4{font-weight:800;margin:1rem 0 .5rem}#bk textarea{width:100%;border-radius:10px;padding:.5rem .7rem;color:#263065;background:#fff}
.bki{background:#fff;border:1px solid #DCE3F0;border-radius:16px;padding:1rem;margin-bottom:.6rem;color:#263065;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;line-height:1.9}
</style>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== تعديلات مُحكم: هوية اللوقو ===== */
:root{--lg-ink:#1F2D45;--lg-steel:#3F5F8A;--lg-sky:#8DA7C7;--lg-lav:#BBBECC;--lg-rose:#E2D4D0}
html,body{background:#FAF9F6!important}
.toolbar,#privNote{display:none!important}
.avatar{overflow:hidden;padding:0;background:linear-gradient(135deg,var(--lg-ink),var(--lg-steel))}
.avatar img{width:100%;height:100%;object-fit:cover;display:block}
.chip-key{background:linear-gradient(110deg,var(--lg-ink),var(--lg-steel));border-color:transparent;color:#fff}
.chip-key:hover{filter:brightness(1.12)}
.imp-g{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.imp{background:#fff;border:1px solid #E3E9F5;border-radius:22px;padding:1.3rem 1.2rem 1.2rem;position:relative;overflow:hidden;box-shadow:0 18px 40px -26px rgba(31,45,69,.4)}
.imp::before{content:"";position:absolute;inset:0 0 auto 0;height:5px;background:linear-gradient(90deg,var(--lg-ink),var(--lg-steel),var(--lg-sky))}
.imp-ic{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--lg-ink),var(--lg-steel));margin-bottom:.8rem}
.imp h3{font-weight:800;font-size:1.1rem;color:var(--lg-ink);margin-bottom:.5rem}
.imp li{color:#4a5876;line-height:1.9;padding-right:1rem;position:relative;font-size:.93rem}
.imp li::before{content:"";position:absolute;right:0;top:.8em;width:6px;height:6px;border-radius:50%;background:var(--lg-sky)}
.fut-g{display:grid;gap:.9rem;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.fut{display:flex;gap:1rem;align-items:flex-start;background:linear-gradient(160deg,#fff,#F3F5F9);border:1px solid #E3E9F5;border-right:4px solid var(--lg-steel);border-radius:18px;padding:1.1rem 1.2rem}
.fut-ic{flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:var(--lg-steel);background:#E8EDF5}
.fut h3{font-weight:800;color:var(--lg-ink);margin-bottom:.25rem}
.fut p{color:#5d6a8a;font-size:.92rem;line-height:1.9}
.cd{position:relative;overflow:hidden}
.cd::after{content:"";position:absolute;inset-inline:0;top:-90px;height:90px;background:linear-gradient(180deg,transparent,rgba(141,167,199,.38),transparent);pointer-events:none;animation:scan 5.5s ease-in-out infinite}
@keyframes scan{0%{top:-90px}70%,100%{top:105%}}
#toTop{position:fixed;left:18px;bottom:22px;width:56px;height:56px;border-radius:50%;border:0;padding:0;cursor:pointer;z-index:45;display:grid;place-items:center;color:#fff;background:linear-gradient(145deg,var(--lg-ink),var(--lg-steel));box-shadow:0 14px 30px -10px rgba(31,45,69,.7);opacity:0;transform:translateY(14px);pointer-events:none;transition:opacity .25s,transform .25s}
#toTop.show{opacity:1;transform:none;pointer-events:auto}
#toTop:hover{filter:brightness(1.12)}
#toTop:focus-visible{outline:3px solid var(--lg-sky);outline-offset:3px}
#toTop svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
#toTop circle{fill:none;stroke-width:3}
#toTop .tr{stroke:rgba(255,255,255,.18)}
#toTop .pg{stroke:var(--lg-sky);stroke-linecap:round;stroke-dasharray:151;stroke-dashoffset:151}
#toTop .ar{position:relative;width:22px;height:22px}

.hero-v{position:relative}
.hero-img{display:block;width:74%;margin:0 auto -2.4rem;mix-blend-mode:multiply;-webkit-mask-image:radial-gradient(ellipse 62% 62% at 50% 50%,#000 62%,transparent 100%);mask-image:radial-gradient(ellipse 62% 62% at 50% 50%,#000 62%,transparent 100%)}
.hero-v .cd{position:relative;z-index:1}
.bn{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
@media(min-width:900px){.bn{grid-template-columns:repeat(3,1fr)}.bn-i.w{grid-column:span 2}.bn-i.w img{aspect-ratio:16/8}}
.bn-i{background:#fff;border:1px solid #E3E9F5;border-radius:24px;overflow:hidden;box-shadow:0 22px 44px -28px rgba(31,45,69,.45)}
.bn-i img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}
.bn-i div{padding:.95rem 1.2rem 1.2rem}
.bn-i h3{font-weight:800;font-size:1.08rem;color:var(--lg-ink);margin-bottom:.3rem}
.bn-i p{color:#5d6a8a;font-size:.92rem;line-height:1.9}
.banner{display:block;width:min(100%,560px);height:190px;object-fit:cover;margin:0 auto 1.5rem;border-radius:26px;box-shadow:0 24px 48px -28px rgba(31,45,69,.55)}
.imp-ic,.fut-ic{padding:0;background:none!important;overflow:hidden}
.imp-ic{width:64px;height:64px;border-radius:50%}
.fut-ic{width:60px;height:60px}
.imp-ic img,.fut-ic img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}

.jp .nm,.fnum{background:none!important;padding:0;overflow:hidden;color:transparent}
.jp .nm{width:46px;height:46px;border-radius:14px;box-shadow:0 0 0 2px rgba(141,167,199,.45)}
.fnum{width:58px;height:58px;border-radius:16px}
.jp .nm img,.fnum img{width:100%;height:100%;object-fit:cover;display:block}
.btn-gold,.tbtn.gold{background:linear-gradient(110deg,#1F2D45,#3F5F8A)!important;color:#fff!important}
.jp:not(.on) .nm{width:42px;height:42px}
</style>
</head>

<body>
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>

<!-- الترويسة -->
<header class="no-print sticky top-0 z-30 glass" style="border-width:0 0 1px 0">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-3">
      <img src="logo.jpg" alt="مُحكم" class="w-11 h-11 rounded-2xl object-cover">
      <div class="leading-tight">
        <div class="text-xl font-extrabold grad-text">مُحكم</div>
        <div class="text-xs text-[var(--muted)] font-bold tracking-wide">Muhkam</div>
      </div>
    </div>
    <button type="button" id="menuBtn" class="menu-btn" aria-label="القائمة" aria-expanded="false" aria-controls="tabs"><span></span><span></span><span></span></button>
    <nav class="tabs" id="tabs" aria-label="القائمة الرئيسية">
      <button class="tab on" data-view="home">الرئيسية</button>
      <button class="tab" data-view="library">مكتبة مُحكَم</button>
      <button class="tab" data-view="assistant">مُساعد مُحكَم الذكي</button>
      <button class="tab" data-view="advisors">مستشارو مُحكم</button>
      <button type="button" class="login-btn" id="loginBtn">تسجيل الدخول <svg class="arr" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H5"/><path d="M11 6l-6 6 6 6"/></svg></button>
    </nav>
  </div>
</header>

<div id="view-home">
<section class="max-w-6xl mx-auto px-5 pt-12 pb-10 grid lg:grid-cols-2 gap-10 items-center">
 <div class="text-right">
  <span class="pill">منظومة التدقيق الاستباقي للعقود التجارية</span>
  <h1 class="text-4xl sm:text-6xl font-extrabold leading-[1.35] mt-5">اعرف <span class="blk">مخاطر</span> عقدك،<br>قبل أن توقّعه</h1>
  <p class="mt-5 text-lg text-[var(--muted)] leading-9">مُحكم يحلّل عقدك التجاري ويكشف الثغرات، ويختبر صموده أمام سيناريوهات الإخلال، ثم يتحقق من فعالية كل تعديل مقترح قبل التوقيع.</p>
  <div class="mt-8 flex flex-wrap gap-3"><button data-go="assistant" class="btn-main px-6 py-3.5">ابدأ التدقيق</button><button data-go="library" class="btn-ghost px-6 py-3.5">تصفّح مكتبة العقود</button></div>
 </div>
 <div class="hero-v"><img class="hero-img" src="data:image/webp;base64," alt="" aria-hidden="true"><div class="cd rv">
  <div class="flex justify-between items-center mb-2"><b>عقد توريد · مثال توضيحي</b><span class="rk rk-high">خطر عالٍ</span></div>
  المادة (3): يحق للطرف الأول <mark class="highlight highlight-high">إنهاء العقد في أي وقت دون إبداء الأسباب</mark>، ويسدد الطرف الثاني <mark class="highlight highlight-medium">خلال مدة مناسبة</mark> من الاستلام.<br>المادة (5): عند التأخر يُلزم بغرامة <mark class="highlight highlight-high">50% من قيمة العقد</mark>، ويتجدد العقد <mark class="highlight highlight-term">سنة تلقائياً</mark>.
  <div class="hl-legend"><span class="highlight-high">باطل أو خطير</span><span class="highlight-medium">غامض</span><span class="highlight-term">التزام جوهري</span></div>
  <div class="bal-bar"><i style="width:60%;background:#ef4444"></i><i style="width:25%;background:#f59e0b"></i><i style="width:15%;background:#a855f7"></i></div>
 </div></div>
</section>

<section id="journey" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">رحلة عقدك مع <span class="grad-text">مُحكم</span></h2></div><p class="sec-sub">خمس محطات من العقد الخام إلى عقد جاهز للتوقيع.</p>
<div class="jr" id="jr">
<div class="jp"><div class="hd"><span class="nm"><img src="data:image/webp;base64," alt="" aria-hidden="true"></span><span class="tt">إدخال العقد</span></div><div class="bd">اختر نموذجاً من المكتبة وعبّئ بياناته بالخطوات، أو الصق نص عقدك، أو أرفق ملف Word.</div><i class="pg"></i></div>
<div class="jp"><div class="hd"><span class="nm"><img src="data:image/webp;base64," alt="" aria-hidden="true"></span><span class="tt">حماية البيانات</span></div><div class="bd">تُحجب الأسماء والهويات والسجلات والجوالات والآيبان والبريد تلقائياً داخل متصفحك قبل أي معالجة.</div><i class="pg"></i></div>
<div class="jp"><div class="hd"><span class="nm"><img src="data:image/webp;base64," alt="" aria-hidden="true"></span><span class="tt">التدقيق الاستباقي</span></div><div class="bd">تحليل البنود واكتشاف التعارضات والبنود الناقصة، وملخص بالحقوق والالتزامات والدفعات والمواعيد، مع تظليل مواضع المرئية في نص العقد.</div><i class="pg"></i></div>
<div class="jp"><div class="hd"><span class="nm"><img src="data:image/webp;base64," alt="" aria-hidden="true"></span><span class="tt">اختبار التحمّل</span></div><div class="bd">اختبار العقد أمام سيناريوهات الإخلال (تأخر، تخلف عن السداد، إنهاء منفرد، قوة قاهرة) وتقدير الأثر المالي عند توفر المعطيات.</div><i class="pg"></i></div>
<div class="jp"><div class="hd"><span class="nm"><img src="data:image/webp;base64," alt="" aria-hidden="true"></span><span class="tt">التعديل وإعادة الاختبار</span></div><div class="bd">صياغات بديلة مسندة إلى الأنظمة السعودية، ثم إعادة اختبار للتحقق من معالجة الثغرة، وتقرير شامل بالنتائج.</div><i class="pg"></i></div>
</div></section>

<section id="services" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">خدمات <span class="grad-text">مُحكم</span></h2></div><p class="sec-sub">ثلاث خدمات مستقلة في الاستخدام، متكاملة عند الحاجة.</p>
<div class="svw"><div id="svl"></div><div id="svp" class="card svp"></div></div></section>

<section id="why" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">الفجوة التي <span class="grad-text">نسدّها</span></h2></div><p class="sec-sub">لا يكفي أن نعرف أين تكمن المشكلة في العقد، بل نحتاج إلى فهم ما قد يحدث بسببها وكيف نتفاداها قبل وقوعها.</p>
<div class="two">
<div class="card rv"><h3 class="font-extrabold text-xl mb-2">التحديات اليوم</h3><ul><li>غموض الصياغات وصعوبة فهم الحقوق والالتزامات</li><li>بنود ناقصة أو متعارضة أو غير متوازنة</li><li>صعوبة استباق المخاطر وآثار الإخلال</li><li>ارتفاع تكلفة المراجعة القانونية التقليدية ووقتها</li><li>ضعف الوعي بالتبعات القانونية والمالية للبنود</li><li>حساسية البيانات التعاقدية ومخاوف مشاركتها</li></ul></div>
<div class="card rv"><h3 class="font-extrabold text-xl mb-2">ما يضيفه مُحكم</h3><ul><li>اختبار آثار المخاطر المحتملة عند التنفيذ، لا اكتشافها فقط</li><li>ربط المخاطر القانونية بآثارها المالية المحتملة</li><li>التحقق من فعالية التعديلات المقترحة بإعادة الاختبار</li><li>جمع التدقيق والقوالب والمحامين في منظومة واحدة</li><li>حلول مرنة تناسب إمكانات المنشآت ومستوى ثقتها بالذكاء الاصطناعي</li></ul></div>
</div></section>

<section id="showcase" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">ماذا يفعل مُحكم <span class="grad-text">بعقدك</span></h2></div><p class="sec-sub">من القراءة الأولى إلى الصياغة البديلة، خمس خطوات تسبق توقيعك.</p><div class="bn"><div class="bn-i rv w"><img src="data:image/webp;base64," alt="" loading="lazy"><div><h3>يفهم عقدك ويحلّله</h3><p>يستخرج الأطراف والمبالغ والمواعيد، ويربط كل بند بمعناه وسياقه، ويلخّص الحقوق والالتزامات في صفحة واحدة.</p></div></div><div class="bn-i rv"><img src="data:image/webp;base64," alt="" loading="lazy"><div><h3>يكشف المخاطر وآثارها</h3><p>ثغرات وبنود متعارضة أو ناقصة، مع تقدير الأثر المالي عند توفر المعطيات.</p></div></div><div class="bn-i rv"><img src="data:image/webp;base64," alt="" loading="lazy"><div><h3>يختبر ثم يعيد الاختبار</h3><p>يتحقق من أن كل تعديل مقترح عالج الثغرة فعلاً قبل أن تعتمده.</p></div></div><div class="bn-i rv"><img src="data:image/webp;base64," alt="" loading="lazy"><div><h3>يسنده إلى الأنظمة السعودية</h3><p>اقتراحات مدعومة بالمراجع النظامية ذات الصلة، لا اجتهاداً عاماً.</p></div></div><div class="bn-i rv"><img src="data:image/webp;base64," alt="" loading="lazy"><div><h3>يقترح صياغة بديلة</h3><p>تعديلات على البنود جاهزة للمراجعة والاعتماد داخل العقد.</p></div></div></div></section>

<section id="audience" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">لمن <span class="grad-text">مُحكم</span></h2></div><p class="sec-sub">للأفراد والمنشآت التي تتعامل مع العقود التجارية وتسعى إلى توقيع أكثر وعياً.</p>
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div class="gcard rv"><h3>رواد الأعمال والمشاريع الناشئة</h3><p>فهم العقود واتخاذ قرارات واعية دون خبرة قانونية متخصصة.</p></div>
<div class="gcard rv"><h3>المنشآت الصغيرة والمتوسطة</h3><p>تدقيق مرن يناسب الإمكانات المالية ويقي من المخاطر والنزاعات.</p></div>
<div class="gcard rv"><h3>الشركات والإدارات القانونية</h3><p>رفع كفاءة المراجعة وتوحيد القوالب وتقليل المراجعات المتكررة.</p></div>
<div class="gcard rv"><h3>المحامون والمستشارون</h3><p>أدوات تحليل وتدقيق تدعم أعمالهم وتسهّل وصول العملاء إليهم.</p></div></div></section>

<section id="tech" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">كيف يفكّر <span class="grad-text">مُحكم</span></h2></div><p class="sec-sub">بنية متعددة الطبقات، لا نموذجاً عاماً وحده: فهم، ثم تحليل، ثم اختبار، ثم تحقق.</p>
<div class="pipe" id="pipe"></div></section>

<section id="impact" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">لماذا <span class="grad-text">مُحكم</span></h2></div><p class="sec-sub">&nbsp;</p>
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div class="card fcard rv"><div class="fnum"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>التأثير</h3><p>الحد من النزاعات والخسائر المحتملة باستباق المخاطر قبل التوقيع، وتقليل وقت المراجعة وتكلفتها.</p></div>
<div class="card fcard rv"><div class="fnum"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الجدوى</h3><p>تقنيات متاحة ونموذج أولي دون تدريب نموذج من الصفر، وقاعدة معرفية من المصادر النظامية الرسمية.</p></div>
<div class="card fcard rv"><div class="fnum"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الابتكار</h3><p>تدقيق استباقي يجمع التحليل القانوني والمالي مع اختبار السيناريوهات والتحقق من التعديلات.</p></div>
<div class="card fcard rv"><div class="fnum"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الاستدامة</h3><p>قابلية التوسع لأنواع العقود والقطاعات، وتحديث القواعد النظامية، ونموذج إيرادات من الاشتراكات والخدمات المهنية.</p></div></div></section>

<section id="roadmap" class="sec" style="max-width:48rem"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">خارطة <span class="grad-text">الطريق</span></h2></div><p class="sec-sub">تطوير تدريجي يبدأ بإثبات الجدوى وينتهي بمنظومة متكاملة قابلة للتوسع.</p>
<div class="tl">
<div class="ti rv"><b>01 · بناء المعرفة النظامية</b><p>جمع المصادر النظامية الرسمية وإعداد معايير التدقيق والقواعد والسيناريوهات مع المختصين القانونيين.</p></div>
<div class="ti rv"><b>02 · النموذج الأولي (MVP)</b><p>محرك التدقيق الاستباقي والملخص الذكي وتحليل المخاطر واختبار السيناريوهات والتحقق من التعديلات.</p></div>
<div class="ti rv"><b>03 · الاختبار والتحقق</b><p>اختبار المنظومة بعقود افتراضية ومقارنة نتائجها بتقييمات المختصين.</p></div>
<div class="ti rv"><b>04 · استكمال الخدمات والتكامل</b><p>المكتبة التعاقدية الذكية وخدمة الربط بالمحامين ومساحة العمل المهنية.</p></div>
<div class="ti cur rv"><b>05 · الإطلاق التجريبي والتحسين <span class="rk rk-low">نحن هنا</span></b><p>تجربة المنظومة مع المنشآت والمحامين وتحسين الأداء بناءً على الملاحظات.</p></div></div></section>

<section id="effect" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">الأثر <span class="grad-text">المتوقع</span></h2></div><p class="sec-sub">تحوّل في تجربة التعامل مع العقود التجارية، من الفهم والتحليل والاستباق إلى استقرار بيئة الأعمال.</p><div class="imp-g"><div class="imp rv" style="--i:0"><div class="imp-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الأثر القانوني</h3><ul><li>تحسين جودة العقود التجارية</li><li>الحد من الثغرات التعاقدية</li><li>الوقاية من النزاعات المحتملة</li><li>تعزيز الوعي بالحقوق والالتزامات</li></ul></div><div class="imp rv" style="--i:1"><div class="imp-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الأثر الاقتصادي</h3><ul><li>الحد من الخسائر المالية المحتملة</li><li>خفض تكاليف المراجعة التعاقدية</li><li>دعم استقرار المنشآت واستمراريتها</li><li>تعزيز الثقة في بيئة الأعمال</li></ul></div><div class="imp rv" style="--i:2"><div class="imp-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الأثر المؤسسي</h3><ul><li>رفع الكفاءة التشغيلية</li><li>تقليل الوقت والجهد</li><li>توحيد الممارسات التعاقدية</li><li>تحسين إدارة المعرفة القانونية</li></ul></div><div class="imp rv" style="--i:3"><div class="imp-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><h3>الأثر التقني والمعرفي</h3><ul><li>دعم التحول الرقمي القانوني</li><li>تعزيز الاستخدام المسؤول للذكاء الاصطناعي</li><li>تسهيل الوصول إلى المعرفة القانونية</li><li>تطوير أدوات تدعم الخبرة البشرية</li></ul></div></div></section>
<section id="future" class="sec"><div class="text-center mb-2"><h2 class="sec-title text-3xl font-extrabold">التطويرات <span class="grad-text">المستقبلية</span></h2></div><p class="sec-sub">ما نبنيه بعد الإطلاق التجريبي لتصبح مُحكم جزءاً من دورة العقد كاملة.</p><div class="fut-g"><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>إدارة الالتزامات التعاقدية</h3><p>متابعة تنفيذ العقود بعد التوقيع، والتنبيه بالمواعيد والدفعات والتجديد والالتزامات المستحقة.</p></div></div><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>التكامل مع Microsoft Word</h3><p>إتاحة التدقيق الذكي وتعديل البنود مباشرة داخل بيئة تحرير العقود.</p></div></div><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>التكامل مع الأنظمة المؤسسية</h3><p>ربط مُحكم بأنظمة إدارة الأعمال والعقود والمشتريات من خلال واجهات API.</p></div></div><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>التخصيص المؤسسي</h3><p>تطوير معايير تدقيق خاصة بكل منشأة وفق سياساتها الداخلية وطبيعة أعمالها.</p></div></div><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>التحليلات التعاقدية المتقدمة</h3><p>لوحات تحليلية لرصد المخاطر والثغرات المتكررة ودعم القرارات المؤسسية.</p></div></div><div class="fut rv"><div class="fut-ic"><img src="data:image/webp;base64," alt="" aria-hidden="true"></div><div><h3>التوسع القطاعي واللغوي</h3><p>دعم المزيد من أنواع العقود التجارية والقطاعات الاقتصادية والعقود ثنائية اللغة.</p></div></div></div></section>
</div><!-- /view-home -->

<div id="view-library" class="hidden"><section id="templates" class="max-w-6xl mx-auto px-5 pt-10 pb-16 scroll-mt-20"><img class="banner" src="data:image/webp;base64," alt="" aria-hidden="true">
  <div class="text-center mb-8">
    <h2 class="sec-title text-3xl font-extrabold">مكتبة <span class="gold-text">مُحكَم</span></h2>
    <p class="text-[var(--muted)] mt-2">اختر نموذجاً، عدّل الحقول بين الأقواس [ ]، ثم دقّقه بالمساعد.</p>
  </div>
  <div id="chips" class="flex flex-wrap justify-center gap-2 mb-8"></div>
  <div id="tplGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
</section></div>
<div id="view-assistant" class="hidden"><main id="assistant" class="max-w-4xl mx-auto px-3 sm:px-5 pt-10 pb-20 scroll-mt-20">
  <div class="text-center mb-8 no-print"><div class="mb-3"><button type="button" class="btn-ghost px-4 py-1.5 text-sm" data-go="dash">عقودي السابقة</button></div>
    <h2 class="sec-title text-3xl font-extrabold">مُساعد <span class="grad-text">مُحكَم</span> الذكي</h2>
    <p class="text-[var(--muted)] mt-2">اكتب أو الصق عقدك في المحادثة، واحصل على مذكرة تدقيق قانوني.</p>
  </div>

  <div class="glass ring-grad rounded-3xl overflow-hidden flex flex-col no-print">
    <!-- رأس المحادثة -->
    <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-white/10 bg-[#0f1a3d]/30">
      <div class="flex items-center gap-3">
        <div class="avatar avatar-lg"><img src="logo.jpg" alt="مُحكم"></div>
        <div class="leading-tight">
          <div class="font-extrabold">مساعد مُحكَم</div>
          <div class="text-xs text-[var(--muted)] flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[var(--mint)] pulse-dot"></span>متصل · جاهز للتدقيق</div>
        </div>
      </div>
      <button id="newChat" type="button" class="chip-dark" title="محادثة جديدة">↻ جديدة</button>
    </div>
    <!-- الصفة -->
    <div class="flex items-center gap-3 px-4 py-2.5 border-b border-white/10 text-sm">
      <span class="font-bold text-[var(--muted)]">صفتك في العقد:</span>
      <input type="hidden" id="role" value="الطرف الأول">
      <div class="seg" id="seg">
        <button type="button" class="on" data-role="الطرف الأول">الطرف الأول</button>
        <button type="button" data-role="الطرف الثاني">الطرف الثاني</button>
      </div>
    </div>
    <div class="flex items-center gap-3 px-4 py-2.5 border-b border-white/10 text-sm">
      <label for="tplSel" class="font-bold text-[var(--muted)] whitespace-nowrap">نماذج العقود:</label>
      <select id="tplSel" class="field" style="padding:.45rem .8rem;color:#1F2D45;min-width:0;flex:1"><option value="">اختر نموذجاً لمعاينته وتعبئته…</option></select>
    </div>
    <!-- الأدوات المساندة -->
    <div class="toolbar no-print">
      <button type="button" class="tbtn" id="btnHighlight">تظليل العقد</button>
      <button type="button" class="tbtn" id="btnEdit">تحرير العقد</button>
      <button type="button" class="tbtn" id="btnBalance"> قياس توازن العقد</button>
      <button type="button" class="tbtn gold" id="btnImprove">مُحسِّن الصياغة </button>
    </div>
    <div id="privNote" class="panel hidden" style="color:#166534;background:#f0fdf4;border-color:#bbf7d0"></div>
    <div id="balPanel" class="panel hidden"></div>
    <div id="imprPanel" class="panel hidden"></div>
    <!-- الرسائل -->
    <div id="msgs" class="chat-body" aria-live="polite"></div>
    <!-- اقتراحات سريعة (تظهر بعد المذكرة الأولى) -->
    <div id="suggest" class="flex-wrap gap-2 px-4 pt-3 no-print" style="display:none"></div>
    <!-- صندوق الكتابة -->
    <div class="composer">
      <textarea id="contract" rows="1" class="field leading-7" placeholder="الصق نص العقد هنا…"></textarea>
      <input type="file" id="fileIn" accept=".docx,.txt,.md,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="hidden">
      <button id="attachBtn" type="button" class="btn-ghost send-btn" aria-label="إرفاق ملف" title="إرفاق عقد (Word أو نص)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11l-8.6 8.6a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.6 8.6a2 2 0 0 1-3-3L15 7"/></svg></button>
      <button id="readContractBtn" type="button" class="btn-ghost send-btn" aria-label="قراءة نص العقد" title="استمع إلى نص العقد"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/></svg></button>
      <button id="micBtn" type="button" class="btn-ghost send-btn" aria-label="إملاء صوتي" title="إملاء صوتي"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
      <button id="sendBtn" type="button" class="btn-main send-btn" aria-label="إرسال"><span id="sendIcon">➤</span></button>
    </div>
    <div class="px-4 pb-3 pt-0 text-[11px] text-[var(--muted)] flex justify-between gap-3">
      <span>هذه المرئيات لا تُغني عن المحامي ولا تُعد استشارة قانونيَّة.</span><span id="count">0 حرف</span>
    </div>
  </div>
</main></div>

<div id="view-advisors" class="hidden max-w-5xl mx-auto px-4 py-10"><img class="banner" src="data:image/webp;base64," alt="" aria-hidden="true">
  <div class="text-center mb-6"><h2 class="sec-title text-3xl font-extrabold">مستشارو <span class="grad-text">مُحكم</span></h2>
  <p class="sec-sub">احجز موعداً مع مختص في تدقيق العقود أو في الاستشارات القانونية. المرحلة التجريبية: يؤكد فريق مُحكم موعدك عبر الجوال أو البريد.</p></div>
  <div class="card" style="padding:1.4rem"><div id="bk"></div></div>
  <h3 class="font-extrabold text-xl mt-8 mb-2">حجوزاتي</h3><div id="bkList"></div>
</div>
<div id="editModal" class="hidden fixed inset-0 z-40 flex items-center justify-center p-4 bg-[#0f1a3d]/60 backdrop-blur-sm no-print">
 <div class="bg-white rounded-3xl w-full max-w-3xl max-h-[90vh] flex flex-col shadow-2xl overflow-y-auto" style="color:#263065">
  <div class="p-4 border-b border-[#E3E9F5] flex items-center justify-between"><h3 class="font-extrabold text-lg">تحرير العقد</h3><button id="edClose" class="w-9 h-9 rounded-full hover:bg-[#EEF3FA] text-xl" aria-label="إغلاق">✕</button></div>
  <p class="px-4 pt-3 text-sm" style="color:#5d6a8a">عدّل النص مباشرة، أو حدّد بنداً واضغط «تحسين صياغة المحدد»، ثم أعد التدقيق.</p>
  <textarea id="edText" class="field leading-8" style="min-height:40vh;margin:1rem;width:calc(100% - 2rem)"></textarea>
  <div id="edImpr" class="panel hidden"></div>
  <div class="p-4 border-t border-[#E3E9F5] flex flex-wrap gap-2 items-center">
   <button id="edImprove" type="button" class="btn-gold px-4 py-2.5 text-sm">تحسين صياغة المحدد</button>
   <button id="edApply" type="button" class="btn-main px-4 py-2.5 text-sm">اعتماد وإعادة التدقيق</button>
   <select id="edDown" class="field" style="width:auto;padding:.5rem"><option value="">تنزيل…</option><option value="doc">Word (.doc)</option><option value="pdf">PDF (طباعة)</option><option value="txt">نص (.txt)</option></select>
  </div></div></div>

<!-- عقودي السابقة -->
<div id="view-dash" class="hidden max-w-6xl mx-auto px-4 py-10">
  <div class="text-center mb-6"><h2 class="sec-title text-3xl font-extrabold">عقودي <span class="grad-text">السابقة</span></h2></div>
  <div class="grid sm:grid-cols-3 gap-4 mb-6" id="kpis"></div>
  <div class="panel" style="margin:0;overflow-x:auto"><table class="tbl"><thead><tr><th>رقم المرجع</th><th>عنوان العقد</th><th>التاريخ</th><th>نسبة الامتثال</th><th>مستوى المخاطر</th><th></th></tr></thead><tbody id="hist"></tbody></table></div>
  <div class="text-center mt-4"><button class="btn-ghost px-4 py-2 text-sm" id="clearHist">مسح السجل</button></div>
</div>

<div id="memoModal" class="hidden fixed inset-0 z-40 flex items-center justify-center p-4 bg-[#0f1a3d]/60 backdrop-blur-sm no-print">
  <div class="bg-white rounded-3xl w-full max-w-3xl max-h-[88vh] flex flex-col shadow-2xl" style="color:#263065">
    <div class="p-5 border-b border-[#E3E9F5] flex items-center justify-between"><h3 id="mmTitle" class="font-extrabold text-xl"></h3><button id="mmClose" class="w-9 h-9 rounded-full hover:bg-[#EEF3FA] text-xl" aria-label="إغلاق">✕</button></div>
    <div id="mmBody" class="p-5 overflow-y-auto prose-ar"></div>
  </div>
</div>

<div class="gfoot no-print"><div class="in"><div><h4>عن مُحكم</h4>منظومة ذكية للتدقيق الاستباقي للعقود التجارية قبل التوقيع وفق الأنظمة السعودية.</div><div><h4>روابط سريعة</h4><button data-go="home" data-anchor="journey">رحلة العقد</button><button data-go="home" data-anchor="services">الخدمات</button><button data-go="home" data-anchor="roadmap">خارطة الطريق</button><button data-go="dash">عقودي</button></div><div><h4>ابدأ</h4><button data-go="assistant">المساعد الذكي</button><button data-go="library">مكتبة العقود</button><button data-go="advisors">مستشارو مُحكم</button></div></div><div class="legal">هذه المرئيات لا تُغني عن المحامي ولا تُعد استشارة قانونيَّة · مُحكم | Muhkam</div></div>
<footer class="no-print text-center pb-10 text-sm font-bold text-[var(--muted)]">
  <span class="gold-text">مُحكم | Muhkam</span> — جميع الحقوق محفوظة
</footer>

<div id="tplModal" class="hidden fixed inset-0 z-40 flex items-center justify-center p-4 bg-[#0f1a3d]/60 backdrop-blur-sm no-print">
  <div class="bg-white rounded-3xl w-full max-w-2xl max-h-[88vh] flex flex-col shadow-2xl">
    <div class="p-5 border-b border-[#E3E9F5] flex items-center justify-between">
      <h3 id="mTitle" class="font-extrabold text-xl grad-text"></h3>
      <button id="mClose" class="w-9 h-9 rounded-full hover:bg-[#EEF3FA] text-xl" aria-label="إغلاق">✕</button>
    </div>
        <div class="px-5 pt-3 flex flex-wrap items-center gap-2 no-print" id="tplMode">
      <span class="text-sm font-bold" style="color:#5d6a8a">طريقة التعبئة:</span>
      <div class="tgl"><button type="button" data-mode="stepper" class="on">التعبئة الذكية بالخطوات</button><button type="button" data-mode="manual">تعديل يدوي</button></div>
    </div>
    <div id="stepBox" class="px-5 pb-2 hidden" style="color:#263065"></div>
    <pre id="mText"
 class="p-5 overflow-y-auto whitespace-pre-wrap leading-9 text-[15px]" style="font-family:inherit"></pre>
    <div class="p-4 border-t border-[#E3E9F5] flex flex-wrap gap-2">
      <button id="mUse" class="btn-main px-4 py-2.5 text-sm">دقّق بالمساعد</button>
      <button id="mCopy" class="btn-ghost px-4 py-2.5 text-sm">نسخ</button>
      <button id="mPrint" class="btn-gold px-4 py-2.5 text-sm">طباعة</button>
    </div>
  </div>
</div>

<div id="toast" class="toast" role="status"></div>

<script>
/* ===== الإعدادات ===== */
// رابط الخدمة
const PROXY_URL = 'https://quiet-waterfall-c496.s445001732.workers.dev';
const MIC_SVG='<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
const STOP_SVG='<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>';

const SAMPLE = `عقد توريد تجاري

أُبرم هذا العقد بتاريخ 01/01/2026م بين:
الطرف الأول: شركة الأفق للتجارة، سجل تجاري رقم 1010XXXXXX (المورِّد).
الطرف الثاني: مؤسسة النخبة للمقاولات، سجل تجاري رقم 4030XXXXXX (المشتري).

المادة (1): موضوع العقد
يلتزم الطرف الأول بتوريد مواد بناء للطرف الثاني حسب الكميات التي يطلبها الطرف الثاني شفهياً أو كتابياً ومتى شاء.

المادة (2): الثمن والدفع
يدفع الطرف الثاني قيمة التوريدات خلال مدة مناسبة من استلام البضاعة. ويحق للطرف الأول تعديل الأسعار في أي وقت دون إشعار مسبق.

المادة (3): التسليم
يتم التسليم في الموعد الذي يحدده الطرف الأول. ولا يتحمل الطرف الأول أي مسؤولية عن التأخير مهما كانت أسبابه.

المادة (4): الضمان
تُباع البضاعة بحالتها، ويتنازل الطرف الثاني عن أي حق في الاعتراض أو الرد بسبب العيوب.

المادة (5): الشرط الجزائي
في حال تأخر الطرف الثاني عن السداد يلتزم بدفع غرامة قدرها 50% من قيمة العقد، ويحق للطرف الأول فسخ العقد فوراً دون حكم قضائي.

المادة (6): الفسخ
يحق للطرف الأول إنهاء العقد في أي وقت دون إبداء الأسباب، بينما لا يحق للطرف الثاني ذلك إطلاقاً.

المادة (7): النزاعات
يُحل أي نزاع بالطريقة التي يراها الطرف الأول مناسبة، ويخضع العقد للقانون الذي يختاره الطرف الأول.

مدة العقد: سنة تتجدد تلقائياً ما لم يُنهِ الطرف الأول العقد.

التوقيع:
الطرف الأول: ____________        الطرف الثاني: ____________`;

/* ===== المحادثة ===== */
const $ = id => document.getElementById(id);
const roleEl=$('role'), contractEl=$('contract'), sendBtn=$('sendBtn'), msgs=$('msgs');
const isTouch = matchMedia('(pointer:coarse)').matches;
let busy=false, lastText='';
/* حالة المحادثة: تُحفظ بين الرسائل ليتذكر المستشار العقد */
let conversationId='', baseContract='', chatRole='', memoDone=false, lastReq=null, lastFlaws=null;
const USER_ID=(()=>{ try{ let u=localStorage.getItem('muhkam_uid'); if(!u){ u='u'+Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('muhkam_uid',u);} return u; }catch{ return 'u'+Math.random().toString(36).slice(2); } })();
const FIRST_QUERY='قم بتدقيق العقد المرفق وإعداد المرئيات النظامية.';
const SUGGESTIONS=['خفف الشرط الجزائي','أعد صياغة العقد كاملاً بعد التعديلات','ما أخطر ثغرة في العقد؟','اقترح بنداً يحمي مصلحتي'];
const esc=t=>t.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));

function autosize(){ contractEl.style.height='auto'; contractEl.style.height=Math.min(contractEl.scrollHeight,160)+'px'; }
function updateCount(){ $('count').textContent=contractEl.value.length.toLocaleString('ar-SA')+' حرف'; autosize(); }
contractEl.addEventListener('input',updateCount);
contractEl.addEventListener('keydown',e=>{ if(e.key==='Enter'&&!e.shiftKey&&!isTouch){ e.preventDefault(); send(); } });
sendBtn.addEventListener('click',send);
/* ===== إرفاق ملف (Word / نص) ===== */
const MAX_CHARS=30000;
$('attachBtn').addEventListener('click',()=>{ if(!busy) $('fileIn').click(); });
$('fileIn').addEventListener('change',async e=>{
  const f=e.target.files[0]; e.target.value=''; if(!f||busy) return;
  const name=f.name.toLowerCase();
  if(f.size>8*1024*1024){ toast('الملف كبير (الحد 8 ميغابايت)'); return; }
  try{
    let text='';
    if(name.endsWith('.docx')){
      if(typeof mammoth==='undefined') throw new Error('تعذّر تحميل قارئ Word، تأكد من الاتصال بالإنترنت');
      text=(await mammoth.extractRawText({arrayBuffer:await f.arrayBuffer()})).value;
    }else if(name.endsWith('.txt')||name.endsWith('.md')){
      text=await f.text();
    }else if(name.endsWith('.doc')){
      throw new Error('صيغة .doc القديمة غير مدعومة، احفظ الملف بصيغة .docx ثم أعد المحاولة');
    }else{
      throw new Error('الصيغ المدعومة: Word (.docx) والنص (.txt)');
    }
    text=text.replace(/\r\n?/g,'\n').replace(/\n{3,}/g,'\n\n').trim();
    if(!text) throw new Error('لم أجد نصاً داخل الملف');
    if(text.length>MAX_CHARS){ text=text.slice(0,MAX_CHARS); toast('تم اقتصاص العقد إلى '+MAX_CHARS.toLocaleString('ar-SA')+' حرف (حد الخدمة)'); }
    else toast('تم إدراج «'+f.name+'» اضغط إرسال');
    if(memoDone){ resetChat(); welcome(); }
    contractEl.value=text; updateCount(); contractEl.focus();
  }catch(err){ toast(err.message||'تعذّرت قراءة الملف'); }
});


function toast(msg){ const t=$('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2200); }
const down=()=>msgs.scrollTo({top:msgs.scrollHeight});

function addMsg(kind,html,cls=''){
  const row=document.createElement('div');
  row.className='flex items-end gap-2 '+(kind==='u'?'justify-start':'justify-end');
  row.innerHTML = kind==='u' ? `<div class="bub bub-u ${cls}">${html}</div>`
                             : `<div class="bub bub-a ${cls}">${html}</div><div class="avatar"><img src="logo.jpg" alt="مُحكم"></div>`;
  msgs.appendChild(row); down(); return row;
}
const CHIPS='<div class="flex flex-wrap gap-2 mt-3"><button class="chip" data-act="tpl">اختيار عقد من المكتبة</button></div>';
const TPLQ=['عقد إيجار سكني','عقد عمل','عقد توريد','عقد تقديم خدمات','اتفاقية عدم إفصاح','عقد شراكة'];
function welcome(){
  msgs.innerHTML='';
  addMsg('a','<b>أهلاً بكم في مُحكم.</b><br>يسرّنا خدمتكم في التدقيق الاستباقي لعقودكم التجارية قبل التوقيع. يمكنكم أولاً اختيار عقد من مكتبة مُحكم وتعبئة بياناته ثم إرساله للتدقيق، أو لصق عقدكم أو إرفاقه مباشرة. وبعد التدقيق تصلكم مذكرة بالمخاطر ودرجاتها والصياغات البديلة، ويمكنكم تظليل مواضع المرئية في نص العقد.<div class="text-sm mt-2 opacity-80">تُحجب بياناتكم الحساسة تلقائياً قبل المعالجة.</div><div class="flex flex-wrap gap-2 mt-3">'+TPLQ.map((t,i)=>`<button class="chip" data-act="tpl1" data-i="${i}">${t}</button>`).join('')+'<button class="chip" data-act="tpl">كل النماذج</button></div>');
}
function setBusy(on){
  busy=on; sendBtn.disabled=on;
  $('sendIcon').innerHTML = on ? '<div class="spinner"></div>' : '➤';
}
function userPreview(t){
  if(t.length<=240) return esc(t);
  return `<b>عقد · ${t.length.toLocaleString('ar-SA')} حرف</b><div class="text-sm opacity-90 mt-1">${esc(t.slice(0,200))}…</div>`;
}

function lockRole(on){ const sg=$('seg'); sg.style.opacity=on?'.55':''; sg.style.pointerEvents=on?'none':''; }
function showSuggest(on){
  const box=$('suggest');
  if(on&&!box.children.length) box.innerHTML=SUGGESTIONS.map(q=>`<button type="button" class="chip" data-q="${q}">${q}</button>`).join('');
  box.style.display=on?'flex':'none';
}
function resetChat(){
  conversationId=''; baseContract=''; chatRole=''; memoDone=false; lastReq=null; lastText=''; lastFlaws=null;
  lockRole(false); showSuggest(false);
  contractEl.placeholder='الصق نص العقد هنا…';
}

function send(){
  if(busy) return;
  let text=contractEl.value.trim(); if(!text) return;
  if(!memoDone&&text.length>=120){ PrivacyModule.mask(); text=contractEl.value.trim(); }
  contractEl.value=''; updateCount();
  if(memoDone){            /* رسالة نقاش بعد المذكرة */
    addMsg('u',esc(text));
    run(baseContract,text,false);
    return;
  }
  addMsg('u',userPreview(text));
  if(text.length<120){
    addMsg('a','أحتاج إلى نص العقد كاملاً لأدققه. الصقه هنا، أو أدرج عقداً تجريبياً، أو اختر نموذجاً من المكتبة.'+CHIPS);
    return;
  }
  baseContract=text; chatRole=roleEl.value; lockRole(true);
  run(text,FIRST_QUERY,true);
}

async function run(contract,query,isFirst){
  lastReq={contract,query,isFirst}; lastText=contract;
  setBusy(true);
  const typing=addMsg('a','<span class="dots"><span></span><span></span><span></span></span>'+(isFirst?'جارٍ تدقيق العقد…':'المستشار يكتب…'));
  try{
    const res=await fetch(PROXY_URL,{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({user_role:chatRole||roleEl.value,contract_text:contract,query,conversation_id:conversationId,user_id:USER_ID,want_flaws:!!isFirst})});
    const data=await res.json().catch(()=>({}));
    if(!res.ok) throw new Error(friendlyErr(res,data.message||('تعذّر الاتصال بالخدمة (رمز '+res.status+')')));
    if(!data.answer) throw new Error(friendlyErr(res,data.message||'لم تُرجع الخدمة إجابة.'));
    if(data.conversation_id) conversationId=data.conversation_id;
    typing.remove();
    if(isFirst){ lastFlaws=Array.isArray(data.flaws)?data.flaws.map(normFlaw).filter(f=>f.original_text):null; addMemo(data.answer); memoDone=true; showSuggest(true); contractEl.placeholder='اسأل المستشار أو اطلب تعديلاً على العقد…'; }
    else addAnswer(data.answer);
  }catch(e){
    typing.remove();
    addMsg('a',`<span class="text-rose-600 font-bold">${esc(e instanceof TypeError?'تعذّر الاتصال بالخدمة، تحقق من الإنترنت وأعد المحاولة.':(e.message||'حدث خطأ غير متوقع'))}</span><div class="mt-2"><button class="chip" data-act="retry">↻ إعادة المحاولة</button></div>`);
  }finally{ setBusy(false); contractEl.focus(); }
}

function addMemo(md){
  const date=new Date().toLocaleDateString('ar-EG',{year:'numeric',month:'long',day:'numeric'});
  addMsg('a',`<div class="memo-top">مذكرة التدقيق القانوني <span>· ${chatRole||roleEl.value} · ${date}</span></div>
    <div class="prose-ar">${DOMPurify.sanitize(marked.parse(md))}</div>
    <div class="flex flex-wrap gap-2 mt-3"><button class="chip" data-act="highlight">تظليل العقد</button><button class="chip" data-tool="btnEdit">تحرير العقد</button><button class="chip" data-tool="btnBalance">قياس توازن العقد</button><button class="chip chip-key" data-tool="btnImprove">مُحسِّن الصياغة</button><button class="chip" data-act="copy">نسخ المذكرة</button><button class="chip" data-act="adv">احجز موعداً مع مختص</button><button class="chip spk" data-act="speak">استمع</button><button class="chip" data-act="print">طباعة / PDF</button></div>
    <div class="text-sm mt-3 opacity-80">ناقش المستشار في الأسفل: اختر اقتراحاً سريعاً أو اكتب سؤالك.</div>`,'bub-memo');
}
function addAnswer(md){
  addMsg('a',`<div class="prose-ar">${DOMPurify.sanitize(marked.parse(md))}</div>
    <div class="flex flex-wrap gap-2 mt-3"><button class="chip" data-act="copy">نسخ</button><button class="chip spk" data-act="speak">استمع</button><button class="chip" data-act="print">طباعة / PDF</button></div>`);
}

/* اقتراحات سريعة */
$('suggest').addEventListener('click',e=>{
  const q=e.target.dataset.q; if(!q||busy||!memoDone) return;
  addMsg('u',esc(q)); run(baseContract,q,false);
});

/* أزرار داخل الرسائل */
msgs.addEventListener('click',async e=>{
  const act=e.target.dataset.act; if(!act) return;
  if(act==='sample'){ contractEl.value=SAMPLE; updateCount(); contractEl.focus(); toast('أُدرج العقد التجريبي، اضغط إرسال'); }
  if(act==='tpl'){ NavModule.go('library'); }
  if(act==='adv'){ NavModule.go('advisors'); return; }
  if(act==='tpl1'){ openTpl(+e.target.dataset.i); }
  if(act==='retry'&&!busy&&lastReq){ run(lastReq.contract,lastReq.query,lastReq.isFirst); }
  if(act==='highlight'){ showHighlighted(e.target); return; }
  if(act==='speak'){ const el=e.target.closest('.bub')?.querySelector('.prose-ar'); if(el) SpeakModule.toggle(SpeakModule.extractText(el),e.target); return; }
  const memo=e.target.closest('.bub')?.querySelector('.prose-ar');
  if(act==='copy'&&memo){
    try{ await navigator.clipboard.writeText(memo.innerText); }catch{ const ta=document.createElement('textarea'); ta.value=memo.innerText; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
    toast('تم نسخ المذكرة');
  }
  if(act==='print'&&memo){
    const w=window.open('','_blank');
    w.document.write(`<html dir="rtl" lang="ar"><head><meta charset="utf-8"><link rel="icon" href="logo.jpg"><title>مذكرة التدقيق القانوني</title><style>body{font-family:Tajawal,sans-serif;padding:36px;line-height:2;color:#1c2447}h1,h2,h3{color:#263065}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccd;padding:6px 8px;text-align:right}blockquote{background:#f3f7f6;border-right:4px solid #8DA7C7;margin:12px 0;padding:6px 12px}</style></head><body><h2>مُحكم | Muhkam — مذكرة التدقيق القانوني</h2><p>الصفة: ${roleEl.value}</p>${memo.innerHTML}<p style="font-size:12px;color:#667;margin-top:24px">هذه المرئيات لا تُغني عن المحامي ولا تُعد استشارة قانونيَّة.</p></body></html>`);
    w.document.close(); w.focus(); w.print();
  }
});

/* الصفة + محادثة جديدة */
$('seg').addEventListener('click',e=>{
  const r=e.target.dataset.role; if(!r) return;
  roleEl.value=r; [...$('seg').children].forEach(b=>b.classList.toggle('on',b===e.target));
});
$('newChat').addEventListener('click',()=>{ if(!busy){ resetChat(); welcome(); contractEl.value=''; updateCount(); } });
welcome();

/* ===== تظليل الثغرات داخل العقد ===== */
const SEV={
  high:{cls:'highlight-high',label:'خطورة عالية / بند باطل'},
  medium:{cls:'highlight-medium',label:'بند غامض أو يحتاج تعديل'},
  term:{cls:'highlight-term',label:'التزام أو مدة جوهرية'}
};
const FLAWS_QUERY='أعد نتائج التدقيق السابق بصيغة JSON فقط، دون أي نص قبلها أو بعدها ودون علامات ```. المطلوب مصفوفة كائنات، لكل ثغرة: original_text (اقتباس حرفي مطابق تماماً لعبارة قصيرة من نص العقد)، severity (واحدة من: high للباطل أو الخطير، medium للغامض أو المحتاج تعديل، term للالتزامات والمدد الجوهرية)، title (عنوان مختصر)، explanation (الشرح)، legal_basis (السند النظامي)، suggested_text (الصياغة البديلة).';

function sevKey(s){
  s=String(s||'').toLowerCase();
  if(/high|critical|عال|باطل|خطير|جسيم/.test(s)) return 'high';
  if(/term|oblig|التزام|مدة|جوهر/.test(s)) return 'term';
  return 'medium';
}
function cleanField(x,max,drop){
  let t=String(x||'').replace(/\*\*|__/g,'').replace(/^#+\s*/gm,'').trim();
  const m=t.search(/\n\s*[\d.#*\-]*\s*(?:مواطن\s+التحسين|الأساس\s+النظامي|مذكرة\s+التدقيق)/);
  if(m>0) t=t.slice(0,m).trim();
  if(t.length>max){ if(drop) return ''; t=t.slice(0,max).replace(/\s+\S*$/,'')+'…'; }
  return t;
}
function normFlaw(f){
  f=f||{};
  return {
    original_text:cleanField(f.original_text||f.text||f.clause||'',500,true),
    severity:sevKey(f.severity),
    title:cleanField(f.title||f.issue||f.problem||'',120,false),
    explanation:cleanField(f.explanation||f.reason||'',700,false),
    legal_basis:cleanField(f.legal_basis||f.basis||f.law||'',400,false),
    suggested_text:cleanField(f.suggested_text||f.alternative||f.replacement||'',1000,true)
  };
}
function parseFlaws(answer){
  let t=String(answer).replace(/```json|```/gi,'').trim();
  const a=t.indexOf('['), b=t.lastIndexOf(']'), c=t.indexOf('{'), d=t.lastIndexOf('}');
  let arr=null;
  try{ if(a>=0&&b>a&&(c<0||a<c)) arr=JSON.parse(t.slice(a,b+1)); }catch{}
  if(!arr){ try{ const o=JSON.parse(t.slice(c,d+1)); arr=o.flaws||o.issues||o.items; }catch{} }
  return (Array.isArray(arr)?arr:[]).map(normFlaw).filter(f=>f.original_text);
}

/* تطبيع للمطابقة: يتجاهل التشكيل والتطويل وفروق الهمزات والمسافات، مع الاحتفاظ بمواضع النص الأصلي */
function buildNorm(s){
  let out='', map=[], sp=false;
  for(let i=0;i<s.length;i++){
    let ch=s[i];
    if(/[\u064B-\u0652\u0640\u200B-\u200F]/.test(ch)) continue;
    if(/\s/.test(ch)){ if(sp||!out) continue; ch=' '; sp=true; } else sp=false;
    ch=ch.replace(/[أإآ]/,'ا').replace('ى','ي');
    out+=ch; map.push(i);
  }
  return {out,map};
}

/* يرسم العقد مظللاً داخل viewerEl ويرجع فهارس الثغرات التي لم يُعثر على نصها */
function renderHighlightedContract(contractText, detectedFlaws, viewerEl){
  const N=buildNorm(contractText), ranges=[], unmatched=[];
  /* الأطول أولاً لتفادي تداخل التظليل */
  const order=detectedFlaws.map((_,i)=>i).sort((a,b)=>detectedFlaws[b].original_text.length-detectedFlaws[a].original_text.length);
  order.forEach(i=>{
    const p=buildNorm(detectedFlaws[i].original_text).out.trim();
    if(p.length<4){ unmatched.push(i); return; }
    let from=0, ok=false;
    while(true){
      const at=N.out.indexOf(p,from); if(at<0) break;
      const s=N.map[at]; let e=N.map[at+p.length-1]+1; while(/[\u064B-\u0652]/.test(contractText[e]||'')) e++;
      if(!ranges.some(r=>s<r.e&&e>r.s)){ ranges.push({s,e,i}); ok=true; break; }
      from=at+1;
    }
    if(!ok) unmatched.push(i);
  });
  ranges.sort((a,b)=>a.s-b.s);
  const part=t=>esc(t).replace(/\n/g,'<br>');
  let html='', pos=0;
  ranges.forEach(r=>{
    html+=part(contractText.slice(pos,r.s));
    html+=`<mark class="highlight ${SEV[detectedFlaws[r.i].severity].cls}" data-flaw-index="${r.i}" tabindex="0" role="button" title="اضغط لعرض التفاصيل القانونية والصياغة البديلة">${part(contractText.slice(r.s,r.e))}</mark>`;
    pos=r.e;
  });
  viewerEl.innerHTML=html+part(contractText.slice(pos));
  return unmatched.sort((a,b)=>a-b);
}

function showFlawDetails(flaws,i,detailEl){
  const f=flaws[i], sv=SEV[f.severity];
  detailEl.innerHTML=`<div class="flaw-card sev-${f.severity}">
    <div class="text-xs font-bold mb-1">${sv.label}</div>
    <h4>${esc(f.title||'ملاحظة قانونية')}</h4>
    ${f.explanation?`<p>${esc(f.explanation)}</p>`:''}
    ${f.legal_basis?`<p class="mt-2"><span class="lbl">السند النظامي:</span> ${esc(f.legal_basis)}</p>`:''}
    ${f.suggested_text?`<div class="alt"><span class="lbl">الصياغة البديلة:</span><br>${esc(f.suggested_text)}</div>
      <button type="button" class="chip mt-2" data-copy="${i}">نسخ الصياغة</button>`:''}
  </div>`;
  detailEl.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function mountHighlightView(contract,flaws){
  const row=addMsg('a',`<div class="memo-top">العقد مع تظليل الثغرات <span>· اضغط على أي نص ملوّن للتفاصيل</span></div>
    <div class="hl-legend">${Object.values(SEV).map(s=>`<span class="${s.cls}">${s.label}</span>`).join('')}</div>
    <div class="contract-viewer"></div><div class="hl-detail"></div><div class="hl-missing text-sm mt-2 opacity-80"></div>`,'bub-memo');
  const viewer=row.querySelector('.contract-viewer'), detail=row.querySelector('.hl-detail');
  const un=renderHighlightedContract(contract,flaws,viewer);
  if(un.length) row.querySelector('.hl-missing').innerHTML='ثغرات تعذّر تحديد موضعها في النص: '+un.map(i=>esc(flaws[i].title||flaws[i].original_text.slice(0,40))).join('، ');
  const open=m=>{
    viewer.querySelectorAll('.highlight.active').forEach(x=>x.classList.remove('active'));
    m.classList.add('active'); showFlawDetails(flaws,+m.dataset.flawIndex,detail);
  };
  row.addEventListener('click',async e=>{
    const m=e.target.closest('.highlight'); if(m) return open(m);
    const c=e.target.closest('[data-copy]');
    if(c){ try{ await navigator.clipboard.writeText(flaws[+c.dataset.copy].suggested_text); toast('تم نسخ الصياغة'); }catch{ toast('تعذّر النسخ'); } }
  });
  row.addEventListener('keydown',e=>{ const m=e.target.closest('.highlight'); if(m&&(e.key==='Enter'||e.key===' ')){ e.preventDefault(); open(m); } });
  const first=viewer.querySelector('.highlight'); if(first) first.scrollIntoView({block:'nearest'});
}

async function showHighlighted(btn){
  if(busy||!baseContract) return;
  let flaws=lastFlaws;
  if(!flaws||!flaws.length){
    btn.disabled=true; setBusy(true);
    const typing=addMsg('a','<span class="dots"><span></span><span></span><span></span></span>جارٍ تحديد مواضع الثغرات…');
    try{
      const res=await fetch(PROXY_URL,{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({user_role:chatRole||roleEl.value,contract_text:baseContract,query:FLAWS_QUERY,conversation_id:conversationId,user_id:USER_ID})});
      const data=await res.json().catch(()=>({}));
      if(!res.ok||!data.answer) throw new Error(friendlyErr(res,data.message||('تعذّر الاتصال بالخدمة (رمز '+res.status+')')));
      if(data.conversation_id) conversationId=data.conversation_id;
      flaws=Array.isArray(data.flaws)?data.flaws.map(normFlaw).filter(f=>f.original_text):parseFlaws(data.answer);
      if(!flaws.length) throw new Error('تعذّر استخراج الثغرات بصيغة قابلة للتظليل، حاول مرة أخرى.');
      lastFlaws=flaws;
    }catch(err){
      typing.remove(); btn.disabled=false; setBusy(false);
      addMsg('a',`<span class="text-rose-600 font-bold">${esc(err instanceof TypeError?'تعذّر الاتصال بالخدمة، تحقق من الإنترنت وأعد المحاولة.':(err.message||'حدث خطأ'))}</span>`); return;
    }
    typing.remove(); setBusy(false);
  }
  btn.disabled=true;
  mountHighlightView(baseContract,flaws);
}

