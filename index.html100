TPL.push(...[{"cat": "تحويل فرع", "icon": "", "title": "تحويل فرع شركة إلى شركة تضامن (مهنية)", "desc": "عقد تأسيس شركة تضامن ناتجة عن تحويل فرع شركة.", "text": "عقد تأسيس شركة ......................\n\n(شركة تضامن)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ...........) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة ............. والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (تضامن)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nالتمهيد جزء لا يتجزأ من العقد\n\nالمادة الثانية: اسم الشركة:\nشركة ........................... (شركة تضامن)\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة .................\n\n\tالمادة الرابعة: أغراض الشركة :\n\n\t- ..................\n\n\t- ..................\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة: رأس المال:\n\n- حدد رأس مال الشركة بـ (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال مقسم إلى (.....) حصة، تم توزيعها على الشركاء كالتالي:\n\n- الطرف الأول/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (.....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n- الطرف الثاني/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (.....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n(الجدول أدناه يعد خيار آخر للتعريف بالحصة التي تعهّد كل شريك بتقديمها)\n\n| م | اسم الشريك | طريقة الوفاء بقيمة الحصص | قيمة الحصة | عدد الحصص | الإجمالي |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  | نقداً |  |  |  |\n| 2 |  | عينياً مع تعريف كاف بالمنقولات أو العقارات المقدمة |  |  |  |\n| الإجمالي |  |  |  |  |  |\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n-  يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nأو\n\n-  يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، ويتعهد الشريك ............... (اسم الشريك) بالوفاء بحصته (النقدية أو العينية أو النقدية والعينية) خلال (.....) يوم من تاريخ قيد الشركة لدى السجل التجاري.\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية أو ميلادية) تبدأ من تاريخ قيدها لدى السجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السابعة: إدارة الشركة:\n\n(الأصل أن يكون المدير من الشركاء، ويجوز أن يكون من الغير، مع مراعاة الحالة التي يكون فيها المدير شريكاً ذو شخصية اعتبارية فيذكر اسم الشخصية الاعتبارية كمدير واسم ممثله الشخص الطبيعي، كما يجوز تعيين المدير أو المديرين في عقد التأسيس ويجوز تعيينهم في عقد مستقل)\n\n- التعيين:\n\n(في عقد التأسيس)\n\n- يتولى إدارة الشركة ........................... (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nأو\n\n(في عقد مستقل)\n\n- يتولى إدارة الشركة ...........................   (يتعين الاختيار سواء مدير واحد، أو مدير واحد أو أكثر، أو مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- الصلاحيات والسلطات:\n\nيباشر (المدير أو المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة. (يجوز إضافة العبارة التالية: واستثناء من ذلك لا يجوز للمدير أو المديرين مباشرة الأعمال التالية إلا بقرار من الشركاء: أ. .................. ب. ....................)\n\n(يجوز أيضا إضافة النص الآتي بفقراته السبع كاملة أو الاكتفاء ببعض الفقرات)\n\nكما يجوز (للمدير أو المديرين) مباشرة الأعمال التالية التي قد تتجاوز غرض الشركة دون الحاجة لإصدار قرار من الشركاء:\n\n-  إنشاء فروع الشركة، أو إغلاقها.\n\n- التبرعات.\n\n- كفالة الشركة للغير.\n\n- التصالح على حقوق الشركة.\n\n- بيع عقارات الشركة أو رهنها.\n\n- بيع محلّ الشركة التجاري (المتجر) أو رهنه.\n\n- الاقتراض نيابة عن الشركة.\n\n(يجوز في حالة تعيين أكثر من مدير تحديد اختصاص كل منهم، ووضع آلية لإصدار قراراتهم)\n\n\t-  العزل: (فقرة اختيارية)\n\n- إذا كان المدير شريكاً في الشركة فيجوز عزله ................... (يتعين الاختيار من أحد الخيارات التالية: بقرار يصدر بإجماع الشركاء الآخرين في الشركة، أو بقرار يصدر بالأغلبية العددية للشركاء، كما يجوز الاتفاق على أغلبية عددية معينة في عزل المدير غير ما ذكر)\n\n- إذا كان المدير من غير الشركاء فيجوز عزله بقرار يصدر بالأغلبية العددية للشركاء.\n\nالمادة الثامنة: ‌قرارات الشركاء والنصاب اللازم لصدورها:\n\n(يتعين النص في العقد على أحد الخيارات التالية)\n\n-  تصدر قرارات الشركاء بالأغلبية العددية لآرائهم، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء.\n\nأو\n\n- تصدر جميع قرارات الشركاء بالإجماع.\n\nأو\n\n- تصدر قرارات الشركاء بالأغلبية العددية لآرائهم إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيصدر بموافقة ثلاثة أرباع الشركاء.\n\nالمادة التاسعة: توزيع الأرباح والخسائر:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n-  يكون نصيب كل شريك في الأرباح أو الخسائر بحسب حصته في رأس المال.\n\nأو\n\n- (في حال وجود شريك بحصة عمل، فيتم اختيار الآتي)\n\nيكون نصيب كل شريك في الأرباح أو الخسائر كما يلي:\n\n| م | اسم الشريك | نصيبه في الأرباح % | نصيبه في الخسائر % |\n| --- | --- | --- | --- |\n| 1 |  |  |  |\n| 2 |  |  |  |\n\nالمادة العاشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها لدى السجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً (هجرية أو ميلادية)\n\nالمادة الحادية عشرة: التنازل عن الحصص أو انسحاب أو إخراج شريك: (مادة اختيارية)\n\n- لا يجوز للشريك التنازل عن كل أو بعض حصصه (إلا بموافقة باقي الشركاء أو إلا وفقاً للشروط التالية: أ. .............. ب. .............). (يجوز النص على طريقة تقييم حصة الشريك إذا تنازل عنها مع النص على جواز ممارسة حق الاسترداد وآليته)\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز تعديل النص حسب رغبة الشركاء)\n\n- للأغلبية العددية للشركاء التقدم بطلب إلى الجهة القضائية المختصة لإخراج شريك أو أكثر من الشركة إذا كانت هناك أسباب مشروعة تدعو إلى ذلك، وتظل الشركة قائمة بين باقي الشركاء. (يجوز استبدال هذا النص وذلك بإيراد إجراءات أخرى لإخراج الشريك)\n\n4. (يجوز النص على طريقة تقييم حصة الشريك إذا انسحب أو أخرج من الشركة أو في حال افتتاح أي من إجراءات الإفلاس تجاهه وفقاً لنظام الإفلاس أو وفاته وعدم دخول الورثة في الشركة)\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n\t- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا للمادة (العاشرة) من عقد التأسيس. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\n- في حالة وفاة أي من الشركاء (يمكن اختيار أحد الخيارات التالية)\n\n\t\t-  فلا تنقضي الشركة وتستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة. ويجب في هذه الحالة تحويل الشركة خلال مدة لا تتجاوز (سنة) من تاريخ وفاة مورثهم إلى شركة توصية بسيطة يصبح فيها القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا؛ وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المدة، ما لم يبلغ القاصر- خلال هذه المدة- سن الرشد أو ينتفِ سبب المنع عن مزاولة الأعمال التجارية ويرغب ذلك القاصر أو الممنوع من مزاولة الأعمال التجارية في أن يكون شريكًا متضامنًا.\n\n\t\t- فلا تنقضي الشركة وتستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفي إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n\t\t- فإن الشركة تنقضي بمجرد وفاته.\n\nالمادة الثالة عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذه العقد يخالف أحكام نظام الشركات ولائحته التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولائحته التنفيذية وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\n\t\tالشريك الأول                                                                         الشريك الثاني\n\nعقد تأسيس شركة ......................\n\n(شركة تضامن مهنية)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\n(يجب أن يكون جميع الشركاء من المرخص لهم بممارسة المهنة)\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ...........) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة ............. والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (تضامن مهنية)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\n المادة الأولى:\n\nالتمهيد جزء لا يتجزأ من العقد\n\nالمادة الثانية: اسم الشركة:\n\nشركة .......................... (شركة تضامن مهنية)\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة ....................\n\nالمادة الرابعة: أغراض الشركة:\n\nممارسة مهنة ...................... (يجب أن يكون نشاط الشركة مهنيًّا ويتوافق مع التراخيص المهنية للشركاء)\n\nالمادة الخامسة: رأس المال:\n\n-  حدد رأس مال الشركة بـ (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال مقسم إلى (.....) حصة، تم توزيعها على الشركاء كالتالي:\n\n- الطرف الأول/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (......) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n- الطرف الثاني/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (......) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n(الجدول أدناه يعد خيار آخر للتعريف بالحصة التي تعهّد كل شريك بتقديمها)\n\n| م | اسم الشريك | طريقة الوفاء بقيمة الحصص | قيمة الحصة | عدد الحصص | الإجمالي |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  | نقداً |  |  |  |\n| 2 |  | عينياً مع تعريف كاف بالمنقولات أو العقارات المقدمة |  |  |  |\n| الإجمالي |  |  |  |  |  |\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nأو\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، ويتعهد الشريك ............... (اسم الشريك) بالوفاء بحصته (النقدية أو العينية أو النقدية والعينية) خلال (.....) يوم من تاريخ قيد الشركة لدى السجل التجاري.\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية أو ميلادية) تبدأ من تاريخ قيدها لدى السجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السابعة: إدارة الشركة:\n\n(إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة، كما يجوز تعيين المدير أو المديرين في عقد التأسيس ويجوز تعيينهم في عقد مستقل)\n\n- التعيين:\n\n(في عقد التأسيس)\n\n- يتولى إدارة الشركة ............................ (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nأو\n\n(في عقد مستقل)\n\n- يتولى إدارة الشركة ................................... (يتعين الاختيار سواء مدير واحد، أو مدير واحد أو أكثر، أو مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- الصلاحيات والسلطات:\n\nيباشر .................................. (المدير أو المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة. (يجوز إضافة العبارة التالية: واستثناء من ذلك لا يجوز للمدير أو المديرين مباشرة الأعمال التالية إلا بقرار من الشركاء: أ. .................. ب. ....................)\n\n(يجوز أيضا إضافة النص الآتي بفقراته السبع كاملة أو الاكتفاء ببعض الفقرات)\n\nكما يجوز ................................. (للمدير أو المديرين) مباشرة الأعمال التالية التي قد تتجاوز غرض الشركة دون الحاجة لإصدار قرار من الشركاء:\n\n-  إنشاء فروع الشركة، أو إغلاقها.\n\n- التبرعات.\n\n- كفالة الشركة للغير.\n\n- التصالح على حقوق الشركة.\n\n- بيع عقارات الشركة أو رهنها.\n\n- بيع محلّ الشركة التجاري (المتجر) أو رهنه.\n\n- الاقتراض نيابة عن الشركة.\n\n(يجوز في حالة تعيين أكثر من مدير تحديد اختصاص كل منهم)\n\n- مدة تولي الإدارة:\n\nمدة إدارة الشركة المعينة بموجب هذا العقد أو العقد المستقل غير محددة. (يمكن تحديد مدة، ويمكن وضع أحكام لتجددها، مع ملاحظة أن إضافة هذه الفقرة إلزامي حتى ولو كانت الإدارة معينة في عقد مستقل)\n\n-  مكافأة الإدارة:\n\n(يُحدد في هذه الفقرة المكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد آلية احتسابها لكونها في العادة عرضة للتغيير، مع ملاحظة أن إضافة هذه الفقرة إلزامي حتى ولو كانت الإدارة معينة في عقد مستقل)\n\n- العزل:\n\n- إذا كان المدير شريكاً في الشركة فيجوز عزله ....................... (يتعين الاختيار من أحد الخيارات التالية: بقرار يصدر بإجماع الشركاء الآخرين في الشركة، أو بقرار يصدر بالأغلبية العددية للشركاء، كما يجوز الاتفاق على أغلبية عددية معينة في عزل المدير غير ما ذكر)\n\n- إذا كان المدير من غير الشركاء فيجوز عزله بقرار يصدر بالأغلبية العددية للشركاء.\n\nالمادة الثامنة: قرارات الشركاء والنصاب اللازم لصدورها:\n\n(يتعين النص في العقد على أحد الخيارات التالية)\n\n-  تصدر قرارات الشركاء بالأغلبية العددية لآرائهم، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء.\n\nأو\n\n- تصدر جميع قرارات الشركاء بالإجماع.\n\nأو\n\n- تصدر قرارات الشركاء بالأغلبية العددية لآرائهم إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيصدر بموافقة ثلاثة أرباع الشركاء.\n\nالمادة التاسعة: قرارات الإدارة والنصاب اللازم لصدورها:\n\n(في حال تعيين مدير وأكثر لإدارة الشركة، فيتعين تحديد النصاب اللازم لصحة صدور كل قرار، وشروط نصاب أصوات الشركاء المديرين في ذلك القرار)\n\nالمادة العاشرة: توزيع الأرباح والخسائر:\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n- يكون نصيب كل شريك في الأرباح أو الخسائر بحسب حصته في رأس المال.\n\n- (في حال وجود شريك بحصة عمل، فيتم اختيار الآتي)\n\n يكون نصيب كل شريك في الأرباح أو الخسائر كما يلي:\n\n| م | اسم الشريك | نصيبه في الأرباح % | نصيبه في الخسائر % |\n| --- | --- | --- | --- |\n| 1 |  |  |  |\n| 2 |  |  |  |\n|  |  |  |  |\n\n- في حال فقد الشريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي: ........................\n\n(يجب النص على كيفية توزيع الأرباح والخسائر بين الشركاء عند وقوع هذه الحالة)\n\nالمادة الحادية عشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها لدى السجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً (هجرية أو ميلادية)\n\nالمادة الثانية عشرة: التنازل عن الحصص أو انسحاب الشريك أو إخراجه: (مادة اختيارية)\n\n- لا يجوز للشريك التنازل عن كل أو بعض حصصه (إلا بموافقة باقي الشركاء أو إلا وفقاً للشروط التالية: أ. .............. ب. .............). (يجوز النص على طريقة تقييم حصة الشريك إذا تنازل عنها مع النص على جواز ممارسة حق الاسترداد وآليته)\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز تعديل النص حسب رغبة الشركاء)\n\n- للأغلبية العددية للشركاء التقدم بطلب إلى الجهة القضائية المختصة لإخراج شريك أو أكثر من الشركة إذا كانت هناك أسباب مشروعة تدعو إلى ذلك، وتظل الشركة قائمة بين باقي الشركاء. (يجوز استبدال هذا النص وذلك بإيراد إجراءات أخرى لإخراج الشريك)\n\n4. (يجوز النص على طريقة تقييم حصة الشريك إذا انسحب أو أخرج من الشركة أو في حال افتتاح أي من إجراءات الإفلاس تجاهه وفقاً لنظام الإفلاس أو وفاته وعدم دخول الورثة في الشركة)\n\nالمادة الثالثة عشرة: الترخيص المهني:\n\n\t\tإذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية ............. (يتعين اختيار أحد الخيارين التالية)\n\n\t\t\t- عُد منسحباً من الشركة.\n\n\t\t\t- يستمر بصفته شريكا غير مرخص له في ممارسة المهنة في الشركة، إذا تحققت الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\nالمادة الرابعة عشرة: انقضاء الشركة:\n\n\t- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا للمادة (الحادية عشرة) من عقد التأسيس. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\n\t- في حالة وفاة أي من الشركاء (يمكن اختيار أحد الخيارات التالية)\n\n- فلا تنقضي الشركة وتستمر الشركة بين باقي الشركاء، ويكون نصيبه لورثته، وتقدر قيمة حصة الشريك المتوفى وفقاً للمادة (العاشرة) من هذا العقد. ولا يكون للورثة نصيب فيما يستجد بعد ذلك إلا بقدر ما تكون هذه الحقوق ناتجة عن عمليات سابقة على وفاة مورثهم.\n\n- فلا تنقضي الشركة ويحل ورثة الشريك المتوفى محل مورثهم شركاء في الشركة من خلال تحويلها إلى شركة ...................... (يتعين اختيار أحد الخيارات التالية: توصية بسيطة يكون للورثة فيها صفة الشريك الموصي، أو مساهمة، أو مساهمة مبسطة، أو ذات مسؤولية محدودة)، وذلك دون إخلال بما ورد في الفقرة (4) من المادة (المائتين) والمادة (الثالثة عشرة بعد المائتين) من نظام الشركات.\n\n- فإن الشركة تنقضي بمجرد وفاته.\n\nالمادة الخامسة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولائحته التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولائحته التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\n\t\tالشريك الأول                                                                         الشريك الثاني"}, {"cat": "تحويل فرع", "icon": "", "title": "تحويل فرع شركة إلى شركة ذات مسؤولية محدودة (مهنية)", "desc": "عقد تأسيس شركة ذات مسؤولية محدودة ناتجة عن تحويل فرع.", "text": "عقد تأسيس شركة ......................\n\n(شركة ذات مسؤولية محدودة)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\n(في حال وجود شريك بالعمل تضاف بياناته ضمن بيانات الشركاء ولا يضاف اسمه في مادة رأس المال)\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة..............) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالإسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\nشركة .................... (شركة ذات مسؤولية محدودة)\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة ..........\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t- ..........\n\n\t- ..........\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\n\tالمادة الخامسة: رأس المال:\n\nحدد رأس مال الشركة بـ (الأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (.....) حصة متساوية القيمة، وقيمة كل حصة (....) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي)\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولون شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية / ميلادية) تبدأ من تاريخ قيدها بالسجل التجاري ويجوز مدّ أجل الشركة قبل انقضائها لمدة أخرى بقرار تصدره الجمعية العامة للشركاء من أيّ عدد من الشركاء المالكين (لنصف) الحصص الممثلة لرأس المال (يجوز النص على أغلبية أكبر)،  وإذا لم يصدر قرار بمد أجل الشركة واستمرت في أداء أعمالها، امتد أجلها لمدة مماثلة بالشروط ذاتها الواردة في عقد تأسيسها.\n\nالمادة السابعة: زيادة أو تخفيض رأس المال: (مادة اختيارية)\n\n- يجوز بموافقة جميع الشركاء زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n- يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة.\n\n- للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة الثامنة: إدارة الشركة:\n\nيتولى إدارة الشركة: (يتعين اختيار أحد الخيارات التالية)\n\n      ..........  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية: ....................\n\nأو\n\n.......... و .......... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\nأو\n\n-  مجلس مديرين مكون من (لا يقل عن 3) وهم:\n\n- ..........\n\n- ..........\n\n- ..........\n\n\t-  (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لصدور القرارات)\n\n\t          وله السلطات والصلاحيات التالية: ....................\n  أو\n\nمدير أو أكثر أو مجلس مديرين يتم تعيينهم في عقد مستقل بقرار من الشركاء. (يمكن تحديد السلطات والصلاحيات والأغلبية اللازمة لصدور القرارات في عقد مستقل أو في عقد تأسيس الشركة)\n\nالمادة التاسعة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. (يمكن النص في العقد على شروط لهذا التنازل)\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء وفقاً للمادة (الثامنة والسبعون بعد المائة) من النظام. (يمكن النص في العقد على إجراءات أخرى للابلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\t المادة العاشرة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n(يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة الحادية عشرة: قرارات الشركاء:\n\n\t\t- تصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل (مدير/ مديرو) الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة (التاسعة) من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. (يجوز النص في العقد على أغلبية أكبر)\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل. (يجوز النص في العقد على أغلبية أكبر)\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك)\n\nالمادة الثانية عشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً. (يجوز أن تنص المادة على السنة ميلادية أو هجرية)\n\nالمادة الثالثة عشرة: الأرباح والخسائر:\n\n- يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال. (يجوز النص على تفاوت تقاسم الأرباح والخسائر بين الشركاء بصرف النظر عن حصة كل منهم في رأس المال. وفي حال وجود شريك بالعمل يتم النص على نسبته في الربح والخسارة)\n\n- يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط النظامية المقررة.\n\n- توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (..... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض .......... (هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\tالمادة الرابعة عشرة: انقضاء الشركة:\n\n\tتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب (الثاني عشر) من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية وفقاً لنظام الإفلاس.\n\nالمادة الخامسة عشرة: أحكام ختامية:\n\n- تخضع الشركة للأنظمة السارية في المملكة العربية السعودية.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\nالطرف الأول                                              الطرف الثاني\n\nعقد تأسيس شركة ......................\n\n(شركة ذات مسؤولية محدودة مهنية)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\n(في حال وجود شريك بالعمل من المرخص لهم بممارسة المهنة الحرة تضاف بياناته ضمن بيانات الشركاء ولا يضاف اسمه في مادة رأس المال)\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ......... ) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة مهنية)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n شركة .................... (شركة مهنية ذات مسؤولية محدودة)\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة ..........\n\nالمادة الرابعة: أغراض الشركة:\n\nممارسة مهنة .................... (يجب أن تكون أنشطة الشركة مهنية)\n\nوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة: رأس المال:\n\nحدد رأس مال الشركة بـ (الأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (.....) حصة متساوية القيمة، وقيمة كل حصة (.....) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولون شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية / ميلادية) تبدأ من تاريخ قيدها بالسجل التجاري ويجوز مدّ أجل الشركة قبل انقضائها لمدة أخرى بقرار تصدره الجمعية العامة للشركاء من أيّ عدد من الشركاء المالكين (لنصف) الحصص الممثلة لرأس المال (يجوز النص على أغلبية أكبر)،  وإذا لم يصدر قرار بمد أجل الشركة واستمرت في أداء أعمالها، امتد أجلها لمدة مماثلة بالشروط ذاتها الواردة في عقد تأسيسها.\n\nالمادة السابعة: زيادة أو تخفيض رأس المال: (مادة اختيارية)\n\n- يجوز بموافقة جميع الشركاء زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n- يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة.\n\n- للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة الثامنة: إدارة الشركة:\n\n(في حال تولى إدارة الشركة مدير واحد فيجب أن يكون من الشركاء المرخص لهم. وفي حال تولى إدارة الشركة مديرين اثنين او أكثر (مجلس مديرين)، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف)\n\n- يتولى إدارة الشركة: (يتعين اختيار أحد الخيارات التالية)\n\n..........  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية: ....................\n\n أو\n\n.......... و .......... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\nأو\n\n- مجلس مديرين مكون من (لا يقل عن 3) وهم:\n\n- ..........\n\n- ..........\n\n- ..........\n\n\t- (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لصدور القرارات)\n\n\tوله السلطات والصلاحيات التالية: ....................\n\n\tأو\n\nمدير أو أكثر أو مجلس مديرين يتم تعيينهم في عقد مستقل بقرار من الشركاء. (يمكن تحديد السلطات والصلاحيات والأغلبية اللازمة لصدور القرارات في عقد مستقل أو في عقد تأسيس الشركة)\n\n- يشترط لتعيين (مدير/ مديرو) الشركة الآتي: ...............\n\n- تتكون مكافآت (مدير/ مديرو) الشركة من ...............\n\n- تكون مدة إدارة (مدير/ مديرو) الشركة ...............\n\n- يعزل (مدير/ مديرو) الشركة بالطريقة التي عين بها. (يمكن النص في العقد على طريقة عزل أخرى)\n\nالمادة التاسعة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. (يمكن النص في العقد على شروط لهذا التنازل)\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء وفقاً للمادة (الثامنة والسبعون بعد المائة) من النظام. (يمكن النص في العقد على إجراءات أخرى للابلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة العاشرة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n(يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى يتفق عليها الشركاء)\n\n\tالمادة الحادية عشرة: قرارات الشركاء:\n\n- تصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل (مدير/ مديرو) الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة (التاسعة) من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. (يجوز النص في العقد على أغلبية أكبر)\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل. (يجوز النص في العقد على أغلبية أكبر)\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك)\n\n\tالمادة الثانية عشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً. (يجوز أن تنص المادة على السنة ميلادية أو هجرية)\n\n\tالمادة الثالثة عشرة: الأرباح والخسائر:\n\n- يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال. (يجوز النص على تفاوت تقاسم الأرباح والخسائر بين الشركاء بصرف النظر عن حصة كل منهم في رأس المال، وفي حال وجود شريك بالعمل يتم النص على نسبته في الأرباح والخسائر)\n\n- يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط النظامية المقررة.\n\n- توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t\t- تجنب نسبة (..... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض .......... (هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\t\t- في حال فقد شريك ترخيص ممارسة مهنته الحرة بصفة موقتة، سواءً كان هو الممارس الوحيد للمهنة الحرة من بين الشركاء الآخرين أو يمارس تلك المهنة بالمشاركة مع شريك آخر؛ فيتم توزيع الارباح والخسائر وفقاً لما يلي: (يجب النص على تحديد كيفية توزيع الارباح والخسائر عند وقوع اي من تلك الحالتين المشار اليهما في الفقرة، وذلك بناء على نص الفقرة (1) من المادة (الحادية عشرة بعد المائتين) من نظام الشركات)\n\nالمادة الرابعة عشرة: الترخيص المهني: (مادة اختيارية)\n\n- إذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية .......... (يتعين اختيار أحد الخيارين التالية)\n\n\t\t\t- عُد منسحباً من الشركة.\n\n\t\t\t- يستمر شريكا غير مرخص له في ممارسة المهنة في الشركة، إذا تحققت الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\nالمادة الخامسة عشرة: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب (الثاني عشر) من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية وفقاً لنظام الإفلاس.\n\nالمادة السادسة عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة السارية في المملكة العربية السعودية.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\nالطرف الأول                                              الطرف الثاني"}, {"cat": "تحويل فرع", "icon": "", "title": "تحويل فرع شركة إلى شركة محدودة شخص واحد (مهنية)", "desc": "النظام الأساس لشركة ذات مسؤولية محدودة من شخص واحد.", "text": "النظام الأساس لشركة ......................\n\n(شركة ذات مسؤولية محدودة من شخص واحد)\n\nتؤسس طبقا لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (132/م) وتاريخ 1/12/1443هـ ولائحته التنفيذية الصادرة بقرار معالي وزير التجارة رقم (284) وتاريخ 23/6/1444هــ شركة .................... (ذات مسؤولية محدودة من شخص واحد) مملوكة لـ.................... سعودي الجنسية بموجب السجل المدني رقم .......... وتاريخ ...../...../..... هـ صادر من مدينة .......... وتاريخ الميلاد ...../....../.....هـ،  ومهنته .......... ويقيم في مدينة ...........، وفقاً للشروط والأحكام التالية:\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة..............) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة من شخص واحد)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n...........................\t (شركة ذات مسؤولية محدودة من شخص واحد).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة… ....\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t 1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة : رأس المال:\n\nحدد رأس مال الشركة بـ (الأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (.....) حصة متساوية القيمة، وقيمة كل حصة (.....) ريال وفق ما يلي:\n\n| بيان | عدد الحصص | قيمة الحصة | الإجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- |\n|  |  |  |  | نقداً |\n|  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |\n\nويقر مالك رأس المال بأنه تم الوفاء بقيمتها كاملة.\n\n (في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق مالك رأس المال على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي)\n\nويقر مالك رأس المال بأنه مسؤول شخصيًّا في جميع أمواله في مواجهة الغير عن عدالة تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\nالمادة السادسة : زيادة أو تخفيض رأس المال:-\n\n- يجوز لمالك رأس المال زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية للحصص أو إصدار حصص جديدة.\n\n- لمالك رأس المال أن يقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة السابعة : إدارة الشركة :\n\nالتعيين:\n\n\tيتولى إدارة الشركة ... (يتعين اختيار احد الخيارات التالية): -\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى مالك رأس المال: (في حال كان المدير غير مالك رأس المال)\n\nتكون التبليغات التي توجهها الشركة إلى مالك رأس المال عن طريق أي من الوسائل الآتية:\n\n- إرسالها بخطابات مسجلة.\n\n- التسليم شخصيًّا أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n(يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى بموافقة مالك رأس المال)\n\nالمادة التاسعة : قرارات مالك رأس المال:\n\nيكون لمالك رأس المال الصلاحيات والسلطات المنصوص عليها في نظام الشركات، وتصدر قراراته كتابة، وتدون في سجل خاص لدى الشركة.\n\nالمادة العاشرة : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشر: الأرباح والخسائر:\n\n- يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على مالك رأس المال، وفقا للضوابط النظامية المقررة.\n\n- توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (..... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض .............. (هذا البند اختياري)\n\n\t- يحدد مالك رأس المال النسبة التي يجب توزيعها من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\tالمادة الثانية عشر: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب (الثاني عشر) من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الثالثة عشر: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nوقد تم اعتماد/توثيق هذا العقد من قبل الموظف المختص/كاتب العدل\n\nالنظام الأساس لشركة ......................\n\n(شركة ذات مسؤولية محدودة من شخص واحد مهنية)\n\nتؤسس طبقا لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (132/م) وتاريخ 1/12/1443هـ ولائحته التنفيذية الصادرة بقرار معالي وزير التجارة رقم (284) وتاريخ 23/6/1444هــ شركة .................... (ذات مسؤولية محدودة من شخص واحد مهنية) مملوكة لـ.................... سعودي الجنسية بموجب السجل المدني رقم .......... وتاريخ ...../...../..... هـ صادر من مدينة .......... وتاريخ الميلاد ...../....../.....هـ،  حاصل على الترخيص بمزاولة مهنة .......... رقم (.....) وتاريخ ...../..../.... هـ......... ويقيم في مدينة ...........، وفقاً للشروط والأحكام التالية:\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة..............) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة من شخص واحد مهنية)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n...........................\t (شركة ذات مسؤولية محدودة من شخص واحد مهنية).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة… ....\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t 1-\n\n\t2-\n\n(يجب أن تكون أنشطة الشركة مهنية)\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة : رأس المال:\n\nحدد رأس مال الشركة بـ (الأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة متساوية القيمة، وقيمة كل حصة (.........) ريال وفق ما يلي:\n\n| بيان | عدد الحصص | قيمة الحصة | الإجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- |\n|  |  |  |  | نقداً |\n|  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |\n\nويقر مالك رأس المال بأنه تم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق مالك رأس المال على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي)\n\nويقر مالك رأس المال بأنه مسؤول شخصيًّا في جميع أمواله في مواجهة الغير عن عدالة تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\nالمادة السادسة : زيادة أو تخفيض رأس المال:-\n\n- يجوز لمالك رأس المال زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية للحصص أو إصدار حصص جديدة.\n\n- لمالك رأس المال أن يقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة السابعة : إدارة الشركة :\n\n(في حال تولى إدارة الشركة مدير واحد يجب أن يكون هو المالك لرأس المال. وفي حال تولى إدارة الشركة مديرين اثنين فيجب أن يكون أحدهم مالك رأس المال)\n\n- يتولى إدارة الشركة: (يتعين اختيار أحد الخيارات التالية)\n\n\tمالك رأس المال .................\n\n وله كافة السلطات والصلاحيات اللازمة لتحقيق غرض الشركة.\n\nأو\n\n.......... و .......... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\nأو\n\nمدير أو مديرين يتم تعيينهم في عقد مستقل بقرار من مالك رأس المال، ويكون لهم السلطات والصلاحيات التالية: .................... (يجب أن يكون مالك رأس المال هو المدير أو أحد المديرين الاثنين)\n\n- يشترط لتعيين (مدير/ مديرو) الشركة الآتي: ...............\n\n- تتكون مكافآت (مدير/ مديرو) الشركة من ...............\n\n- تكون مدة إدارة (مدير/ مديرو) الشركة ...............\n\n- يعزل (مدير/ مديرو) الشركة بالطريقة التي عين بها. (يمكن النص في العقد على طريقة عزل أخرى)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى الشركاء: (في حال كان المدير غير مالك رأس المال)\n\nتكون التبليغات التي توجهها الشركة إلى مالك رأس المال عن طريق أي من الوسائل الآتية:\n\n- إرسالها بخطابات مسجلة.\n\n- التسليم شخصيًّا أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n(يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى بموافقة مالك رأس المال)\n\nالمادة التاسعة : قرارات مالك رأس المال:\n\nيكون لمالك رأس المال الصلاحيات والسلطات المنصوص عليها في نظام الشركات، وتصدر قراراته كتابة، وتدون في سجل خاص لدى الشركة.\n\nالمادة العاشرة : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشر: الأرباح والخسائر:\n\n- يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على مالك رأس المال، وفقا للضوابط النظامية المقررة.\n\n- توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (..... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض .............. (هذا البند اختياري)\n\n\t- يحدد مالك رأس المال النسبة التي يجب توزيعها من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\nالمادة الثانية عشر: الترخيص المهني: (مادة اختيارية)\n\n- إذا فقد مالك رأس المال ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص، كما يجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n- يمتنع إذا فقد مالك رأس المال ترخيص ممارسة مهنة الحرة بصفة نهائية، أو توفي، أو تنازل عن حصته؛ فيجب على الشركة التوقف عن ممارسة تلك المهنة، وتمهل مدة (ستة) أشهر لتصحيح أوضاعها بما يتفق مع أحكام النظام، ويجوز طلب تمديد هذه المدة من الجهة المختصة، وتنقضي الشركة عند انقضاء المهلة دون تصحيح أوضاعها.\n\n\tالمادة الثالثة عشر: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب (الثاني عشر) من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الرابعة عشر: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nوقد تم اعتماد/توثيق هذا العقد من قبل الموظف المختص/كاتب العدل\n\nPublic  - عام\n\nPublic  - عام\n\nPublic  - عام"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل النظام الأساس لشركة محدودة شخص واحد (مهنية)", "desc": "تغيير أي مادة من مواد النظام الأساس.", "text": "نموذج رقم (....)\n\nتعديل النظام الأساس لشركة بتغيير أي مادة من مواد النظام\n\n(شركة ذات المسؤولية المحدودة من شخص واحد مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن المالك المذكور اعلاه لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...) والمثبت نظام الاساس لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر نظام اساس مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل نظام الاساس بناء على رغبة المالك لهذه الشركة (ووفقاً على الملحق المرفق لهذا العقد) ونظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة   ............  (شركة ذات المسؤولية المحدودة من شخص واحد مهنية)\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة…\n\nالمادة الثالثة: أغراض الشركة:\n\nأن الأغراض التي كونت الشركة لأجلها هي:\n\nممارسة مهنة ................................ (ملاحظة: يجب ان تكون انشطة الشركة مهنية)\n\nوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال وفق ما يلي:\n\n| بيان | عدد الحصص  | عدد الحصص  | قيمة الحصة | قيمة الحصص | طريقة الوفاء بها |\n| --- | --- | --- | --- | --- | --- |\n|  |  |  |  |  | نقداً |\n|  |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر مالك رأس المال بأنه تم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق مالك رأس المال على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nويقر مالك رأس المال بأنه مسؤول شخصيًّا في جميع أمواله في مواجهة الغير عن عدالة تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة الخامسة: زيادة أو تخفيض رأس المال:\n\n1. يجوز لمالك رأس المال زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية للحصص أو إصدار حصص جديدة.\n\n2. لمالك رأس المال أن يقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة السادسة: إدارة الشركة :\n\n(في حال تولى إدارة الشركة مدير واحد يجب أن يكون هو المالك لرأس المال. وفي حال تولى إدارة الشركة مديرين اثنين فيجب أن يكون أحدهم مالك رأس المال)\n\n- يتولى إدارة الشركة: (يتعين اختيار أحد الخيارات التالية)\n\n\tمالك رأس المال .................\n\n وله كافة السلطات والصلاحيات اللازمة لتحقيق غرض الشركة.\n\nأو\n\n.......... و .......... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\nأو\n\nمدير أو مديرين يتم تعيينهم في عقد مستقل بقرار من مالك رأس المال، ويكون لهم السلطات والصلاحيات التالية: .................... (يجب أن يكون مالك رأس المال هو المدير أو أحد المديرين الاثنين)\n\n- يشترط لتعيين (مدير/ مديرو) الشركة الآتي: ...............\n\n- تتكون مكافآت (مدير/ مديرو) الشركة من ...............\n\n- تكون مدة إدارة (مدير/ مديرو) الشركة ...............\n\n- يعزل (مدير/ مديرو) الشركة بالطريقة التي عين بها. (يمكن النص في العقد على طريقة عزل أخرى)\n\n\tالمادة السابعة: التبليغات التي توجهها الشركة إلى مالك رأس المال: (في حال كان المدير من غير ملك رأس المال)\n\nتكون التبليغات التي توجهها الشركة إلى مالك رأس المال عن طريق أي من الوسائل الآتية:\n\n- إرسالها بخطابات مسجلة.\n\n- التسليم شخصيًّا أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى بموافقة مالك رأس المال)\n\nالمادة الثامنة: صلاحيات مالك رأس المال:\n\nيكون لمالك رأس المال الصلاحيات والسلطات المنصوص عليها في نظام الشركات، وتصدر قراراته كتابة، وتدون في سجل خاص لدى الشركة.\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (ميلادية أو هجرية).\n\nالمادة العاشرة: الأرباح والخسائر:\n\n1. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على مالك رأس المال، وفقا للضوابط النظامية المقررة.\n\n2. توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (....%) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- يحدد مالك رأس المال النسبة التي يجب توزيعها من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\nالمادة الحادية عشرة: انقضاء الشركة :\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة الثالثة والأربعون بعد المائتين من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الثانية عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة السارية في المملكة العربية السعودية.\n\n- أي نص يخالف أحكام نظام الشركات في هذا النظام الأساس لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولوائحه التنفيذية.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬‬‬\n\n\t\tوالله ولي التوفيق،،\n\nالاسم:..........\n\nمالك رأس المال\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالاسم: ..........\n\nمالك رأس المال\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار مالك رأس المال، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة تضامن مهنية", "desc": "تغيير أي مادة من مواد عقد التأسيس.", "text": "نموذج رقم(...)\n\nتعديل عقد تأسيس بتغيير أي مادة من مواد عقد التأسيس لشركة .................\n\n(شركة تضامن مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (... ) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (... ) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) و قد تقرر تعديل عقد الـتأسيس بناء على موافقات الأطراف المالكين لأغلبية الحصص اللازمة لتعديل عقد التأسيس (ووفقاً للملحق المرفق لهذا العقد) و نظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة: ............. (شركة تضامن مهنية).\n\nالمادة الثانية: أغراض الشركة:\n\n إن الأنشطة التي أسست الشركة لأجلها هي:\n\nممارسة مهنة (...)\n\n(ملحوظة: يجب أن يكون نشاط الشركة مهنيًّا)\n\nتخضع الشركة في ممارسة المهنة أو المهنة الحرة محل نشاطها لإشراف الجهة أو الجهات المعنية نظاماً بالإشراف على ممارسة تلك المهن. وتلتزم الشركة بالتقيد بأحكام الأنظمة واللوائح التي الجهة والجهات المعنية وفق اختصاصها. وتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الثالثة: المركز الرئيسي:\n\nيكون المركز الرئيسي للشركة في مدينة (...) بالمملكة العربية السعودية، ويجوز نقل المركز إلى أي مدينة أخرى بالمملكة بعد موافقة الشركاء والجهات المعنية بالإشراف على المهنة الحرة محل نشاط الشركة (إن وجدت).\n\nالمادة الرابعة: مدة الشركة: (الاختيار من أحد الخيارات)\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز بموافقة جميع الشركاء تمديد مدتها.\n\nالمادة الخامسة: إدارة الشركة:\n\n- تعيين (المدير/ المديرين):\n\n(في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nملحوظة: إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. ويجب ألا تتضمن الصلاحيات أو السلطات الممنوحة للإدارة ما يخل باستقلالية الشركاء في ممارستهم لمهنهم الحرة. بالإضافة إلى عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n- عزل (المدير / المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء الآخرين.  (وإذا كان معين/ كانوا معينين في عقد مستقل) جاز عزله/ عزلهم بقرار يصدر من الأغلبية العددية للشركاء. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل.)\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو في عقد مستقل طالما كانوا من غير الشركاء).\n\n(ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدير/ المديرين حل الشركة.\n\n- مدة تولي الإدارة وتحديد مكافأة (المدير /المديرين):\n\nملحوظة: يُحدد في هذه الفقرة مدة تولي الإدارة، والمكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد الآلية لكونها عرضة للتغيير. (جوازيه)\n\n- اعتزال المدير: (اختياري في حال كان التعيين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السادسة: رأس المال:\n\nحدد رأسمال الشركة بـ ............. (ريال سعودي) يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n\n1-  الشريك الأول، السيد / ...........وحصته قدرها (كتابة) (رقما) ريال سعودي..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)(....ريال/ نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال/)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الشريك الثاني، السيد / ...........وحصته قدرها (كتابة) (رقما)  ريال سعودي/..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال/ نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال).\n\nملاحظة: الجدول أدناه وضع لأجل التوضيح: حدد رأس مال الشركة بمبلغ مقداره (...) فقط، مقسم إلى (...) حصة نقدية متساوية القيمة، قيمة كل حصة (...) ريال ، موزعة على الشركاء على النحو الآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة السابعة: قرارات الشركاء:\n\nتصدر قرارات الشركاء بالأغلبية العددية، إلا إذا كان القرار متعلقا بتعديل عقد تأسيس الشركة، فيجب أن يصدر بإجماعهم.\n\nالمادة الثامنة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة التاسعة: توزيع الأرباح والخسائر:\n\n- يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة. (ملاحظة: يجوز النص على تفاوت نسبة الأرباح والخسائر بين الشركاء، وفي حال وجود شريك بالعمل مرخص له يُنص على نسبته في الأرباح في عقد التأسيس، وذلك وفقاً للنص الواردة في الملحوظة أدناه)\n\n- في حال فقد الشريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي:\n\nملحوظة: إضافة نص حر يترك كيفية توزيع الأرباح والخسائر المشار إليه في الفقرة (2) بين الشركاء، وذلك عند وقوع الحالة المشار إليها.\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\n- اتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة العاشرة: التنازل عن الحصص أو انسحاب الشريك أو إخراجه:\n\n- لا يجوز للشريك أن يتنازل عن حصته إلا (بموافقة جميع الشركاء / بمراعاة شروط هذا العقد وهي:...) وطبقًا للأحكام المقررة نظامًا.\n\nملحوظة: الحكم الوارد باللون الأحمر اختياري، يترك للشركاء حرية تقرير أي منهما أو بهما معاً وإيراد شروط أخرى في العقد. وفي حال وضع شروط في العقد، يترك مساحة نص حر للشركاء لإضافة قيودًا أخرى تتعلق بالتنازل.\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز النص على قيود محددة للانسحاب)\n\n- للأغلبية العددية للشركاء التقدم بطلب إلى الجهة القضائية المختصة لإخراج شريك أو أكثر من الشركة إذا كانت هناك أسباب مشروعة تدعو إلى ذلك، وتظل الشركة قائمة بين باقي الشركاء. (ملحوظة: يجوز استبدال هذا النص وذلك بإيراد إجراءات أخرى لإخراج الشريك).\n\n- يجب على الشريك المنسحب من الشركة أو باقي الشركاء في حال إخراج شريك قيد وشهر ذلك لدى السجل التجاري، ولا يسري الانسحاب أو الإخراج في مواجهة الغير إلا بعد القيد والشهر.\n\nالمادة الحادية عشرة: الترخيص المهني:\n\nإذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة، وجب عليه أن يمتنع عن العمل في الشركة – بشكل فوري وكامل – إلى حين استعادته الترخيص.\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعين بعد المائتين) من نظام الشركات.\n\n- لا يجوز للشركاء حل الشركة قبل مضي الأجل المحدد لها، إلا بعد الإعلان عن ذلك وإبلاغ جميع المتعاملين معها كتابة بحسب الإجراءات المحددة نظاماً، مع مراعاة الشروط والضوابط التي تحددها الجهة أو الجهات المشرفة على المهن الحرة محل نشاط الشركة.\n\n- إذا توفي أحد الشركاء في الشركة... (ملحوظة: يجب الاختيار أحد النصين)\n\n- النص الأول في حال عدم دخول الورثة: \" تستمر الشركة بين باقي الشركاء، وتقدر قيمة حصة الشريك المتوفى من مقيم معتمد أو أكثر يعد تقريرًا يبين فيه القيمة العادلة لنصيب كل شريك في أموال الشركة في تاريخ وفاة الشريك. ولا يكون للورثة نصيب فيما يستجد بعد ذلك إلا بقدر ما تكون هذه الحقوق ناتجة عن عمليات سابقة على وفاة مورثهم\".\n\n- النص الثاني في حال دخول الورثة في حصة مورثهم: \"تستمر الشركة بين باقي الشركاء، ويحل ورثة الشريك المتوفى محل مورثهم شركاء في الشركة من خلال تحويلها إلى شركة....\" (يضاف شكل الشركة، بحيث تكون إما شركة توصية بسيطة أو شركة مساهمة أو شركة مساهمة مبسطة شركة ذات مسؤولية محدودة). تضاف عبارة (ويكون للورثة – في حال تحويل الشركة إلى شركة توصية بسيطة - صفة الشريك الموصي\".\n\n\t- إذا لم يتبق في الشركة عند وفاة أي من الشركاء، أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه، أو إخراجه، غير شريك واحد، فيمنح هذا الشريك مهلة (تسعين) يومًا لتصحيح وضع الشركة سواء بإدخال شريك آخر أو تحويلها إلى شكل آخر من أشكال الشركات الواردة في النظام، وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المهلة. (ملحوظة: يجوز للشركاء تحديد ما يترتب على الحجر على الشريك أو إعساره أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه أو إخراجه، كأن يتم الاتفاق على عدم انقضاء الشركة واستمرارها مع باقي الشركاء، شريطة عدم بقاء شريك واحد في الشركة وإلا يسري النص أعلاه).\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.‬‬‬‬‬‬‬\n\nالرابعة عشرة: نسخ العقد:\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\n\t\tوالله ولي التوفيق،،\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة توصية بسيطة مهنية", "desc": "تغيير أي مادة من مواد عقد التأسيس.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بتغيير أي مادة من مواد عقد التأسيس لشركة ................\n\n(توصية بسيطة مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...)وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل عقد التأسيس بناء على موافقات الأطراف المالكين لأغلبية الحصص اللازمة لتعديل عقد التأسيس (ووفقاً للملحق المرفق لهذا العقد) ونظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة: ...........(شركة توصية بسيطة مهنية).\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيسي للشركة في مدينة (...) بالمملكة العربية السعودية، ويجوز نقل المركز إلى أي مدينة أخرى بالمملكة بعد موافقة الشركاء والجهات المعنية بالإشراف على المهنة الحرة محل نشاط الشركة (إن وجدت).\n\nالمادة الثالثة: أنشطة الشركة:\n\nإن الأنشطة التي أسست الشركة لأجلها هي:\n\nممارسة مهنة (...)\n\n(ملحوظة: يجب أن يكون نشاط الشركة مهنيًّا)\n\nتخضع الشركة في ممارسة المهنة أو المهنة الحرة محل نشاطها لإشراف الجهة أو الجهات المعنية نظاماً بالإشراف على ممارسة تلك المهن. وتلتزم الشركة بالتقيد بأحكام الأنظمة واللوائح التي الجهة والجهات المعنية وفق اختصاصها. وتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: مدة الشركة:(الاختيار من أحد الخيارات)\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز بموافقة جميع الشركاء تمديد مدتها.\n\nالمادة الخامسة: الإدارة:\n\n- تعيين (المدير/ المديرين):\n\n(في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء المتضامنين في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nملحوظة: إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. ويجب ألا تتضمن الصلاحيات أو السلطات الممنوحة للإدارة ما يخل باستقلالية الشركاء في ممارستهم لمهنهم الحرة. بالإضافة إلى عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n- عزل (المدير/ المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المتضامنين المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء المتضامنين الآخرين.  (وإذا كان معين/ كانوا معينين في عقد مستقل) جاز عزله/ عزلهم بقرار يصدر من الأغلبية العددية للشركاء المتضامنين. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل.)\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء المتضامنين (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو في عقد مستقل طالما كانوا من غير الشركاء).\n\n(ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدير/ المديرين حل الشركة.\n\n- مدة تولي الإدارة وتحديد مكافأة (المدير /المديرين):\n\nملحوظة: يُحدد في هذه الفقرة مدة تولي الإدارة، والمكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد الآلية لكونها عرضة للتغيير. (جوازيه)\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء المتضامنين الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السادسة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. ( ريال سعودي ) يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n\n1-  الشريك الأول، السيد / ...........وحصته قدرها (كتابة) (رقما) ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)(....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الشريك الثاني، السيد / ...........وحصته قدرها (كتابة) (رقما)  ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال).\n\nملاحظة: الجدول أدناه وضع لأجل التوضيح: حدد رأسمال الشركة بمبلغ مقداره (...) فقط، مقسم إلى (...) حصة نقدية متساوية القيمة، قيمة كل حصة (...) ريال، موزعة على الشركاء على النحو الآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة السابعة: ‌قرارات الشركاء:\n\n- تصدر قرارات الشركاء بالأغلبية العددية لآراء الشركاء المتضامنين، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين.\n\n- يكون للشركة جمعية عامة تكون اختصاصاها وإجراءات انعقادها على النحو الآتي: (ملاحظة: النص يعد اختياري، وفي حال إضافته؛ فإنه يتعين على الشركاء إيراد اختصاصات الجمعية وإجراءات انعقادها أي نصاب الانعقاد وصحة صدور القرارات).\n\n- لا يجوز للشريك الموصي طلب حل الشركة أو الاشتراك في التصويت على المسائل الخاصة بتعيين أو عزل مديرها.\n\nالمادة الثامنة: توزيع لأرباح والخسائر:\n\n- يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر بين الشركاء المتضامنين، وفي حال وجود شريك بالعمل فيجب أن يكون متضامن مرخص له، ويضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\n- في حال فقد الشريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي:\n\nملحوظة: إضافة نص حر يترك كيفية توزيع الأرباح والخسائر المشار إليه في الفقرة (2) بين الشركاء، وذلك عند وقوع الحالة المشار إليها.\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا من المرهص له، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\n- اتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة العاشرة: التنازل عن الحصص أو انسحاب الشريك أو اخراج أو إدخال شركاء:\n\n\t- التنازل عن الحصص:\n\n\t- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه لأي من الشركاء الآخرين في الشركة.\n\n- يجوز للشريك المتضامن أن يتنازل عن كل أو بعض حصصه لمصلحة شريك موصٍ أو للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين.  (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- ادخال شركاء في الشركة:\n\nيجوز اداخل شركاء متضامنين أو موصين إلى الشركة، بعد موافقة جميع الشركاء المتضامين دون الحاجة إلى الحصول على موافقة الشركاء الموصين. ( ملاحظة: النص المضلل يمكن أن يتم الاتفاق على خلافه في العقد بحيث يتم الاتفاق على نصاب آخر أو على شرط الحصول على موافقة الموصين،).\n\n- انسحاب الشريك أو إخراجه:\n\nيخضع الشركاء المتضامنين في الشركة للأحكام المطبقة على الشركاء في شركة التضامن، وذلك في حال وفاته أو بالحجر عليه أو بإعساره، أو بافتتاح أي من إجراءات التصفية تجاهه في شركة التضامن، أو بانسحابه أو إخراجه وتقدير نصيبه في أموال الشركة.\n\nالمادة الحادية عشرة: الترخيص المهني:\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، (اختيار أحد الخيارين التالية):\n\n\t- عُد منسحباً من الشركة.\n\n\t- يستمر بصفته شريك موصي غير مرخص له بممارسة المهنة في الشركة مع مراعاة الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من النظام.\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- لا يجوز للشركاء حل الشركة قبل مضي الأجل المحدد لها إلا بعد الإعلان عن ذلك وإبلاغ جميع المتعاملين معها كتابة بحسب الإجراءات بحسب الإجراءات المحددة نظاماً، مع مراعاة الشروط والضوابط التي تحددها الجهة أو الجهات المشرفة على المهن الحرة محل نشاط الشركة.\n\n- إذا توفي أحد الشركاء في الشركة... (ملحوظة: يجب الاختيار أحد النصين)\n\n- النص الأول في حال عدم دخول الورثة: \" تستمر الشركة بين باقي الشركاء، وتقدر قيمة حصة الشريك المتوفى من مقيم معتمد أو أكثر يعد تقريرًا يبين فيه القيمة العادلة لنصيب كل شريك في أموال الشركة في تاريخ وفاة الشريك. ولا يكون للورثة نصيب فيما يستجد بعد ذلك إلا بقدر ما تكون هذه الحقوق ناتجة عن عمليات سابقة على وفاة مورثهم\".\n\n- النص الثاني في حال دخول الورثة في حصة مورثهم: \" تؤول حصته إلى ورثته، ويكون للورثة في حال مشاركته صفة الشريك الموصي. ويجوز أن يكون الوريث شريكاً ممارساً لمهنته عن طريق الشركة؛ شريطة تحقق الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) والشروط المنصوص عليها في المادة (الثالثة عشرة بعد المائتين) من نظام الشركات.\n\n- يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية وفقاً لنظام الإفلاس:\n\n (ملحوظة: يجوز للشركاء تحديد ما يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه أو إخراجه، كأن يتم الاتفاق على انقضاءها أو عدم انقضاء الشركة واستمرارها مع باقي الشركاء، شريطة بقاء شريك متضامن مرخص له في المهنة الحرة محل نشاط الشركة، أي لا يمكن إضافة هذا النص ما لم يكن هنالك أكثر من شريك متضامن مرخص له.)\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬\n\nالرابعة عشرة: نسخ العقد:\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة تضامن", "desc": "تغيير أي مادة من مواد عقد التأسيس.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بتغيير أي مادة من مواد عقد التأسيس لشركة\n\n(شركة تضامن)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشاة (...)وتاريخ (... ) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (... ) و قد تقرر تعديل عقد الـتأسيس بناء على موافقات الأطراف المالكين لأغلبية الحصص اللازمة لتعديل عقد التأسيس (ووفقاً للملحق المرفق لهذا العقد) و نظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى : اسم الشركة :\nاسم الشركة........................................................ ) شركة تضامن (\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة…\n\n\tالمادة الثالثة : أغراض الشركة :\n1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. (ريال سعودي (يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n1-  الطرف الأول/ ...........وحصته قدرها ( كتابة ) ( رقما )  ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال) ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الطرف الثاني/ ...........وحصته قدرها (كتابة) ( رقما )  ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n(ملاحظة الجدول أدناه يعد خيار آخر وقد تم إيراده بهدف الايضاح)\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيتعين الاختيار بين الآتي:\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم،والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة الخامسة : مدة الشركة\n\n( ملاحظة اختيار أحد الخيارين التالية).\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السادسة الإدارة :\n\n(ملاحظة:الأصل أن يكون المدير من الشركاء المتضامنين، ويجوز أن يكون من الغير باتفاق الشركاء مع مراعاة الحالة التي يكون فيها المدير شريك متضامن ذو شخصية اعتبارية فيذكر اسم الشخصية الاعتبارية كمدير واسم ممثله الشخص الطبيعي).\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص علىالتالي):\n1. تعيين (المدير/ المديرين):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على الآتي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nيباشر (المدير/ المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة، وله الصلاحيات الآتية: ......\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. بالإضافة أهمية عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n-  عزل (المدير/المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء الآخرين. (وإذا كان المدير/ كانوا المديرين معينين في عقد مستقل)، جاز عزله/عزلهم بقرار يصدر من الأغلبية العددية للشركاء. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل).\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء. (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو بعقد مستقل طالما كانوا من غير الشركاء).\n\n (ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n(اختيار أحد الخيارين):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدين/ المديرين حل الشركة.\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السابعة: ‌قرارات الشركاء والنصاب اللازم لصدورها:\n\nتصدر قرارات الشركاء بالأغلبية العددية لآرائهم، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء.\n\nالمادة الثامنة: توزيع الأرباح والخسائر:\n\n يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر، وفي حال وجود شريك بالعمل فيضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\nاتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة العاشرة: الشروط اللازمة لتنازل أو انسحاب أو إخراج شريك:\n\nلا يجوز لأي من الشركاء التنازل عن كل أو بعض حصصه إلا بموافقة باقي الشركاء (يجوز النص على قيود محددة للتنازل)، ويجب قيد وشهر هذا التنازل لدى السجل التجاري.\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز النص على خلاف ذلك وبالتالي هذه الفقرة اختيارية)\n\n-  (يجوز النص على إجراءات أخرى لإخراج الشريك).\n\n- يجب على الشريك المنسحب من الشركة أو باقي الشركاء في حال إخراج شريك، قيد وشهر ذلك لدى السجل التجاري، ولا يسري الانسحاب أو الإخراج في مواجهة الغير إلا بعد القيد والشهر.\n\nالمادة الحادية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق الحالات المذكورة).\n\n- في حالة وفاة أي من الشركاء (يتعين اختيار أحد الخيارين التالية في العقد):\n\n\t\t- الأول: تستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة. ويجب في هذه الحالة تحويل الشركة خلال مدة لا تتجاوز (سنة) من تاريخ وفاة مورثهم إلى شركة توصية بسيطة يصبح فيها القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا؛ وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المدة، ما لم يبلغ القاصر- خلال هذه المدة- سن الرشد أو ينتفِ سبب المنع عن مزاولة الأعمال التجارية ويرغب ذلك القاصر أو الممنوع من مزاولة الأعمال التجارية في أن يكون شريكًا متضامنًا.\n\n\t\t- الثاني: تستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفي إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة بوفاة أي من الشركاء\".\n\n- إذا لم يتبق في الشركة عند وفاة أي من الشركاء، أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه، أو إخراجه، غير شريك واحد، فيمنح هذا الشريك مهلة (تسعين) يومًا لتصحيح وضع الشركة سواء بإدخال شريك آخر أو تحويلها إلى شكل آخر من أشكال الشركات الواردة في النظام، وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المهلة.\n\nالمادة الثانية عشرة: أحكام ختامية:\n\n1-تخضع الشركة لكافة الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n2-لا يعتد بأي نص خاص وارد في هذه العقد يخالف أحكام نظام الشركات ولائحته التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولائحته التنفيذية وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n3-  تعهد: يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nالمادة الثالثة عشرة: نسخ العقد\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\nوالله ولي التوفيق\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nــــــــــــــــ\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة ذات مسؤولية محدودة مهنية", "desc": "تغيير أي مادة من مواد عقد التأسيس.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بتغيير أي مادة من مواد عقد التأسيس لشركة\n\n(شركة ذات مسؤولية محدودة مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...)وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل عقد التأسيس بناء على موافقات الأطراف المالكين لأغلبية الحصص اللازمة لتعديل عقد التأسيس (ووفقاً للملحق المرفق لهذا العقد) ونظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\n شركة ...............(شركة ذات مسؤولية محدودة مهنية)\n\nالمادة الثانية: المركز الرئيس للشركة:\nيكون المركز الرئيس للشركة في مدينة..........\n\nالمادة الثالثة: أغراض الشركة:\n\nأن الأغراض التي كونت الشركة لأجلها هي:\n\nممارسة مهنة ................................ (ملاحظة: يجب أن تكون انشطة الشركة مهنية)\n\nوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الاجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولين شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة الخامسة: زيادة أو تخفيض رأس المال:\n\nيجوز بموافقة جميع الشركاء زيادة رأس مالها عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n2. يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة.\n\n3. للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً لأحكام النظامية المقررة.\n\nالمادة السادسة: إدارة الشركة:\n\nالتعيين:\n\n ( ملاحظة: في حال تولى إدارة الشركة مدير واحد فيجب أن يكون من الشركاء المرخص لهم. أما في حال تولاها مديرين اثنين او أكثر (مجلس مديرين)، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف).\n\n\tيتولى إدارة الشركة: (يتعين اختيار احد الخيارات التالية):-\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم:\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\t- يعينهم ................\n\nالمادة السابعة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. ( يمكن النص في العقد على شروط لهذا التنازل).\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء وفقاً للمادة (الثامنة والسبعون بعد المائة) من نظام الشركات (يمكن النص في العقد على إجراءات أخرى للابلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز تضمين المادة أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة التاسعة: قرارات الشركاء:\n\nتصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير/ مديرو الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة العاشرة من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل، ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك).\n\nالمادة العاشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص العقد على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشرة: الأرباح والخسائر:\n\n1. يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال (يجوز النص على تفاوت تقاسم الأرباح والخسائر وفي حال وجود شريك بالعمل يمكن النص على نسبته في الأرباح)\n\n2. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط النظامية المقررة.\n\n3. توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (.... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\t- في حال فقد شريك ترخيص ممارسة مهنته الحرة بصفة موقتة، سواءً كان هو الممارس الوحيد للمهنة الحرة من بين الشركاء الآخرين أو يمارس تلك المهنة بالمشاركة مع شريك آخر؛ فيتم توزيع الارباح والخسائر وفقاً لما يلي: ...........(ملاحظة: يجب النص على تحديد كيفية توزيع الارباح والخسائر عند وقوع اي من تلك الحالتين المشار اليهما في الفقرة، وذلك بناء على نص الفقرة (1) من المادة (211) من نظام الشركات المهنية).\n\nالمادة الثانية عشرة: الترخيص المهني:\n\nإذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، ...... ( يتعين اختيار أحد الخيارين التالية) :\n\n\t\t\t- عُد منسحباً من الشركة.\n\n\t\t\t- يستمر شريكا غير مرخص له في ممارسة المهنة في الشركة، إذا تحققت الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\nالمادة الثالثة عشرة: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الرابعة عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة السارية في المملكة العربية السعودية.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولوائحه التنفيذية.\n\n\t-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة تضامن بناءً على حكم قضائي", "desc": "تعديل العقد تنفيذاً لحكم قضائي.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بناء على حكم قضائي شركة ......................\n\n(شركة تضامن)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل عقد التأسيس بناء على الحكم القضائي الصادر من (...) برقم (...) وتاريخ (...) وذلك بـ (منطوق الحكم).\n\n وذلك وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى : اسم الشركة :\nاسم الشركة........................................................ ) شركة التضامن (\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة…\n\n\tالمادة الثالثة : أغراض الشركة :\n1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. (ريال سعودي (يحدد كتابة ورقماً موزع على الشركاءكالتالي:\n1-  الطرف الأول/ ...........وحصته قدرها ( كتابة ) ( رقما )  ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال) ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الطرف الثاني/ ...........وحصته قدرها (كتابة) ( رقما )  ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n(ملاحظة الجدول أدناه يعد خيار آخر وقد تم إيراده بهدف الايضاح)\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيتعين الاختيار بين الآتي:\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة .\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة الخامسة : مدة الشركة  (مادة ملزمة)\n\n( ملاحظة اختيار أحد الخيارين التالية).\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السادسة الإدارة :\n\n(ملاحظة:الأصل أن يكون المدير من الشركاء المتضامنين، ويجوز أن يكون من الغير باتفاق الشركاء مع مراعاة الحالة التي يكون فيها المدير شريك متضامن ذو شخصية اعتبارية فيذكر اسم الشخصية الاعتبارية كمدير واسم ممثله الشخص الطبيعي).\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص علىالتالي):\n1. تعيين (المدير/ المديرين):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على الآتي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nيباشر (المدير/ المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة، وله الصلاحيات الآتية: ......\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. بالإضافة أهمية عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n-  عزل (المدير/المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء الآخرين. (وإذا كان المدير/ كانوا المديرين معينين في عقد مستقل)، جاز عزله/عزلهم بقرار يصدر من الأغلبية العددية للشركاء. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل).\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء. (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو بعقد مستقل طالما كانوا من غير الشركاء).\n\n (ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n(اختيار أحد الخيارين):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدين/ المديرين حل الشركة.\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السابعة: ‌قرارات الشركاء والنصاب اللازم لصدورها:\n\nتصدر قرارات الشركاء بالأغلبية العددية لآرائهم، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء.\n\nالمادة الثامنة: توزيع الأرباح والخسائر:\n\n يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر، وفي حال وجود شريك بالعمل فيضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\nاتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة العاشرة: الشروط اللازمة لتنازل أو انسحاب أو إخراج شريك:\n\nلا يجوز لأي من الشركاء التنازل عن كل أو بعض حصصه إلا بموافقة باقي الشركاء (يجوز النص على قيود محددة للتنازل)، ويجب قيد وشهر هذا التنازل لدى السجل التجاري.\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز النص على خلاف ذلك وبالتالي هذه الفقرة اختيارية)\n\n-  (يجوز النص على إجراءات أخرى لإخراج الشريك).\n\n- يجب على الشريك المنسحب من الشركة أو باقي الشركاء في حال إخراج شريك، قيد وشهر ذلك لدى السجل التجاري، ولا يسري الانسحاب أو الإخراج في مواجهة الغير إلا بعد القيد والشهر.\n\nالمادة الحادية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق الحالات المذكورة).\n\n- في حالة وفاة أي من الشركاء (يتعين اختيار أحد الخيارين التالية في العقد):\n\n\t\t- الأول: تستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة. ويجب في هذه الحالة تحويل الشركة خلال مدة لا تتجاوز (سنة) من تاريخ وفاة مورثهم إلى شركة توصية بسيطة يصبح فيها القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا؛ وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المدة، ما لم يبلغ القاصر- خلال هذه المدة- سن الرشد أو ينتفِ سبب المنع عن مزاولة الأعمال التجارية ويرغب ذلك القاصر أو الممنوع من مزاولة الأعمال التجارية في أن يكون شريكًا متضامنًا.\n\n\t\t- الثاني: تستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفي إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة بوفاة أي من الشركاء\".\n\n- إذا لم يتبق في الشركة عند وفاة أي من الشركاء، أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه، أو إخراجه، غير شريك واحد، فيمنح هذا الشريك مهلة (تسعين) يومًا لتصحيح وضع الشركة سواء بإدخال شريك آخر أو تحويلها إلى شكل آخر من أشكال الشركات الواردة في النظام، وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المهلة.\n\nالمادة الثانية عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذه العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬\n\nالمادة الثالثة عشرة: نسخ العقد\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\nوالله ولي التوفيق\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nــــــــــــــــ\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "صك حصر ورثة", "icon": "", "title": "تعديل عقد شركة ذات مسؤولية محدودة مهنية بناءً على صك حصر ورثة", "desc": "دخول الورثة في الشركة بعد وفاة شريك.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بناء صك ورثة شركة ......................\n\n(شركة ذات مسؤولية محدودة مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...)والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) (...) تاريخ (...) ونظراً لوفاة الشريك(...) وبناء على صك حصر الورثة رقم (...) وتاريخ (...) فقد تقرر تعديل عقد تأسيس الشركة  (بناء على الملحق المرفق لهذا العقد) وفقاً ً لنظام الشركات الصادر وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\n شركة ...............(شركة ذات مسؤولية محدودة مهنية)\n\nالمادة الثانية: المركز الرئيس للشركة:\nيكون المركز الرئيس للشركة في مدينة..........\n\nالمادة الثالثة: أغراض الشركة:\n\nأن الأغراض التي كونت الشركة لأجلها هي:\n\nممارسة مهنة ................................ (ملاحظة: يجب أن تكون انشطة الشركة مهنية)\n\nوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الاجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولين شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة الخامسة: زيادة أو تخفيض رأس المال:\n\nيجوز بموافقة جميع الشركاء زيادة رأس مالها عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n2. يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة.\n\n3. للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً لأحكام النظامية المقررة.\n\nالمادة السادسة: إدارة الشركة:\n\nالتعيين:\n\n ( ملاحظة: في حال تولى إدارة الشركة مدير واحد فيجب أن يكون من الشركاء المرخص لهم. أما في حال تولاها مديرين اثنين او أكثر (مجلس مديرين)، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف).\n\n\tيتولى إدارة الشركة: (يتعين اختيار احد الخيارات التالية):-\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم:\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\t- يعينهم ................ (الاختيار الشركاء/ احد الشركاء)\n\nالمادة السابعة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. ( يمكن النص في العقد على شروط لهذا التنازل).\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء وفقاً للمادة (الثامنة والسبعون بعد المائة) من نظام الشركات (يمكن النص في العقد على إجراءات أخرى للابلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز تضمين المادة أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة التاسعة: قرارات الشركاء:\n\nتصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير/ مديرو الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة العاشرة من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل، ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك).\n\nالمادة العاشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص العقد على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشرة: الأرباح والخسائر:\n\n1. يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال (يجوز النص على تفاوت تقاسم الأرباح والخسائر وفي حال وجود شريك بالعمل يمكن النص على نسبته في الأرباح)\n\n2. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط النظامية المقررة.\n\n3. توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (.... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\t- في حال فقد شريك ترخيص ممارسة مهنته الحرة بصفة موقتة، سواءً كان هو الممارس الوحيد للمهنة الحرة من بين الشركاء الآخرين أو يمارس تلك المهنة بالمشاركة مع شريك آخر؛ فيتم توزيع الارباح والخسائر وفقاً لما يلي: ...........(ملاحظة: يجب النص على تحديد كيفية توزيع الارباح والخسائر عند وقوع اي من تلك الحالتين المشار اليهما في الفقرة، وذلك بناء على نص الفقرة (1) من المادة (211) من نظام الشركات المهنية).\n\nالمادة الثانية عشرة: الترخيص المهني:\n\nإذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، ...... ( يتعين اختيار أحد الخيارين التالية) :\n\n\t\t\t- عُد منسحباً من الشركة.\n\n\t\t\t- يستمر شريكا غير مرخص له في ممارسة المهنة في الشركة، إذا تحققت الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\nالمادة الثالثة عشرة: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الرابعة عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة السارية في المملكة العربية السعودية.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولوائحه التنفيذية.\n\n\t-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "صك حصر ورثة", "icon": "", "title": "تعديل عقد شركة التضامن بناءً على صك حصر ورثة", "desc": "دخول الورثة في الشركة بعد وفاة شريك.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بناء صك ورثة شركة ......................\n\n(شركة تضامن)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...)والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) (...) تاريخ (...) ونظراً لوفاة الشريك(...) وبناء على صك حصر الورثة رقم (...) وتاريخ (...) فقد تقرر تعديل عقد تأسيس الشركة  (وفقا للملحق المرفق لهذا العقد) وفقاً ً لنظام الشركات الصادر وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nو أصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى : اسم الشركة :\nاسم الشركة.......................................................) شركة التضامن (\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة........\n\n\tالمادة الثالثة : أغراض الشركة :\n1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. ( ريال سعودي ) يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n1-  الطرف الأول/ ...........وحصته قدرها ( كتابة ) ( رقما )  ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال) ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الطرف الثاني/ ...........وحصته قدرها (كتابة) (رقما) ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n(ملاحظة الجدول أدناه يعد خيار آخر وقد تم إيراده بهدف الايضاح)\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيتعين الاختيار بين الآتي:\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة الخامسة : مدة الشركة  (مادة ملزمة)\n\n( ملاحظة اختيار أحد الخيارين التالية).\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السادسة الإدارة :\n\n(ملاحظة:الأصل أن يكون المدير من الشركاء المتضامنين، ويجوز أن يكون من الغير باتفاق الشركاء مع مراعاة الحالة التي يكون فيها المدير شريك متضامن ذو شخصية اعتبارية فيذكر اسم الشخصية الاعتبارية كمدير واسم ممثله الشخص الطبيعي).\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص على التالي):\n1. تعيين (المدير/ المديرين):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(ملاحظة: في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على الآتي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nيباشر (المدير/ المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة، وله الصلاحيات الآتية: ......\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. بالإضافة أهمية عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n-  عزل (المدير/المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء الآخرين. (وإذا كان المدير/ كانوا المديرين معينين في عقد مستقل)، جاز عزله/عزلهم بقرار يصدر من الأغلبية العددية للشركاء. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل).\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء. (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو بعقد مستقل طالما كانوا من غير الشركاء).\n\n (ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n(اختيار أحد الخيارين):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدين/ المديرين حل الشركة.\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السابعة: ‌قرارات الشركاء والنصاب اللازم لصدورها:\n\nتصدر قرارات الشركاء بالأغلبية العددية لآرائهم، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء.\n\nالمادة الثامنة: توزيع الأرباح والخسائر:\n\n يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر، وفي حال وجود شريك بالعمل فيضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\nاتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة العاشرة: الشروط اللازمة لتنازل أو انسحاب أو إخراج شريك:\n\nلا يجوز لأي من الشركاء التنازل عن كل أو بعض حصصه إلا بموافقة باقي الشركاء (يجوز النص على قيود محددة للتنازل)، ويجب قيد وشهر هذا التنازل لدى السجل التجاري.\n\n- للشريك الانسحاب من الشركة بإرادته المنفردة بشرط إبلاغ باقي الشركاء بذلك قبل (ستين) يومًا على الأقل من التاريخ الذي حدده للانسحاب. (يجوز النص على خلاف ذلك وبالتالي هذه الفقرة اختيارية)\n\n-  (يجوز النص على إجراءات أخرى لإخراج الشريك).\n\n- يجب على الشريك المنسحب من الشركة أو باقي الشركاء في حال إخراج شريك، قيد وشهر ذلك لدى السجل التجاري، ولا يسري الانسحاب أو الإخراج في مواجهة الغير إلا بعد القيد والشهر.\n\nالمادة الحادية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق الحالات المذكورة).\n\n- في حالة وفاة أي من الشركاء (يتعين اختيار أحد الخيارين التالية في العقد):\n\n\t\t- الأول: تستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة ويجب في هذه الحالة تحويل الشركة خلال مدة لا تتجاوز (سنة) من تاريخ وفاة مورثهم إلى شركة توصية بسيطة يصبح فيها القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا؛ وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المدة، ما لم يبلغ القاصر- خلال هذه المدة- سن الرشد أو ينتفِ سبب المنع عن مزاولة الأعمال التجارية ويرغب ذلك القاصر أو الممنوع من مزاولة الأعمال التجارية في أن يكون شريكًا متضامنًا.\n\n\t\t- الثاني: تستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفي إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة بوفاة أي من الشركاء)\".\n\n- إذا لم يتبق في الشركة عند وفاة أي من الشركاء، أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه، أو إخراجه، غير شريك واحد، فيمنح هذا الشريك مهلة (تسعين) يومًا لتصحيح وضع الشركة سواء بإدخال شريك آخر أو تحويلها إلى شكل آخر من أشكال الشركات الواردة في النظام، وإلا أصبحت الشركة منقضية بقوة النظام بمضي تلك المهلة.\n\nالمادة الثانية عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذه العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬\n\nالمادة الثالثة عشرة: نسخ العقد\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\nوالله ولي التوفيق\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nــــــــــــــــ\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "صك حصر ورثة", "icon": "", "title": "تعديل عقد شركة ذات مسؤولية محدودة بناءً على صك حصر ورثة", "desc": "دخول الورثة في الشركة بعد وفاة شريك.", "text": "نموذج رقم(...)\n\nتعديل عقد تأسيس بناء صك ورثة شركة ......................\n\n(شركة ذات مسؤولية محدودة)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...)والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) (...) تاريخ (...) ونظراً لوفاة الشريك(...) وبناء على صك حصر الورثة رقم(...) وتاريخ (...) فقد تقرر تعديل عقد تأسيس الشركة  (وفقا للملحق المرفق لهذا العقد) وفقاً ً لنظام الشركات الصادر وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nو أصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\n........................... (شركة ذات مسؤولية محدودة).\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة .............\n\n\tالمادة الثالثة: أغراض الشركة: الشركة:\n\n\t 1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة : رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف ) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الاجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي):\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي):\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولين شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة الخامسة : زيادة أو تخفيض رأس المال:\n\n- يجوز بموافقة جميع الشركاء زيادة رأس مالها عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n2. يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة\n\n3. للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة..\n\nالمادة السادسة : إدارة الشركة :\n\nالتعيين:\n\n\tيتولى إدارة الشركة ... (يتعين اختيار أحد الخيارات التالية): -\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\t4- يعينهم ..........\n\nالمادة السابعة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. ( يمكن النص في العقد على شروط لهذا التنازل).\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء (وفقاً للمادة الثامنة والسبعون بعد المائة من النظام/ يمكن النص في العقد على إجراءات أخرى للابلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة التاسعة : قرارات الشركاء:\n\n\t\t- تصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير/ مديرو الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة الثالثة عشرة من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل، ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك).\n\nالمادة العاشرة : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشرة: الأرباح والخسائر:\n\n1. يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال (يجوز النص على تفاوت تقاسم الأرباح والخسائر وفي حال وجود شريك بالعمل يمكن النص على نسبته في الأرباح)\n\n2. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط التي تحددها اللائحة التنفيذية لنظام الشركات.\n\n3.  توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (....%) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\tالمادة الثانية عشرة: انقضاء الشركة:\n\n\tتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولوائحه التنفيذية.\n\n\t-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬‬‬‬\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\n\tوقد تم اعتماد/ توثيق هذا العقد / قرار الشركاء، من قبل الموظف المختص / كاتب العدل"}, {"cat": "صك حصر ورثة", "icon": "", "title": "تعديل عقد شركة توصية بسيطة مهنية بناءً على صك حصر ورثة", "desc": "دخول الورثة في الشركة بعد وفاة شريك.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بناء صك ورثة شركة ...............\n\n(توصية بسيطة مهنية)\n\n- السيد/....................... ،الجنسية............. هوية رقم (..................) ومهنته ..............، حاصل على الترخيص المهني بممارسة مهنة ..................... رقم ............... وتاريخ ..../..../.....هـ، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة ............. (شريك متضامن)\n\n- السيد/.......................، الجنسية............. هوية رقم (..................) ومهنته ..............، حاصل على الترخيص المهني بممارسة مهنة ..................... رقم............... وتاريخ ..../..../.....هـ وتاريخ ميلاده...../..../...........هـ، ويقيم بمدينة ............. (شريك موصي)\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...)والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) (...) تاريخ (...) ونظراً لوفاة الشريك(...) وبناء على صك حصر ورثته رقم (...) وتاريخ (...) فقد تقرر تعديل عقد تأسيس الشركة  (وفقاً للملحق المرفق لهذا العقد) وفقاً ً لنظام الشركات الصادر وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة: .............. (شركة توصية بسيطة مهنية).\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيسي للشركة في مدينة (...) بالمملكة العربية السعودية، ويجوز نقل المركز إلى أي مدينة أخرى بالمملكة بعد موافقة الشركاء والجهات المعنية بالإشراف على المهنة الحرة محل نشاط الشركة (إن وجدت).\n\nالمادة الثالثة: أنشطة الشركة:\n\nإن الأنشطة التي أسست الشركة لأجلها هي:\n\n(ملحوظة: يجب أن يكون نشاط الشركة مهنيًّا)\n\nممارسة مهنة (...)\n\nتخضع الشركة في ممارسة المهنة أو المهنة الحرة محل نشاطها لإشراف الجهة أو الجهات المعنية نظاماً بالإشراف على ممارسة تلك المهن. وتلتزم الشركة بالتقيد بأحكام الأنظمة واللوائح التي الجهة والجهات المعنية وفق اختصاصها. وتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: مدة الشركة:(الاختيار من أحد الخيارات)\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز بموافقة جميع الشركاء تمديد مدتها.\n\nالمادة الخامسة: الإدارة:\n\n- تعيين (المدير/ المديرين):\n\n(في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء المتضامنين في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nملحوظة: إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. ويجب ألا تتضمن الصلاحيات أو السلطات الممنوحة للإدارة ما يخل باستقلالية الشركاء في ممارستهم لمهنهم الحرة. بالإضافة إلى عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n- عزل (المدير/ المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المتضامنين المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء المتضامنين الآخرين.  (وإذا كان معين/ كانوا معينين في عقد مستقل) جاز عزله/ عزلهم بقرار يصدر من الأغلبية العددية للشركاء المتضامنين. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل.)\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء المتضامنين (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو في عقد مستقل طالما كانوا من غير الشركاء).\n\n(ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدير/ المديرين حل الشركة.\n\n- مدة تولي الإدارة وتحديد مكافأة (المدير /المديرين):\n\nملحوظة: يُحدد في هذه الفقرة مدة تولي الإدارة، والمكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد الآلية لكونها عرضة للتغيير. (جوازيه)\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء المتضامنين الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السادسة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. (ريال سعودي) يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n\n1-  الشريك الأول، السيد / ...........وحصته قدرها (كتابة) (رقما) ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....) (.... ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الشريك الثاني، السيد / ...........وحصته قدرها (كتابة) (رقما) ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال).\n\nملاحظة: الجدول أدناه وضع لأجل التوضيح: حدد رأسمال الشركة بمبلغ مقداره (...) فقط، مقسم إلى (...) حصة نقدية متساوية القيمة، قيمة كل حصة (...) ريال، موزعة على الشركاء على النحو الآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة السابعة: ‌قرارات الشركاء:\n\n- تصدر قرارات الشركاء بالأغلبية العددية لآراء الشركاء المتضامنين، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين.\n\n- يكون للشركة جمعية عامة تكون اختصاصاها وإجراءات انعقادها على النحو الآتي: (ملاحظة: النص يعد اختياري، وفي حال إضافته؛ فإنه يتعين على الشركاء إيراد اختصاصات الجمعية وإجراءات انعقادها أي نصاب الانعقاد وصحة صدور القرارات).\n\n- لا يجوز للشريك الموصي طلب حل الشركة أو الاشتراك في التصويت على المسائل الخاصة بتعيين أو عزل مديرها.\n\nالمادة الثامنة: توزيع الأرباح والخسائر:\n\n- يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر بين الشركاء المتضامنين، وفي حال وجود شريك بالعمل فيجب أن يكون متضامن مرخص له، ويضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\n- في حال فقد الشريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي:\n\nملحوظة: إضافة نص حر يترك كيفية توزيع الأرباح والخسائر المشار إليه في الفقرة (2) بين الشركاء، وذلك عند وقوع الحالة المشار إليها.\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا من المرهص له، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\n- اتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري)\n\nالمادة العاشرة: التنازل عن الحصص أو انسحاب الشريك أو اخراج أو إدخال شركاء:\n\n\t- التنازل عن الحصص:\n\n\t- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه لأي من الشركاء الآخرين في الشركة.\n\n- يجوز للشريك المتضامن أن يتنازل عن كل أو بعض حصصه لمصلحة شريك موصٍ أو للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين.  (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- ادخال شركاء في الشركة:\n\nيجوز اداخل شركاء متضامنين أو موصين إلى الشركة، بعد موافقة جميع الشركاء المتضامين دون الحاجة إلى الحصول على موافقة الشركاء الموصين. ( ملاحظة: النص المضلل يمكن أن يتم الاتفاق على خلافه في العقد بحيث يتم الاتفاق على نصاب آخر أو على شرط الحصول على موافقة الموصين،).\n\n- انسحاب الشريك أو إخراجه:\n\nيخضع الشركاء المتضامنين في الشركة للأحكام المطبقة على الشركاء في شركة التضامن، وذلك في حال وفاته أو بالحجر عليه أو بإعساره، أو بافتتاح أي من إجراءات التصفية تجاهه في شركة التضامن، أو بانسحابه أو إخراجه وتقدير نصيبه في أموال الشركة.\n\nالمادة الحادية عشرة: الترخيص المهني:\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، (اختيار أحد الخيارين التالية):\n\n\t- عُد منسحباً من الشركة.\n\n\t- يستمر بصفته شريك موصي غير مرخص له بممارسة المهنة في الشركة مع مراعاة الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من النظام.\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- لا يجوز للشركاء حل الشركة قبل مضي الأجل المحدد لها إلا بعد الإعلان عن ذلك وإبلاغ جميع المتعاملين معها كتابة بحسب الإجراءات بحسب الإجراءات المحددة نظاماً، مع مراعاة الشروط والضوابط التي تحددها الجهة أو الجهات المشرفة على المهن الحرة محل نشاط الشركة.\n\n- إذا توفي أحد الشركاء في الشركة... (ملحوظة: يجب الاختيار أحد النصين)\n\n- النص الأول في حال عدم دخول الورثة: \" تستمر الشركة بين باقي الشركاء، وتقدر قيمة حصة الشريك المتوفى من مقيم معتمد أو أكثر يعد تقريرًا يبين فيه القيمة العادلة لنصيب كل شريك في أموال الشركة في تاريخ وفاة الشريك. ولا يكون للورثة نصيب فيما يستجد بعد ذلك إلا بقدر ما تكون هذه الحقوق ناتجة عن عمليات سابقة على وفاة مورثهم\".\n\n- النص الثاني في حال دخول الورثة في حصة مورثهم: \" تؤول حصته إلى ورثته، ويكون للورثة في حال مشاركته صفة الشريك الموصي. ويجوز أن يكون الوريث شريكاً ممارساً لمهنته عن طريق الشركة؛ شريطة تحقق الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) والشروط المنصوص عليها في المادة (الثالثة عشرة بعد المائتين) من نظام الشركات.\n\n- يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية وفقاً لنظام الإفلاس:\n\n (ملحوظة: يجوز للشركاء تحديد ما يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه أو إخراجه، كأن يتم الاتفاق على انقضاءها أو عدم انقضاء الشركة واستمرارها مع باقي الشركاء، شريطة بقاء شريك متضامن مرخص له في المهنة الحرة محل نشاط الشركة، أي لا يمكن إضافة هذا النص ما لم يكن هنالك أكثر من شريك متضامن مرخص له.)\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬\n\nالرابعة عشرة: نسخ العقد:\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالشريك الأول المتضامن                                                     الشريك الثاني الموصي"}, {"cat": "امتياز تجاري", "icon": "", "title": "اتفاقية امتياز تجاري — تجزئة", "desc": "مسودة اتفاقية امتياز لقطاع التجزئة (63 صفحة).", "pdf": "templates/franchise-retail.pdf"}, {"cat": "امتياز تجاري", "icon": "", "title": "اتفاقية امتياز تجاري — خدمات", "desc": "مسودة اتفاقية امتياز لقطاع الخدمات.", "pdf": "templates/franchise-services.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد توريد عام (حكومي)", "desc": "النموذج المعتمد من وزارة المالية، 47 صفحة.", "pdf": "templates/supply-contract.pdf"}, {"cat": "تجاري", "icon": "", "title": "نموذج موحد لعقد وكالة تجارية", "desc": "نموذج استرشادي وفق نظام الوكالات التجارية.", "pdf": "templates/agency-model.pdf"}, {"cat": "أدلة", "icon": "", "title": "الأطر التنظيمية للائحة التنفيذية للموارد البشرية", "desc": "دليل مرجعي للموارد البشرية.", "pdf": "templates/hr-framework.pdf"}, {"cat": "تحويل فرع", "icon": "", "title": "تحويل فرع شركة إلى شركة بموجب شهادة الاستثمار (مهنية)", "desc": "تحويل فرع شركة أجنبية إلى شركة بموجب شهادة الاستثمار.", "text": "عقد تأسيس شركة ......................\n\n(شركة ذات مسؤولية محدودة)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة..............) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة)  بموجب شهادة الاستثمار رقم (..............) وتاريخ (..............) وذلك بالتنازل الى الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري والرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية:\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n...........................\t (شركة ذات مسؤولية محدودة).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة… ....\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t 1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة : رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف ) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الاجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية جديدة تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولين شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة السادسة : زيادة أو تخفيض رأس المال:-\n\nيجوز بموافقة جميع الشركاء زيادة رأس مالها عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n2. يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة\n\n3. للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة..\n\nالمادة السابعة : إدارة الشركة :\n\nالتعيين:\n\n\tيتولى إدارة الشركة ... (يتعين اختيار احد الخيارات التالية): -\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\t- يعينهم ....................\n\nالمادة الثامنة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. ( يمكن النص في العقد على شروط لهذا التنازل).\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء (وفقاً للمادة الثامنة والسبعون بعد المائة من النظام/ يمكن النص في العقد على إجراءات أخرى للإبلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة التاسعة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة العاشرة : قرارات الشركاء:\n\n\t\t- تصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير/ مديرو الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة الثالثة عشرة من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل، ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك).\n\nالمادة الحادية عشر : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الثانية عشر: الأرباح والخسائر:\n\n1. يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال (يجوز النص على تفاوت تقاسم الأرباح والخسائر وفي حال وجود شريك بالعمل يمكن النص على نسبته في الأرباح)\n\n2. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط التي تحددها اللائحة التنفيذية لنظام الشركات.\n\n3.  توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (....%) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\tالمادة الثالثة عشر: انقضاء الشركة:\n\n\tتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الرابعة عشر: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nوقد تم اعتماد/توثيق هذا العقد من قبل الموظف المختص/كاتب العدل\n\nعقد تأسيس شركة ......................\n\n(شركة ذات مسؤولية محدودة مهنية)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ......... ) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) ، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة مهنية)  بموجب شهادة الاستثمار رقم (..............) وتاريخ (..............) وذلك بالتنازل الى الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري والرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية:\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n...........................\t (شركة ذات مسؤولية محدودة مهنية).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة … ....\n\n\tالمادة الرابعة: أغراض الشركة:\n\n 1-\n\n\t2-\n\n\t (ملاحظة: يجب أن تكون انشطة الشركة مهنية)\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة : رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال تم توزيعها على الشركاء كالآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الاجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  |  |  |  | نقداً |\n| 2 |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر الشركاء بأنه تم توزيع الحصص فيما بينهم وتم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية جديدة تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الموجودات العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق الشركاء على قيمة الحصص العينية. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nوقد وافق الشركاء على تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس ويقرون بأنهم مسؤولين شخصيًّا في جميع أموالهم في مواجهة الغير عن عدالة تقدير هذه الحصص. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة السادسة : زيادة أو تخفيض رأس المال:-\n\nيجوز بموافقة جميع الشركاء زيادة رأس مالها عن طريق رفع القيمة الاسمية لحصص الشركاء.\n\n2. يجوز بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل (يمكن النص في الفقرة على نسبة أكبر) زيادة رأس مال الشركة عن طريق إصدار حصص جديدة.\n\n3. للجمعية العامة للشركاء أن تقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة..\n\nالمادة السابعة : إدارة الشركة :\n\nالتعيين:\n\n( ملاحظة: في حال تولى إدارة الشركة مدير واحد فيجب أن يكون من الشركاء المرخص لهم. أما في حال تولاها مديرين اثنين او أكثر (مجلس مديرين)، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف).\n\n\tيتولى إدارة الشركة ... (يتعين اختيار احد الخيارات التالية): -\n\n- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\t4- يعينهم ....................\n\nالمادة الثامنة: التنازل عن الحصص:\n\nيجوز للشريك أن يتنازل عن حصته لأحد الشركاء. ( يمكن النص في العقد على شروط لهذا التنازل).\n\n\tيجوز للشريك أن يتنازل عن حصته لغير أحد الشركاء (وفقاً للمادة الثامنة والسبعون بعد المائة من النظام/ يمكن النص في العقد على إجراءات أخرى للإبلاغ بالتنازل عن الحصة أو على طريقة تقييم أخرى أو مدة أطول لممارسة حق الاسترداد وسداد القيمة)\n\n\tالمادة التاسعة: التبليغات التي توجهها الشركة إلى الشركاء:\n\nتكون التبليغات التي توجهها الشركة إلى الشركاء عن طريق أي من الوسائل الآتية:\n\n- إرسالها إلى الشركاء بخطابات مسجلة.\n\n- التسليم شخصيًّا إلى الشركاء أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى يتفق عليها الشركاء)\n\nالمادة العاشرة : قرارات الشركاء:\n\n\t\t- تصدر قرارات الشركاء في الجمعية العامة. ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير/ مديرو الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة.\n\n\t\t-  يجوز أن تُرسل القرارات المقترحة وما يتعلق بها من وثائق بأي من وسائل التبليغات المنصوص عليها في المادة الثالثة عشرة من هذا العقد.\n\n\t\t- يجوز تعديل عقد تأسيس الشركة بموافقة شريك أو أكثر يمثلون (ثلاثة أرباع) رأس المال على الأقل. ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t-  لا تكون القرارات الأخرى صحيحة إلا إذا وافق عليها شريك أو أكثر تمثل نسبة حصصهم أكثر من (نصف) رأس المال على الأقل، ( يجوز النص في العقد على أغلبية أكبر).\n\n\t\t- إذا لم تتوافر في المداولة أو في المشاورة الأولى النسبة المنصوص عليها في الفقرة (4) من هذه المادة، وجبت دعوة الشركاء إلى الاجتماع، وتصدر القرارات فيه بموافقة أغلبية الحصص الممثلة فيه أيًّا كانت النسبة التي تمثلها في رأس المال. (يجوز النص في العقد على غير ذلك).\n\nالمادة الحادية عشر : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الثانية عشر: الأرباح والخسائر:\n\n1. يتقاسم جميع الشركاء الأرباح والخسائر بحسب نسبة حصة كل منهم في رأس المال (يجوز النص على تفاوت تقاسم الأرباح والخسائر وفي حال وجود شريك بالعمل يمكن النص على نسبته في الأرباح)\n\n2. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على الشركاء، وفقا للضوابط التي تحددها اللائحة التنفيذية لنظام الشركات.\n\n3.  توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (....%) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- تحدد الجمعية العامة النسبة التي يجب توزيعها على الشركاء من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\t- في حال فقد شريك ترخيص ممارسة مهنته الحرة بصفة موقتة، سواءً كان هو الممارس الوحيد للمهنة الحرة من بين الشركاء الآخرين أو يمارس تلك المهنة بالمشاركة مع شريك آخر؛ فيتم توزيع الارباح والخسائر وفقاً لما يلي: ...........(ملاحظة: يجب النص على تحديد كيفية توزيع الارباح والخسائر عند وقوع اي من تلك الحالتين المشار اليهما في الفقرة، وذلك بناء على نص الفقرة (1) من المادة (211) من نظام الشركات المهنية).\n\n\tالمادة الثالثة عشر: الترخيص المهني:\n\nإذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، ...... ( يتعين اختيار أحد الخيارين التالية) :\n\n\t\t\t- عُد منسحباً من الشركة.\n\n\t\t\t- يستمر شريكا غير مرخص له في ممارسة المهنة في الشركة، إذا تحققت الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\n\tالمادة الرابعة عشر: انقضاء الشركة:\n\n\tتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الخامسة عشر: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nوقد تم اعتماد/توثيق هذا العقد من قبل الموظف المختص/كاتب العدل\n\nالنظام الأساس لشركة ......................\n\n(شركة ذات مسؤولية محدودة من شخص واحد)\n\nتؤسس طبقا لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (132/م) وتاريخ 1/12/1443هـ ولائحته التنفيذية الصادرة بقرار معالي وزير التجارة رقم (284) وتاريخ 23/6/1444هــ شركة .................... (ذات مسؤولية محدودة من شخص واحد) مملوكة لـ....................، ............. الجنسية هوية رقم (.................. ) وتاريخ ...../...../..... هـ صادر من مدينة .......... وتاريخ الميلاد ...../....../.....هـ،  ومهنته .......... ويقيم في مدينة ...........، وفقاً للشروط والأحكام التالية:\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة..............) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة .............  والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هــ ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000)، وترغب في تحويل هذا الفرع إلى شركة (ذات مسؤولية محدودة من شخص واحد) بموجب شهادة الاستثمار رقم (..............) وتاريخ (..............) وذلك بالتنازل الى الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nيعتبر التمهيد السابق جزء لا يتجزأ من هذا العقد.\n\nالمادة الثانية: اسم الشركة:\n\n...........................\t (شركة ذات مسؤولية محدودة من شخص واحد).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة… ....\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t 1-\n\n\t2-\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة : رأس المال:\n\nحدد رأس مال الشركة بـ (الأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (.....) حصة متساوية القيمة، وقيمة كل حصة (.....) ريال وفق ما يلي:\n\n| بيان | عدد الحصص | قيمة الحصة | الإجمالي | طريقة الوفاء بقيمة الحصص |\n| --- | --- | --- | --- | --- |\n|  |  |  |  | نقداً |\n|  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |\n\nويقر مالك رأس المال بأنه تم الوفاء بقيمتها كاملة.\n\n (في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق مالك رأس المال على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي)\n\nويقر مالك رأس المال بأنه مسؤول شخصيًّا في جميع أمواله في مواجهة الغير عن عدالة تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\nالمادة السادسة : زيادة أو تخفيض رأس المال:-\n\n- يجوز لمالك رأس المال زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية للحصص أو إصدار حصص جديدة.\n\n- لمالك رأس المال أن يقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة السابعة : إدارة الشركة :\n\nالتعيين:\n\n\tيتولى إدارة الشركة ... (يتعين اختيار احد الخيارات التالية): -\n\n- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\tالمادة الثامنة: التبليغات التي توجهها الشركة إلى مالك رأس المال: (في حال كان المدير غير مالك رأس المال)\n\nتكون التبليغات التي توجهها الشركة إلى مالك رأس المال عن طريق أي من الوسائل الآتية:\n\n- إرسالها بخطابات مسجلة.\n\n- التسليم شخصيًّا أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n(يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى بموافقة مالك رأس المال)\n\nالمادة التاسعة : قرارات مالك رأس المال:\n\nيكون لمالك رأس المال الصلاحيات والسلطات المنصوص عليها في نظام الشركات، وتصدر قراراته كتابة، وتدون في سجل خاص لدى الشركة.\n\nالمادة العاشرة : السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز أن ينص المادة على السنة الميلادية أو الهجرية).\n\nالمادة الحادية عشر: الأرباح والخسائر:\n\n- يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على مالك رأس المال، وفقا للضوابط النظامية المقررة.\n\n- توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (..... %) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض .............. (هذا البند اختياري)\n\n\t- يحدد مالك رأس المال النسبة التي يجب توزيعها من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\n\tالمادة الثانية عشر: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب (الثاني عشر) من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الثالثة عشر: أحكام ختامية:\n\n-  تخضع الشركة للأنظمة السارية بالمملكة.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا العقد لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولائحته التنفيذية.\n\n- تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس.\n\nوقد تم اعتماد/توثيق هذا العقد من قبل الموظف المختص/كاتب العدل"}, {"cat": "تحويل فرع", "icon": "", "title": "تحويل فرع شركة إلى شركة توصية بسيطة (مهنية)", "desc": "عقد تأسيس شركة توصية بسيطة ناتجة عن تحويل فرع.", "text": "عقد تأسيس شركة ......................\n\n(شركة توصية بسيطة)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\n(في حال وجود شريك بالعمل فتضاف بياناته ضمن بيانات الشركاء ولا يضاف اسمه في مادة رأس المال)\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ...........) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة ............. والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (توصية بسيطة)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nالتمهيد جزء لا يتجزأ من العقد\n\nالمادة الثانية: اسم الشركة:\nشركة ............................ (شركة توصية بسيطة).\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة .............\n\n\tالمادة الرابعة: أغراض الشركة:\n\n\t- ..................\n\n\t- .................\n\n\tوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الخامسة: رأس المال:\n\n-  حدد رأس مال الشركة بـ (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال مقسم إلى (.....) حصة، تم توزيعها على الشركاء كالتالي:\n\n-  الطرف الأول/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n-  الطرف الثاني/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n(الجدول أدناه يعد خيار آخر للتعريف بالحصة التي تعهّد كل شريك بتقديمها)\n\n| م | اسم الشريك | طريقة الوفاء بقيمة الحصص | قيمة الحصة | عدد الحصص | الإجمالي |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  | نقداً |  |  |  |\n| 2 |  | عينياً مع تعريف كاف بالمنقولات أو العقارات المقدمة |  |  |  |\n| الإجمالي |  |  |  |  |  |\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n-  يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nأو\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، ويتعهد الشريك ............... (اسم الشريك) بالوفاء بحصته (النقدية أو العينية أو النقدية والعينية) خلال (.....) يوم من تاريخ قيد الشركة لدى السجل التجاري.\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية أو ميلادية) تبدأ من تاريخ قيدها لدى السجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السابعة: إدارة الشركة:\n\n(الأصل أن يكون المدير من الشركاء المتضامنين، ويجوز أن يكون من غير الشركاء، ولا يجوز للشريك الموصي التدخل في أعمال الإدارة الخارجية، ويجوز للشريك الموصي الاشتراك في أعمال الإدارة الداخلية وفق ما ينص عليه عقد التأسيس، كما يجوز تعيين المدير أو المديرين في عقد التأسيس ويجوز تعيينهم في عقد مستقل)\n\n- التعيين:\n\n(في عقد التأسيس)\n\n- يتولى إدارة الشركة ........................... (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nأو\n\n(في عقد مستقل)\n\n- يتولى إدارة الشركة ...........................   (يتعين الاختيار سواء مدير واحد، أو مدير واحد أو أكثر، أو مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- الصلاحيات والسلطات:\n\n- يباشر (المدير أو المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة. (يجوز إضافة العبارة التالية: واستثناء من ذلك لا يجوز للمدير أو المديرين مباشرة الأعمال التالية إلا بقرار من الشركاء: أ. .................. ب. ....................)\n\n(يجوز أيضا إضافة النص الآتي بفقراته السبع كاملة أو الاكتفاء ببعض الفقرات)\n\nكما يجوز (للمدير أو المديرين) مباشرة الأعمال التالية التي قد تتجاوز غرض الشركة دون الحاجة لإصدار قرار من الشركاء:\n\n-  إنشاء فروع الشركة، أو إغلاقها.\n\n- التبرعات.\n\n- كفالة الشركة للغير.\n\n- التصالح على حقوق الشركة.\n\n- بيع عقارات الشركة أو رهنها.\n\n- بيع محلّ الشركة التجاري (المتجر) أو رهنه.\n\n- الاقتراض نيابة عن الشركة.\n\n(يجوز في حالة تعيين أكثر من مدير تحديد اختصاص كل منهم، ووضع آلية لإصدار قراراتهم)\n\n\t- يجوز للشريك الموصي الاشتراك في أعمال إدارة الشركة الداخلية التالية: ............ (الفقرة اختيارية؛ فإذا تم وضعها في العقد فيتعين تحديد الأعمال الداخلية)\n\n\t- العزل: (فقرة اختيارية)\n\n- إذا كان المدير شريكاً في الشركة فيجوز عزله ................... (يتعين الاختيار من أحد الخيارات التالية: بقرار يصدر بإجماع الشركاء الآخرين في الشركة، أو بقرار يصدر بالأغلبية العددية للشركاء، كما يجوز الاتفاق على أغلبية عددية معينة في عزل المدير غير ما ذكر)\n\n- إذا كان المدير من غير الشركاء فيجوز عزله بقرار يصدر بالأغلبية العددية للشركاء.\n\nالمادة الثامنة: ‌قرارات الشركاء والنصاب اللازم لصدورها:\n\n- تصدر قرارات الشركاء المتعلقة بتعديل عقد التأسيس ................. (يتعين الاختيار من أحد الخيارات التالية: بإجماع الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو بالأغلبية العددية لآراء الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين، كما يجوز تحديد نصاب صدور القرارات المتعلقة بتعديل عقد التأسيس غير ما ذكر)\n\n- تصدر قرارات الشركاء الأخرى ................. (يتعين الاختيار من أحد الخيارات التالية: بالأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز تحديد طريقة صحة صدور القرارات بغير ما ذكر)\n\n- لا يجوز للشريك الموصي طلب حل الشركة ولا الاشتراك في التصويت على المسائل الخاصة بتعيين أو عزل مديرها.\n\n- تصدر جميع قرارات الشركاء في جمعية عامة، ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة، وتكون إجراءات انعقاد الجمعية العامة كما يلي: أ. ............... ب. ............... (الفقرة اختيارية؛ يجوز عدم إضافتها أو التعديل على نصها، وفي حال إضافتها فيتعين أن تتضمن على الأقل بيان يوضح اختصاصات الجمعية العامة وإجراءات انعقادها)\n\nالمادة التاسعة: توزيع الأرباح والخسائر:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n-  يكون نصيب كل شريك في الأرباح أو الخسائر بحسب حصته في رأس المال.\n\nأو\n\n- (في حال وجود شريك بحصة عمل، فيتم اختيار الآتي)\n\nيكون نصيب كل شريك في الأرباح أو الخسائر كما يلي:\n\n| م | اسم الشريك | نصيبه في الأرباح % | نصيبه في الخسائر % |\n| --- | --- | --- | --- |\n| 1 |  |  |  |\n| 2 |  |  |  |\n\nالمادة العاشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها لدى السجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً (هجرية أو ميلادية)\n\nالمادة الحادية عشرة: التنازل عن الحصص وإدخال شركاء: (مادة اختيارية)\n\n- التنازل عن الحصص:\n\n- يجوز للشريك الموصي أن يتنازل عن كل حصصه أو بعضها لأي من الشركاء الآخرين في الشركة.\n\n- يجوز للشريك الموصي أن يتنازل عن كل حصصه أو بعضها للغير وذلك بعد موافقة ................... (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو  الأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز إضافة شروط للتنازل)\n\n- يجوز للشريك المتضامن أن يتنازل عن كل حصصه أو بعضها لمصلحة شريك موص أو للغير وذلك بعد موافقة .................. (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو  الأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز إضافة شروط للتنازل)\n\n- يجوز إدخال شركاء متضامنين إلى الشركة وذلك بعد موافقة ................ (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ودون الحاجة إلى الحصول على موافقة الشركاء الموصين، أو جميع الشركاء المتضامنين والموصين)\n\n- يجوز إدخال شركاء موصين إلى الشركة وذلك بعد موافقة ................ (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ودون الحاجة إلى الحصول على موافقة الشركاء الموصين، أو جميع الشركاء المتضامنين والموصين)\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء المتضامنين، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\n- في حالة وفاة أي من الشركاء المتضامنين (يمكن اختيار أحد الخيارات التالية)\n\n\t\t-  فلا تنقضي الشركة وتستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة. ويجب في هذه الحالة أن يكون القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا.\n\n\t\t- فلا تنقضي الشركة وتستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفى إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n\t\t- فإن الشركة تنقضي بمجرد وفاته.\n\n- لا تنقضي الشركة بوفاة أي من الشركاء الموصين، ولا بالحجر عليه، ولا بإعساره، ولا بافتتاح أي من إجراءات التصفية تجاهه وفقاً لنظام الإفلاس، ولا بانسحابه. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يتعد بأي نص خاص وارد في هذه العقد يخالف أحكام نظام الشركات ولائحته التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولائحته التنفيذية وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\nالشريك أول متضامن                                                         الشريك ثاني موصي\n\nعقد تأسيس شركة ......................\n\n(شركة توصية بسيطة مهنية)\n\nبعون الله تعالى تم الإتفاق في يوم ...../...../....14هـ الموافق ..../..../......20م بين كل من:\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............(طرف أول)\n\n- السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثاني)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. (طرف ثالث)\n\n-  السيد/.........................  ، ............. الجنسية هوية  رقم (.................. )ومهنته ..............، وتاريخ ميلاده...../..../...........هـ, ويقيم بمدينة .............. ( طرف رابع )\n\nالتمهيد :\n\nحيث أن السادة/ شركة ................................. (شركة ...........) والمقيدة بالسجل التجاري بالرقم الموحد (0000000000) وتاريخ 00/00/0000هـ في مدينة ............. والمثبت عقد تأسيسها لدى .............................. بالرقم 000000000 بتاريخ 00/00/0000هـ. ، تمتلك سجل فرعي للشركة مقيدة باسم / ................................ و رقمها الموحد (0000000000) صادر من مدينة ........... ، وترغب في تحويل هذا الفرع إلى شركة (توصية بسيطة مهنية)  وذلك بالتنازل الى  الأطراف المذكورين أعلاه (مع الاحتفاظ بالاسم التجاري و الرقم الموحد للشركة وتاريخ السجل التجاري/ أو مع تغيير الاسم التجاري إلى ........................) عند تحويله إلى شركة، وقد استوفى الأطراف حقوقهم من قبل بعضهم البعض ويعتبر توقيعهم على هذا العقد بمثابة موافقتهم على ذلك، وعليه فقد اتفق الأطراف المذكورين أعلاه على تكوين شركة ذات مسئولية محدودة وفقاً لنظام الشركات الصادر بالمرسوم الملكي الكريم رقم (م/132) وتاريخ 01/12/1443هـ ولائحته ووفقاً للشروط التالية :\n\nالمادة الأولى:\n\nالتمهيد جزء لايتجزأ من العقد\n\nالمادة الثانية: اسم الشركة:\n\nشركة ........................... (شركة توصية بسيطة مهنية)\n\nالمادة الثالثة: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة .......................\n\nالمادة الرابعة: أغراض الشركة:\n\nممارسة مهنة ...................... (يجب أن يكون نشاط الشركة مهنيًّا ويتوافق مع التراخيص المهنية للشركاء)\n\nالمادة الخامسة: رأس المال:\n\n-  حدد رأس مال الشركة بـ (المبلغ بالأرقام) (المبلغ بالأحرف) ريال سعودي مقسم إلى (.....) حصة، تم توزيعها على الشركاء كالتالي:\n\n- الطرف الأول/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n-  الطرف الثاني/ ...................... وحصته الإجمالية في رأس المال قدرها (المبلغ بالأرقام العربية) ريال (المبلغ مكتوب بالأحرف) ريال، مقسمة إلى (....) حصة، يتم الوفاء بقيمتها ........... (يتعين الاختيار سواء الوفاء بالحصة نقداً أو الوفاء بالحصة عينياً بتقديم الموجودات التالية: \"بيان كاف للتعريف بالمنقولات أو العقارات المقدمة وقيمة كل منها\"، أو الوفاء بالحصة نقداً وعينياً معاً)\n\n(الجدول أدناه يعد خيار آخر للتعريف بالحصة التي تعهّد كل شريك بتقديمها)\n\n| م | اسم الشريك | طريقة الوفاء بقيمة الحصص | قيمة الحصة | عدد الحصص | الإجمالي |\n| --- | --- | --- | --- | --- | --- |\n| 1 |  | نقداً |  |  |  |\n| 2 |  | عينياً مع تعريف كاف بالمنقولات أو العقارات المقدمة |  |  |  |\n| الإجمالي |  |  |  |  |  |\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nأو\n\n- يقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، ويتعهد الشريك ............... (اسم الشريك) بالوفاء بحصته (النقدية أو العينية أو النقدية والعينية) خلال (.....) يوم من تاريخ قيد الشركة لدى السجل التجاري.\n\nالمادة السادسة: مدة الشركة:\n\n(يتعين النص في العقد على أحد الخيارين التالية)\n\n- تكون الشركة غير محددة المدة.\n\nأو\n\n- مدة الشركة (........) سنة (هجرية أو ميلادية) تبدأ من تاريخ قيدها لدى السجل التجاري، ويجوز دائماً إطالة هذه المدة بقرار من الشركاء.\n\nالمادة السابعة: إدارة الشركة:\n\n(إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة، كما يجوز تعيين المدير أو المديرين في عقد التأسيس ويجوز تعيينهم في عقد مستقل. ولا يجوز للشريك الموصي التدخل في أعمال الإدارة الخارجية، ويجوز للشريك الموصي الاشتراك في أعمال الإدارة الداخلية وفق ما ينص عليه عقد التأسيس)\n\n- التعيين:\n\n(في عقد التأسيس)\n\n- يتولى إدارة الشركة ............................ (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nأو\n\n(في عقد مستقل)\n\n- يتولى إدارة الشركة (يتعين الاختيار سواء مدير واحد، أو مدير واحد أو أكثر، أو مديرين أو أكثر) (يعينه/ يعينهم) الشركاء في عقد مستقل. ويمثل (المدير أو المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n- الصلاحيات والسلطات:\n\n- يباشر (المدير أو المديرين) جميع أعمال الإدارة التي تدخل في غرض الشركة. (يجوز إضافة العبارة التالية: واستثناء من ذلك لا يجوز للمدير أو المديرين مباشرة الأعمال التالية إلا بقرار من الشركاء: أ. .................. ب. ....................)\n\n(يجوز أيضا إضافة النص الآتي بفقراته السبع كاملة أو الاكتفاء ببعض الفقرات)\n\nكما يجوز (للمدير أو المديرين) مباشرة الأعمال التالية التي قد تتجاوز غرض الشركة دون الحاجة لإصدار قرار من الشركاء:\n\n-  إنشاء فروع الشركة، أو إغلاقها.\n\n- التبرعات.\n\n- كفالة الشركة للغير.\n\n- التصالح على حقوق الشركة.\n\n- بيع عقارات الشركة أو رهنها.\n\n- بيع محلّ الشركة التجاري (المتجر) أو رهنه.\n\n- الاقتراض نيابة عن الشركة.\n\n(يجوز في حالة تعيين أكثر من مدير تحديد اختصاص كل منهم)\n\n\t- يجوز للشريك الموصي الاشتراك في أعمال إدارة الشركة الداخلية التالية: ............ (الفقرة اختيارية؛ فإذا تم وضعها في العقد فيتعين تحديد الأعمال الداخلية)\n\n- مدة تولي الإدارة:\n\nمدة إدارة الشركة المعينة بموجب هذا العقد أو العقد المستقل غير محددة. (يمكن تحديد مدة، ويمكن وضع أحكام لتجددها، مع ملاحظة أن إضافة هذه الفقرة إلزامي حتى ولو كانت الإدارة معينة في عقد مستقل)\n\n-  مكافأة الإدارة:\n\n(يُحدد في هذه الفقرة المكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد آلية احتسابها لكونها في العادة عرضة للتغيير، مع ملاحظة أن إضافة هذه الفقرة إلزامي حتى ولو كانت الإدارة معينة في عقد مستقل)\n\n- العزل:\n\n- إذا كان المدير شريكاً في الشركة فيجوز عزله ....................... (يتعين الاختيار من أحد الخيارات التالية: بقرار يصدر بإجماع الشركاء الآخرين في الشركة، أو بقرار يصدر بالأغلبية العددية للشركاء، كما يجوز الاتفاق على أغلبية عددية معينة في عزل المدير غير ما ذكر)\n\n- إذا كان المدير من غير الشركاء فيجوز عزله بقرار يصدر بالأغلبية العددية للشركاء.\n\nالمادة الثامنة: قرارات الشركاء والنصاب اللازم لصدورها:\n\n- تصدر قرارات الشركاء المتعلقة بتعديل عقد التأسيس ................. (يتعين الاختيار من أحد الخيارات التالية: بإجماع الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو بالأغلبية العددية لآراء الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين، كما يجوز تحديد نصاب صدور القرارات المتعلقة بتعديل عقد التأسيس غير ما ذكر)\n\n- تصدر قرارات الشركاء الأخرى ................. (يتعين الاختيار من أحد الخيارات التالية: بالأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز تحديد طريقة صحة صدور القرارات بغير ما ذكر)\n\n- لا يجوز للشريك الموصي طلب حل الشركة ولا الاشتراك في التصويت على المسائل الخاصة بتعيين أو عزل مديرها.\n\n- تصدر جميع قرارات الشركاء في جمعية عامة، ومع ذلك، يجوز إصدار قرارات الشركاء بعرضها عليهم بالتمرير دون الحاجة إلى انعقاد الجمعية العامة. وفي هذه الحالة، يرسل مدير الشركة إلى كل شريك القرارات المقترحة والوثائق ذات العلاقة بها ليصوت الشريك عليها كتابة، وتكون إجراءات انعقاد الجمعية العامة كما يلي: أ. ............... ب. ............... (الفقرة اختيارية؛ يجوز عدم إضافتها أو التعديل على نصها، وفي حال إضافتها فيتعين أن تتضمن على الأقل بيان يوضح اختصاصات الجمعية العامة وإجراءات انعقادها)\n\nالمادة التاسعة: قرارات الإدارة والنصاب اللازم لصدورها:\n\n(في حال تعيين مدير وأكثر لإدارة الشركة، فيتعين تحديد النصاب اللازم لصحة صدور كل قرار، وشروط نصاب أصوات الشركاء المديرين في ذلك القرار)\n\nالمادة العاشرة: توزيع الأرباح والخسائر:\n\n- (يتعين النص في العقد على أحد الخيارين التالية)\n\n- يكون نصيب كل شريك في الأرباح أو الخسائر بحسب حصته في رأس المال.\n\n- (في حال وجود شريك بحصة عمل، فيتم اختيار الآتي)\n\n يكون نصيب كل شريك في الأرباح أو الخسائر كما يلي:\n\n| م | اسم الشريك | نصيبه في الأرباح % | نصيبه في الخسائر % |\n| --- | --- | --- | --- |\n| 1 |  |  |  |\n| 2 |  |  |  |\n\n-  في حال فقد شريك مرخص له ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي:........................\n\n(يجب النص على كيفية توزيع الأرباح والخسائر بين الشركاء عند وقوع هذه الحالة)\n\nالمادة الحادية عشرة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها لدى السجل التجاري وتنتهي في ..../..../....14هـ الموافق ..../..../....20م وتكون كل سنة مالية بعد ذلك اثنى عشر شهراً (هجرية أو ميلادية).\n\nالمادة الثانية عشرة: التنازل عن الحصص وإدخال شركاء في الشركة: (مادة اختيارية)\n\n- التنازل عن الحصص:\n\n- يجوز للشريك الموصي أن يتنازل عن كل حصصه أو بعضها لأي من الشركاء الآخرين في الشركة.\n\n- يجوز للشريك الموصي أن يتنازل عن كل حصصه أو بعضها للغير وذلك بعد موافقة ................... (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو  الأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز إضافة شروط للتنازل)\n\n- يجوز للشريك المتضامن أن يتنازل عن كل حصصه أو بعضها لمصلحة شريك موص أو للغير وذلك بعد موافقة .................. (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين، أو  الأغلبية العددية لآراء الشركاء المتضامنين، أو بموافقة شريك أو أكثر يمثلون أكثر من نصف رأس المال، كما يجوز إضافة شروط للتنازل)\n\n- يجوز إدخال شركاء متضامنين إلى الشركة وذلك بعد موافقة ................ (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ودون الحاجة إلى الحصول على موافقة الشركاء الموصين، أو جميع الشركاء المتضامنين والموصين)\n\n- يجوز إدخال شركاء موصين إلى الشركة وذلك بعد موافقة ................ (يتعين الاختيار من أحد الخيارات التالية: جميع الشركاء المتضامنين ودون الحاجة إلى الحصول على موافقة الشركاء الموصين، أو جميع الشركاء المتضامنين والموصين)\n\nالمادة الثالثة عشرة: الترخيص المهني: (مادة اختيارية)\n\nإذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية ................... (يتعين اختيار أحد الخيارين التالية)\n\n\t-  عُد منسحباً من الشركة.\n\n\t-  يستمر بصفته شريك موصي غير مرخص له بممارسة المهنة في الشركة مع مراعاة الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من نظام الشركات.\n\nالمادة الرابعة عشرة: انقضاء الشركة:\n\n- تستمر الشركة بين باقي الشركاء في حال تم الحجر على أي من الشركاء المتضامنين، أو بافتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو بإخراجه، أو بانسحابه، وفي هذه الحالة، لا يكون لهذا الشريك إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\n- في حالة وفاة أي من الشركاء المتضامنين (يمكن اختيار أحد الخيارات التالية)\n\n\t\t-  فلا تنقضي الشركة وتستمر الشركة مع من يرغب من ورثة المتوفى، ولو كانوا قصرًا أو ممنوعين نظامًا من ممارسة الأعمال التجارية، ولا يُسأل ورثة الشريك القصر أو الممنوعون نظامًا من ممارسة الأعمال التجارية عن ديون الشركة في حال استمرارها إلا في حدود نصيب كل واحد منهم في حصة مورثهم في رأس مال الشركة. ويجب في هذه الحالة أن يكون القاصر أو الممنوع نظامًا من ممارسة الأعمال التجارية شريكًا موصيًا.\n\n\t\t- فلا تنقضي الشركة وتستمر الشركة بين باقي الشركاء، وفي هذه الحالة لا يكون لورثة الشريك المتوفى إلا نصيبه في أموال الشركة، ويقدر هذا النصيب وفقًا لحكم المادة (التاسعة والأربعين) من نظام الشركات.\n\n\t\t- فإن الشركة تنقضي بمجرد وفاته.\n\n- لا تنقضي الشركة بوفاة أي من الشركاء الموصين، ولا بالحجر عليه، ولا بإعساره، ولا بافتتاح أي من إجراءات التصفية تجاهه وفقاً لنظام الإفلاس، ولا بانسحابه. (يجوز استبدال النص في هذه الفقرة لتنص على انقضاء الشركة في حال تحقق أي من الحالات المذكورة)\n\nالمادة الرابعة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يتعد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولائحته التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولائحته التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n\t\tوالله ولي التوفيق\n\nالشركاء\n\nالشريك أول متضامن                                                         الشريك ثاني موصي"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل عقد تأسيس شركة توصية بسيطة مهنية بناءً على حكم قضائي", "desc": "تعديل العقد تنفيذاً لحكم قضائي.", "text": "نموذج رقم (....)\n\nتعديل عقد تأسيس بناء على حكم قضائي شركة ..............\n\n(توصية بسيطة مهنية)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\n- السيد/ ........................ الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن الأطراف المذكورين اعلاه هم المالكين لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر قرار شركاء مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل عقد التأسيس بناء على الحكم القضائي الصادر من (...) برقم (...) وتاريخ (...) وذلك بـ (منطوق الحكم)، وذلك وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة: ..............(شركة توصية بسيطة مهنية).\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيسي للشركة في مدينة (...) بالمملكة العربية السعودية، ويجوز نقل المركز إلى أي مدينة أخرى بالمملكة بعد موافقة الشركاء والجهات المعنية بالإشراف على المهنة الحرة محل نشاط الشركة (إن وجدت).\n\nالمادة الثالثة : أغراض الشركة:\n\nإن الأنشطة التي أسست الشركة لأجلها هي:\n\nممارسة مهنة (...)\n\n(ملحوظة: يجب أن يكون نشاط الشركة مهنيًّا)\n\nتخضع الشركة في ممارسة المهنة أو المهنة الحرة محل نشاطها لإشراف الجهة أو الجهات المعنية نظاماً بالإشراف على ممارسة تلك المهن. وتلتزم الشركة بالتقيد بأحكام الأنظمة واللوائح التي الجهة والجهات المعنية وفق اختصاصها. وتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: مدة الشركة:(الاختيار من أحد الخيارات)\n\n- مدة الشركة غير محددة.\n\n- مدة الشركة (........) سنة هجرية / ميلادية تبدأ من تاريخ قيدها بالسجل التجاري، ويجوز بموافقة جميع الشركاء تمديد مدتها.\n\nالمادة الخامسة: الإدارة:\n\n- تعيين (المدير/ المديرين):\n\n(في حال تعيين المدير أو المديرين في عقد التأسيس يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر)  (تحديد اسم المدير أو أسماء المديرين)، ويمثل (المدير / المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\n(في حال تعيين المدير أو المديرين في عقد مستقل يتعين النص على التالي):\n\nيتولى إدارة الشركة (مدير واحد/ مديرين أو أكثر) (يعينه/ يعينهم) الشركاء المتضامنين في عقد مستقل. ويمثل (المدير /المديرين) الشركة في علاقتها مع الغير وأمام القضاء وهيئات التحكيم.\n\nملحوظة: إذا تولى إدارة الشركة مدير واحد، فيجب أن يكون من الشركاء المرخص لهم، وإذا تولاها اثنان أو أكثر، فيجب ألا يقل عدد الشركاء المرخص لهم عن النصف في الإدارة.\n\n- صلاحيات (المدير / المديرين) و(سلطاته/سلطاتهم):\n\nملحوظة: تتضمن هذه الفقرة الصلاحيات والسلطات التي يمنحها الشركاء لمن يتولى إدارة الشركة، وآلية عمل الإدارة، والنصاب اللازم توافره لصحة صدور قرار الإدارة في حال تعدد المديرين. ويجب ألا تتضمن الصلاحيات أو السلطات الممنوحة للإدارة ما يخل باستقلالية الشركاء في ممارستهم لمهنهم الحرة. بالإضافة إلى عدم إيراد أي صلاحية تعد من الصلاحيات المحظورة على المدير بحسب المنصوص عليه في المادة 39 من النظام كافتتاح الفروع أو كفالة الشركة للغير، إلا إذا تم إدخال هذه الصلاحية من قبل الشركاء في العقد.\n\n- عزل (المدير/ المديرين):\n\nملحوظة: في حال كان المدير أو المديرين من الشركاء المتضامنين المعينين في عقد تأسيس الشركة أو في عقد مستقل، فيتعين الاختيار من النصوص الآتية وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير الشريك/ المديرين الشركاء) المعين في عقد تأسيس الشركة، إلا بقرار يصدر بإجماع الشركاء المتضامنين الآخرين.  (وإذا كان معين/ كانوا معينين في عقد مستقل) جاز عزله/ عزلهم بقرار يصدر من الأغلبية العددية للشركاء المتضامنين. (ملاحظة: يجوز الاتفاق على زيادة نصاب الأغلبية العددية في عزل المدير المعين في عقد مستقل.)\n\nملحوظة: في حال وجود مدير أو مديرين معينين في عقد تأسيس الشركة أو في عقد مستقل من غير الشركاء يتعين الاختيار من النصوص الآتية، وذلك وفقاً لطبيعة التعيين:\n\n- لا يجوز عزل (المدير غير الشريك/ المديرين غير الشركاء) إلا بقرار يصدر بالأغلبية العددية للشركاء المتضامنين (ملاحظة يمكن النص على أغلبية أعلى، ويشمل هذا النصاب المدير أو المديرين سواء كان معين أو كانوا معيين في عقد تأسيس الشركة أو في عقد مستقل طالما كانوا من غير الشركاء).\n\n(ج) (يتعين اختيار أحد الخيارين في حال عزل المدير):\n\n- يترتب على عزل المدير/ المديرين حل الشركة.\n\n- لا يترتب على عزل المدير/ المديرين حل الشركة.\n\n- مدة تولي الإدارة وتحديد مكافأة (المدير /المديرين):\n\nملحوظة: يُحدد في هذه الفقرة مدة تولي الإدارة، والمكافأة المستحقة، ولا يلزم النص على قيمة مبلغ المكافأة المقررة للمدير، ويمكن الاكتفاء بتحديد الآلية لكونها عرضة للتغيير. (جوازيه)\n\n- اعتزال المدير: (اختياري في حال كان التعين في عقد التأسيس)\n\nلمدير الشركة أن يعتزل من الإدارة، بشرط أن يبلغ الشركاء كتابة باعتزاله قبل موعد نفاذه بـ(ستين) يوماً، على الأقل. وإلا كان مسؤولاً عن تعويض الأضرار التي ترتبت على اعتزاله. (ملحوظة: هذا النص جوازي حيث يمكن للشركاء المتضامنين الاتفاق على غير ذلك، ومن ثم يمكن تعديل هذا النص.)\n\nالمادة السادسة: رأس المال:\n\nحدد رأس مال الشركة بـ ............. (ريال سعودي (يحدد كتابة ورقماً موزع على الشركاء كالتالي:\n\n1-  الشريك الأول، السيد / ...........وحصته قدرها (كتابة) (رقما) ريال سعودي ..........(يتعين الاختيار (نقدية) / (عينية تتمثل في .....)(....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال)، ويتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\n2-  الشريك الثاني، السيد / ...........وحصته قدرها (كتابة) (رقما)  ريال سعودي ..........( يتعين الاختيار (نقدية) / (عينية تتمثل في .....)/ (....ريال نقداً وعيناً تتمثل في الموجودات التالية...............بقيمة ......ريال).\n\nملاحظة: الجدول أدناه وضع لأجل التوضيح: حدد رأسمال الشركة بمبلغ مقداره (...) فقط، مقسم إلى (...) حصة نقدية متساوية القيمة، قيمة كل حصة (...) ريال، موزعة على الشركاء على النحو الآتي:\n\n| م | اسم الشريك | عدد الحصص | قيمة الحصة | الإجمالي |\n| --- | --- | --- | --- | --- |\n| 1 | (...) | 0 | 0 | 0 |\n| 2 | (...) | 0 | 0 | 0 |\n| الإجمالي |  | 0 | ــــــ | ــــــ |\n\nيقر الشركاء بتوزيع جميع حصص رأس المال فيما بينهم، والوفاء بقيمتها كاملة.\n\nملحوظة: في حال اتفاق الشركاء على أجل معين لوفائهم بالحصص، فيلزم تعديل النص بحيث يصبح كالآتي:\n\nيتعهد الشريك بالوفاء بحصته خلال (.....) يوم من تاريخ قيد الشركة في السجل التجاري.\n\nالمادة السابعة: ‌قرارات الشركاء:\n\n- تصدر قرارات الشركاء بالأغلبية العددية لآراء الشركاء المتضامنين، إلا إذا كان القرار متعلقاً بتعديل عقد تأسيس الشركة فيجب أن يصدر بإجماع الشركاء المتضامنين وموافقة مالكي أغلبية رأس المال الخاص بالشركاء الموصين.\n\n- يكون للشركة جمعية عامة تكون اختصاصاها وإجراءات انعقادها على النحو الآتي: (ملاحظة: النص يعد اختياري، وفي حال إضافته؛ فإنه يتعين على الشركاء إيراد اختصاصات الجمعية وإجراءات انعقادها أي نصاب الانعقاد وصحة صدور القرارات).\n\n- لا يجوز للشريك الموصي طلب حل الشركة أو الاشتراك في التصويت على المسائل الخاصة بتعيين أو عزل مديرها.\n\nالمادة الثامنة: توزيع الأرباح والخسائر:\n\n- يكون نصيب الشريك بالأرباح أو الخسائر بحسب نسبة حصته في رأس المال، وتحدد عند نهاية السنة المالية، وذلك من واقع قوائم مالية معدة وفقًا للمعايير المحاسبية المعتمدة في المملكة. (ملاحظة: يجوز النص على أحكام خاصة كتفاوت تقاسم الأرباح والخسائر بين الشركاء المتضامنين، وفي حال وجود شريك بالعمل فيجب أن يكون متضامن مرخص له، ويضاف نسبته في الأرباح وفقاً للملاحظة اللاحقة)\n\n- في حال فقد الشريك ترخيص ممارسة مهنته الحرة بصفة مؤقتة؛ فيكون توزيع الأرباح والخسائر على النحو الآتي:\n\nملحوظة: إضافة نص حر يترك كيفية توزيع الأرباح والخسائر المشار إليه في الفقرة (2) بين الشركاء، وذلك عند وقوع الحالة المشار إليها.\n\nملحوظة: في حال وجود شريك بالعمل؛ فيراعى كونه شريكًا متضامنًا من المرهص له، ومن ثم تضاف إلى ما سبق فقرة جديدة على النحو الآتي:\n\n- اتفق الشركاء على أن يكون نصيب الشريك بالعمل في الأرباح ما نسبته (---%).\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها في السجل التجاري وتنتهي في …./…/…  14هـ الموافق…../…./….20م   وتكون كل سنة مالية بعد ذلك اثنى عشر شهرا(ًميلادي / هجري )\n\nالمادة العاشرة: التنازل عن الحصص أو انسحاب الشريك أو اخراج أو إدخال شركاء:\n\n\t- التنازل عن الحصص:\n\n\t- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه لأي من الشركاء الآخرين في الشركة.\n\n- يجوز للشريك المتضامن أن يتنازل عن كل أو بعض حصصه لمصلحة شريك موصٍ أو للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- يجوز للشريك الموصي أن يتنازل عن كل أو بعض حصصه للغير بعد موافقة جميع الشركاء المتضامنين ومالكي أغلبية رأس المال الخاص بالشركاء الموصين.  (يجوز النص في العقد على قيود أخرى للتنازل).\n\n- ادخال شركاء في الشركة:\n\nيجوز اداخل شركاء متضامنين أو موصين إلى الشركة، بعد موافقة جميع الشركاء المتضامين دون الحاجة إلى الحصول على موافقة الشركاء الموصين. ( ملاحظة: النص المضلل يمكن أن يتم الاتفاق على خلافه في العقد بحيث يتم الاتفاق على نصاب آخر أو على شرط الحصول على موافقة الموصين،).\n\n- انسحاب الشريك أو إخراجه:\n\nيخضع الشركاء المتضامنين في الشركة للأحكام المطبقة على الشركاء في شركة التضامن، وذلك في حال وفاته أو بالحجر عليه أو بإعساره، أو بافتتاح أي من إجراءات التصفية تجاهه في شركة التضامن، أو بانسحابه أو إخراجه وتقدير نصيبه في أموال الشركة.\n\nالمادة الحادية عشرة: الترخيص المهني:\n\n\t- إذا فقد شريك ترخيص ممارسة مهنته الحرة بصفة مؤقته وجب عليه أن يمتنع فوراً عن العمل في الشركة بشكل فوري وكامل إلى حين استعادته الترخيص. وإذا كان هو الممارس الوحيد لتلك المهنة الحرة من بين الشركاء الآخرين، وجب على الشركة أن تتوقف عن ممارسة تلك المهنة إلى حين استعادته الترخيص.\n\n- إذا فقد شريك ترخيص ممارسة مهنته بصفة نهائية، (اختيار أحد الخيارين التالية):\n\n\t- عُد منسحباً من الشركة.\n\n\t- يستمر بصفته شريك موصي غير مرخص له بممارسة المهنة في الشركة مع مراعاة الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) من النظام.\n\nالمادة الثانية عشرة: انقضاء الشركة:\n\n- تنقضي الشركة بأحد أسباب الانقضاء العامة الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات.\n\n- لا يجوز للشركاء حل الشركة قبل مضي الأجل المحدد لها إلا بعد الإعلان عن ذلك وإبلاغ جميع المتعاملين معها كتابة بحسب الإجراءات بحسب الإجراءات المحددة نظاماً، مع مراعاة الشروط والضوابط التي تحددها الجهة أو الجهات المشرفة على المهن الحرة محل نشاط الشركة.\n\n- إذا توفي أحد الشركاء في الشركة... (ملحوظة: يجب الاختيار أحد النصين)\n\n- النص الأول في حال عدم دخول الورثة: \" تستمر الشركة بين باقي الشركاء، وتقدر قيمة حصة الشريك المتوفى من مقيم معتمد أو أكثر يعد تقريرًا يبين فيه القيمة العادلة لنصيب كل شريك في أموال الشركة في تاريخ وفاة الشريك. ولا يكون للورثة نصيب فيما يستجد بعد ذلك إلا بقدر ما تكون هذه الحقوق ناتجة عن عمليات سابقة على وفاة مورثهم\".\n\n- النص الثاني في حال دخول الورثة في حصة مورثهم: \" تؤول حصته إلى ورثته، ويكون للورثة في حال مشاركته صفة الشريك الموصي. ويجوز أن يكون الوريث شريكاً ممارساً لمهنته عن طريق الشركة؛ شريطة تحقق الشروط والضوابط والقواعد المشار إليها في الفقرة (4) من المادة (المائتين) والشروط المنصوص عليها في المادة (الثالثة عشرة بعد المائتين) من نظام الشركات.\n\n- يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية وفقاً لنظام الإفلاس:\n\n (ملحوظة: يجوز للشركاء تحديد ما يترتب على الحجر على الشريك المتضامن أو إعساره أو افتتاح أي من إجراءات التصفية تجاهه وفقًا لنظام الإفلاس، أو انسحابه أو إخراجه، كأن يتم الاتفاق على انقضاءها أو عدم انقضاء الشركة واستمرارها مع باقي الشركاء، شريطة بقاء شريك متضامن مرخص له في المهنة الحرة محل نشاط الشركة، أي لا يمكن إضافة هذا النص ما لم يكن هنالك أكثر من شريك متضامن مرخص له.)\n\nالمادة الثالثة عشرة: أحكام ختامية:\n\n- تخضع الشركة لأحكام الأنظمة واللوائح والقرارات السارية في المملكة العربية السعودية.\n\n- لا يعتد بأي نص خاص وارد في هذا العقد يخالف أحكام نظام الشركات ولوائحه التنفيذية، ويطبق بحقه ما ورد من نصوص في نظام الشركات ولوائحه التنفيذية، وكذلك كل ما لم يرد به نص خاص في هذا العقد.\n\n-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬\n\nالمادة الرابعة عشرة: نسخ العقد:\n\nحرر هذا العقد من (---) نسخ، تسلم كل شريك نسخة منها للعمل بموجبها.\n\n| م | اسم الشريك | التوقيع |\n| --- | --- | --- |\n| 1 | ... |  |\n| 2 | ... |  |\n| 3 | ... |  |\n\nتم اعتماد هذا العقد لدى (---) برقم (---) وتاريخ  / /\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nالطرف الأول                                              الطرف الثاني\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار الشركاء، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "تعديل عقود الشركات", "icon": "", "title": "تعديل النظام الأساس لشركة محدودة شخص واحد بناءً على حكم قضائي", "desc": "تعديل النظام الأساس تنفيذاً لحكم قضائي.", "text": "نموذج رقم (....)\n\nتعديل نظام اساس بناء على حكم قضائي شركة\n\n(شركة ذات مسؤولية محدودة من شخص واحد)\n\n- السيد/ ....................... الهوية رقم ....................... تاريخ الميلاد ....................... الجنسية .......................\n\nحيث أن المالك المذكور اعلاه لشركة (...) والمقيدة بالرقم الموحد للمنشأة (...) وتاريخ (...) والمثبت عقد تأسيسها لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وكان أخر نظام اساس مثبت لدى كاتب عدل (...) أو عن طريق (أبشر) أو (معتمد وزارة) وتاريخ (...) وقد تقرر تعديل نظام الاساس بناء على الحكم القضائي الصادر من (...) برقم (...) وتاريخ (...) وذلك بـ (منطوق الحكم)، وذلك وفقاً لنظام الشركات الصادر بالمرسوم الملكي رقم (م/132) وتاريخ01/12/1443هـ، ولوائحه التنفيذية\n\nوأصبحت بنود عقد التأسيس كما يلي:\n\nالمادة الأولى: اسم الشركة:\n\nشركة   ............  (شركة ذات مسؤولية محدودة من شخص واحد)\n\nالمادة الثانية: المركز الرئيس للشركة:\n\nيكون المركز الرئيس للشركة في مدينة…\n\n\tالمادة الثالثة: أغراض الشركة:\n\n1-\n\n2-\n\nوتمارس الشركة أغراضها وفق الأنظمة المتبعة وبعد الحصول على التراخيص اللازمة من الجهات المختصة إن وجدت.\n\nالمادة الرابعة: رأس المال:\n\nحدد رأس مال الشركة بـ (بالأرقام العربية) ريال (مكتوب بالأحرف) ريال مقسم إلى (....) حصة، متساوية القيمة قيمة كل حصة (.........) ريال وفق ما يلي:\n\n| بيان | عدد الحصص  | عدد الحصص  | قيمة الحصة | قيمة الحصص | طريقة الوفاء بها |\n| --- | --- | --- | --- | --- | --- |\n|  |  |  |  |  | نقداً |\n|  |  |  |  |  | عيناً |\n| الإجمالي |  |  |  |  |  |\n\n(في حال وجود حصص نقدية يتعين النص على التالي):\n\nويقر مالك رأس المال بأنه تم الوفاء بقيمتها كاملة.\n\n(في حال وجود حصص عينية تتجاوز قيمتها نصف رأس المال يجب تقييمها من مقيم معتمد ويضاف في العقد النص التالي:)\n\nوتم تقييم الحصص العينية بموجب تقييم المقيم المعتمد المرفق في طلب التأسيس، ووافق مالك رأس المال على قيمة الحصص العينية والمقابل المحدد لها. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد)\n\n(في حال وجود حصص عينية لا تتجاوز قيمتها نصف رأس المال فلا يشترط تقييمها من مقيم معتمد، وفي حال عدم تقييمها من مقيم معتمد يضاف في العقد النص التالي:)\n\nويقر مالك رأس المال بأنه مسؤول شخصيًّا في جميع أمواله في مواجهة الغير عن عدالة تقدير قيمة الحصص العينية كما في البيان المرفق في طلب التأسيس. (يمكن إضافة جدول الأصول العينية وقيمتها في العقد).\n\nالمادة الخامسة: زيادة أو تخفيض رأس المال:\n\n1. يجوز لمالك رأس المال زيادة رأس مال الشركة عن طريق رفع القيمة الاسمية للحصص أو إصدار حصص جديدة.\n\n2. لمالك رأس المال أن يقرر تخفيض رأس المال إذا زاد على حاجة الشركة أو إذا مُنيت بخسائر وفقاً للأحكام النظامية المقررة.\n\nالمادة السادسة: إدارة الشركة:\n\n\tيتولى إدارة الشركة ... (يتعين اختيار أحد الخيارات التالية): -\n\n\t- ....................  (تحديد اسم المدير)\n\nوله السلطات والصلاحيات التالية.........................\n\n(يجوز تعيين المدير بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- ............ و....................... (تحديد أسماء المديرين)\n\n       ولهما السلطات والصلاحيات التالية: ...................\n\n(يجوز تعيين المدراء بعقد مستقل متضمنا السلطات والصلاحيات)\n\n\t- (أ) مجلس مديرين مكون من (لا يقل عن 3) وهم :\n\n- ............\n\n- ..............\n\n- ............\n\n\t           ب - (يحدد طريقة العمل في مجلس المديرين والأغلبية اللازمة لقراراته)\n(يجوز تعيين المجلس بعقد مستقل متضمنا طريقة العمل والاغلبية اللازمة لقراراته)\n\n\tالمادة السابعة: التبليغات التي توجهها الشركة إلى مالك رأس المال: (في حال كان المدير من غير مالك رأس المال)\n\nتكون التبليغات التي توجهها الشركة إلى مالك رأس المال عن طريق أي من الوسائل الآتية:\n\n- إرسالها بخطابات مسجلة.\n\n- التسليم شخصيًّا أو من ينوب عنهم نظامًا.\n\n- إرسالها بالبريد الإلكتروني أو بأي من وسائل التقنية الحديثة.\n\n( يجوز اختيار واحد أو أكثر من الوسائل المشار إليها أو أي وسائل أخرى بموافقة مالك رأس المال)\n\nالمادة الثامنة: صلاحيات مالك رأس المال :\n\nيكون لمالك رأس المال الصلاحيات والسلطات المنصوص عليها في نظام الشركات، وتصدر قراراته كتابة، وتدون في سجل خاص لدى الشركة.\n\nالمادة التاسعة: السنة المالية:\n\nتبدأ السنة المالية الأولى للشركة من تاريخ قيدها بالسجل التجاري وتنتهي في ...../...../....14هـ الموافق ...../...../.....20م وتكون كل سنة مالية بعد ذلك أثنى عشر شهراً. (يجوز النص على أن تكون السنة ميلادية أو هجرية).\n\nالمادة العاشرة: الأرباح والخسائر:\n\n1. يجوز توزيع أرباح سنوية أو مرحلية من الأرباح القابلة للتوزيع على مالك رأس المال، وفقا للضوابط النظامية المقررة.\n\n2. توزع أرباح الشركة السنوية الصافية على النحو التالي:\n\n\t- تجنب نسبة (....%) من صافي الأرباح السنوية لتكوين احتياطي يخصص لغرض..............(هذا البند اختياري)\n\n\t- يحدد مالك رأس المال النسبة التي يجب توزيعها من الأرباح الصافية بعد خصم الاحتياطيات (إن وجدت).\n\nالمادة الحادية عشرة: انقضاء الشركة:\n\nتنقضي الشركة بأحد أسباب الانقضاء الواردة في المادة (الثالثة والأربعون بعد المائتين) من نظام الشركات وبانقضائها تدخل في دور التصفية وفقا لأحكام الباب الثاني عشر من نظام الشركات، وإذا انقضت الشركة وكانت أصولها لا تكفي لسداد ديونها أو كانت متعثرة وفقًا لنظام الإفلاس، وجب عليها التقدم إلى الجهة القضائية المختصة لافتتاح أي من إجراءات التصفية بموجب نظام الإفلاس.\n\nالمادة الثانية عشرة: أحكام ختامية:\n\n- تخضع الشركة لكافة الأنظمة السارية في المملكة العربية السعودية.\n\n\t- أي نص يخالف أحكام نظام الشركات في هذا النظام الأساس لا يعتد به ويطبق بحقه ما ورد من نصوص في نظام الشركات وكل ما لم يرد به نص في هذا العقد يطبق بشأنه نظام الشركات ولوائحه التنفيذية.\n\n\t-  تعهد : يقر مالك رأس المال ، الشركاء ، المساهمون، الأعضاء ، بصحة البيانات والأحكام المدرجة في عقد التأسيس محل هذا الطلب واتفاقها مع احكام نظام الشركات الصادر بالمرسوم الملكي (م/132) بتاريخ 1/12/1443هـ ولوائحه التنفيذية، واستيفاءها لجميع المتطلبات والتعليمات التي تصدرها الوزارة وفقاً لأحكام النظام، ويتحمل مالك رأس المال ،الشركاء، المساهمون، الأعضاء ، المسؤولية وجميع التبعات النظامية والمالية التي قد تنشأ عن ذلك، ولا تتحمل الوزارة أي مسؤولية عن عدم صحة البيانات والأحكام المدرجة أو عدم موافقتها لأحكام نظام الشركات ولوائحه التنفيذية والمتطلبات أو التعليمات التي تصدرها الوزارة. كما ان مالك رأس المال، الشركاء ، المساهمون، الأعضاء ،على علم بحق الوزارة في اتخاذ الإجراءات النظامية اللازمة في حال وجود أي مخالفة أو تعارض في الأحكام الواردة في هذا العقد / أو القرار/ أو النظام الاساس‬‬‬‬‬‬‬\n\n\t\tوالله ولي التوفيق،،\n\nالاسم: ..........\n\nمالك رأس المال\n\nملحق عقد تأسيس\n\n(ملحق)\n\n- تعديل (تحديد اسم المادة المراد تعديلها):\n\nقبل التعديل:\n\nبعد التعديل:\n\nمالك رأس المال\n\nالاسم:\n\nوقد تم اعتماد/ توثيق هذا العقد/ قرار مالك رأس المال، من قبل الموظف المختص/ كاتب العدل"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد نظافة المدن", "desc": "نموذج حكومي معتمد (59 صفحة).", "pdf": "templates/city-cleaning.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد التشغيل والصيانة للمباني الإدارية (التعاقد القائم على الأداء)", "desc": "نموذج حكومي معتمد (63 صفحة).", "pdf": "templates/fm-admin-buildings.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد التوريد (عسكري)", "desc": "نموذج حكومي معتمد (57 صفحة).", "pdf": "templates/military-supply.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد إنشاء الطرق", "desc": "نموذج حكومي معتمد (66 صفحة).", "pdf": "templates/roads-construction.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد تقنية المعلومات", "desc": "نموذج حكومي معتمد (57 صفحة).", "pdf": "templates/it-contract.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد تشغيل وصيانة الطرق", "desc": "نموذج حكومي معتمد (65 صفحة).", "pdf": "templates/roads-om.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد الإعاشة", "desc": "نموذج حكومي معتمد (56 صفحة).", "pdf": "templates/catering.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد الخدمات الهندسية (الإشراف)", "desc": "نموذج حكومي معتمد (75 صفحة).", "pdf": "templates/eng-supervision.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد التشغيل والصيانة", "desc": "نموذج حكومي معتمد (64 صفحة).", "pdf": "templates/operation-maintenance.pdf"}, {"cat": "عقود حكومية", "icon": "", "title": "نموذج عقد الإنشاءات العامة", "desc": "نموذج حكومي معتمد (84 صفحة).", "pdf": "templates/general-construction.pdf"}]);
let curTpl=null, curCat='الكل';
const cats=['الكل',...new Set(TPL.map(t=>t.cat))];

function renderTpl(){
  $('chips').innerHTML=cats.map(c=>`<button data-c="${c}" class="px-4 py-2 rounded-full text-sm font-bold border transition ${c===curCat?'btn-main border-transparent':'bg-white border-[#C9D4EA] text-[var(--indigo)] hover:bg-[#EEF3FA]'}">${c}</button>`).join('');
  $('tplGrid').innerHTML=TPL.map((t,i)=>({t,i})).filter(({t})=>curCat==='الكل'||t.cat===curCat).map(({t,i})=>`
   <div class="glass acc rounded-2xl p-6 flex flex-col hover:-translate-y-1 transition">
     <div class="w-12 h-1.5 rounded-full mb-4" style="background:linear-gradient(135deg,var(--indigo),var(--gold))"></div>
     <h3 class="font-extrabold text-lg">${t.title}</h3>
     <p class="text-sm text-[var(--muted)] mt-2 leading-7 flex-1">${t.desc}</p>
     <div class="mt-5 flex gap-2">${t.pdf
       ? `<a href="${t.pdf}" target="_blank" rel="noopener" class="btn-ghost px-4 py-2 text-sm flex-1 text-center">فتح النموذج (PDF)</a>`
       : `<button data-v="${i}" class="btn-ghost px-4 py-2 text-sm flex-1">عرض النموذج</button><button data-u="${i}" class="btn-gold px-4 py-2 text-sm">دقّق</button>`}
     </div></div>`).join('');
}
$('chips').addEventListener('click',e=>{const c=e.target.dataset.c; if(c){curCat=c;renderTpl();}});
$('tplGrid').addEventListener('click',e=>{
  const v=e.target.dataset.v,u=e.target.dataset.u;
  if(v!==undefined) openTpl(+v); if(u!==undefined) useTpl(+u);
});
function openTpl(i){curTpl=TPL[i];$('mTitle').textContent=curTpl.title;$('mText').textContent=curTpl.text;$('tplModal').classList.remove('hidden');}
function closeTpl(){$('tplModal').classList.add('hidden');}
function useTpl(i){
  const t=TPL[i]||curTpl; closeTpl();
  if(memoDone&&!busy){ resetChat(); welcome(); }
  contractEl.value=t.text; updateCount();
  $('assistant').scrollIntoView({behavior:'smooth'}); toast('أُدرج النموذج في مساعد مُحكَم');
}
$('mClose').onclick=closeTpl;
$('tplModal').addEventListener('click',e=>{if(e.target.id==='tplModal')closeTpl();});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeTpl();});
$('mUse').onclick=()=>useTpl(TPL.indexOf(curTpl));
$('mCopy').onclick=async()=>{try{await navigator.clipboard.writeText(curTpl.text);toast('تم نسخ النموذج');}catch{toast('تعذّر النسخ');}};
$('mPrint').onclick=()=>{
  const w=window.open('','_blank');
  w.document.write(`<html dir="rtl" lang="ar"><head><meta charset="utf-8"><link rel="icon" href="logo.jpg"><title>${curTpl.title}</title><style>body{font-family:Tajawal,sans-serif;padding:40px;line-height:2.1;white-space:pre-wrap}</style></head><body>${curTpl.text.replace(/</g,'&lt;')}</body></html>`);
  w.document.close(); w.focus(); w.print();
};
renderTpl();

/* =====================================================================
   مُحكم v2 — الوحدات (Modules). كل وحدة مستقلة ويمكن إضافة مزايا جديدة بسهولة.
   ===================================================================== */

/* تعليمات الصياغة القانونية السعودية الرصينة */
const SAUDI_DRAFTING_SYSTEM_PROMPT = `أنت مستشار قانوني سعودي ضليع، وصائغ تشريعي رفيع البيان، متمرس في الصياغة العقدية والنظامية المستمدة من أمهات الكتب الفقهية، وتسبيبات الأحكام القضائية في المحاكم السعودية، ومرئيات هيئة الخبراء بمجلس الوزراء، وأحكام نظام المعاملات المدنية والأنظمة السعودية ذات الصلة.
المهمة: إعادة صياغة النص أو البند المدخل (الركيك أو العامي أو الغامض أو المترجم حرفياً) بلغة قانونية سعودية رصينة جزلة قاطعة الدلالة تمنع التأويل وتدرأ النزاع.
القواعد: (1) الرصانة والجزالة القضائية: حيث إنه من المقرر شرعاً ونظاماً، وتأسيساً على ما تقدم، وإعمالاً لقاعدة أن العقد شريعة المتعاقدين، وبما لا يخل بالنظام العام وحسن النية. (2) القطعية: استبدل الألفاظ الاحتمالية بأفعال الإلزام (يلتزم، يتعهد، ينحصر، يسقط حقه، يُعدّ إخلالاً جوهرياً، ينفسخ تلقائياً)، وانضبط بالمدد والمبالغ والأماكن وتجنب الألفاظ المطاطة (قريباً، مبلغ مناسب، حسب الاتفاق) واستبدلها بصيغ منضبطة مثل: خلال مدة أقصاها [عدد] أيام عمل بموجب إشعار خطي موثق. (3) التأصيل: استخدم مصطلحات نظام المعاملات المدنية (الإيجاب والقبول، القوة القاهرة، الظروف الطارئة، التعويض الاتفاقي، الفسخ، الإقالة، الضمان، الغرر، الإذعان، التضامن) واستحضر القواعد الفقهية (لا ضرر ولا ضرار، الغرم بالغنم، العبرة في العقود للمقاصد والمعاني). (4) تجنب الحشو، واربط الجمل بأدوات نظامية (شريطة أن، ما لم، على أن، مع عدم الإخلال بـ).
(5) الأمانة للنص: صُغ بنداً واحداً بنفس موضوع النص ومضمونه تماماً، دون إضافة غرامات أو نسب أو شروط أو التزامات أو حالات فسخ لم ترد فيه، ودون حيثيات أو تسبيب داخل القسم الأول. وإن كان النص سليماً فأعده كما هو مع ضبط الألفاظ فقط، وإن كان ناقصاً فاستعمل أقواساً مثل ([المدة]) ولا تخترع أرقاماً. (6) يجب أن يصلح الناتج للاستبدال المباشر مكان النص الأصلي.
الرد في ثلاثة أقسام فقط دون مقدمات، بهذه العناوين بالضبط:
1. الصياغة القانونية المحكمة:
2. مواطن التحسين والضبط الصياغي: (نقاط موجزة)
3. الأساس النظامي أو القاعدة الأصولية: (باختصار، إن وجد)`;

const Dom = {
  show:(id,on=true)=>$(id).classList.toggle('hidden',!on),
  sel:()=>{ const s=contractEl.selectionStart,e=contractEl.selectionEnd; return e>s?{s,e,text:contractEl.value.slice(s,e)}:null; }
};

/* ---------- التنقل بين التبويبات + النفاذ الوطني (تجريبي) ---------- */
const NavModule=(()=>{
  const views=['home','library','assistant','advisors','dash'];
  function go(v,anchor){
    if(anchor==='templates'){v='library';anchor=null;} else if(anchor==='assistant'){v='assistant';anchor=null;}
    views.forEach(x=>Dom.show('view-'+x,x===v));
    document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.view===v));
    if(v==='dash') DashboardModule.render();
    if(v==='advisors'&&window.AdvisorsRefresh) AdvisorsRefresh();
    window.scrollTo({top:0});
    if(anchor) setTimeout(()=>$(anchor).scrollIntoView({behavior:'smooth'}),30);
  }
  const menu=$('tabs'), mbtn=$('menuBtn');
  const setMenu=o=>{ menu.classList.toggle('open',o); mbtn.setAttribute('aria-expanded',o); };
  mbtn.addEventListener('click',e=>{ e.stopPropagation(); setMenu(!menu.classList.contains('open')); });
  menu.addEventListener('click',e=>{ const b=e.target.closest('.tab'); if(b&&b.dataset.view){ go(b.dataset.view,b.dataset.anchor); setMenu(false); } });
  $('loginBtn').addEventListener('click',()=>{ setMenu(false); toast('خدمة تسجيل الدخول ستتوفر قريباً'); });
  document.addEventListener('click',e=>{ if(!menu.contains(e.target)) setMenu(false); });
  document.addEventListener('keydown',e=>{ if(e.key==='Escape') setMenu(false); });
  document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]'); if(!a) return; const id=a.getAttribute('href').slice(1); if(['templates','assistant'].includes(id)){ e.preventDefault(); go('home',id);} });
  return {go};
})();

/* ---------- عدّاد الإحصائيات ---------- */
(function StatsModule(){
  const els=[...document.querySelectorAll('#stats .num')];
  const run=el=>{ const n=+el.dataset.count,pre=el.dataset.pre||'',suf=el.dataset.suf||''; const t0=performance.now(); const step=t=>{const p=Math.min(1,(t-t0)/1400);el.textContent=pre+Math.round(n*(1-Math.pow(1-p,3)))+suf; if(p<1)requestAnimationFrame(step);}; requestAnimationFrame(step); };
  if(!('IntersectionObserver' in window)) return;
  const io=new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){run(x.target);io.unobserve(x.target);}}),{threshold:.4});
  els.forEach(e=>io.observe(e));
})();

/* ---------- إخفاء البيانات الحساسة (Client-side Regex) ---------- */
const PrivacyModule=(()=>{
  let original=null;
  const D='[0-9٠-٩]', nb='(?<![0-9٠-٩A-Za-z])', na='(?![0-9٠-٩])';
  /* الترتيب مهم: الأخص أولاً */
  const RULES=[
    {tag:'[بريد_مخفي]',re:/[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/g},
    {tag:'[آيبان_مخفي]',re:/(?<![A-Za-z0-9])SA\s?\d{2}(?:\s?[0-9A-Za-z]{4}){5}(?![0-9A-Za-z])/gi},
    {tag:'[جوال_مخفي]',re:new RegExp(nb+'(?:\\+?966\\s?|00966\\s?)5'+D+'{8}'+na+'|'+nb+'05'+D+'{8}'+na,'g')},
    {tag:'[هوية_مخفية]',re:new RegExp(nb+'[12'+'١٢]'+D+'{9}'+na,'g')},
    {tag:'[سجل_تجاري_مخفي]',re:new RegExp(nb+'[74'+'٧٤]'+D+'{9}'+na,'g')}
  ];
  /* كشف الأسماء بالأنماط (الصفات، الألقاب، النسب، الجهات) */
  const AR='[\\u0621-\\u064A]';
  const STOP=/\s+(?:هوية|هويته|سجل|رقم|يحمل|بطاقة|الجنسية|جوال|الكائن|الكائنة|عنوان|ويمثلها|ويمثله|ممثلاً|ممثلة|المسجلة|المسجل|المقيم|المقيمة|السعودي|السعودية|والمسجل|ومقرها|مقرها|بصفته|بصفتها|المشار|الملقب|بموجب|والذي|والتي)(?:\s|$)[\s\S]*$/;
  const clean=n=>n.replace(/[،,؛;:(\[].*$/,'').replace(STOP,'').trim();
  const okName=n=>n&&!/[_.\[\]]{2,}/.test(n)&&/[\u0621-\u064AA-Za-z]{2}/.test(n)&&n.split(/\s+/).length<=7;
  const LABEL=/((?:الطرف\s+(?:الأول|الثاني)|الشريك\s+(?:الأول|الثاني)|المؤجر|المستأجر|البائع|المشتري|الموكل|الوكيل|المقاول|صاحب\s+العمل|الكفيل|العميل|المورِّد|المورد|الموظف|العامل|المالك|الدائن|المدين|الضامن|الاسم)\s*[:：]\s*)([^\n]{2,90})/g;
  const TITLE=new RegExp('(?<!'+AR+')((?:السيد|السيدة|الأستاذ|الأستاذة|الدكتور|الدكتورة|المهندس|المهندسة|المدعو|المدعوة|الشيخ)\\s*/?\\s*)('+AR+'{2,}(?:\\s+'+AR+'{2,}){0,3})','g');
  const LINE=new RegExp('(?<!'+AR+')(?:عبد\\s+)?'+AR+'{2,}(?:\\s+(?:بن|بنت|ابن)\\s+'+AR+'{2,}){1,4}(?:\\s+(?:آل\\s+)?ال'+AR+'{2,})?','g');
  const CORP=new RegExp('(?<!'+AR+')(?:شركة|مؤسسة|مصنع|مكتب)\\s+(?!تضامن|توصية|مساهمة|ذات|مهنية|مدنية|أجنبية|قابضة|فرد|الشخص|الأم)'+AR+'['+'\\u0621-\\u064A\\s'+']{1,40}?(?=[،,.(\\n:؛]|\\s+(?:سجل|بموجب|ويمثلها|ويمثله|المسجلة|الكائن|ومقرها|مقرها|رقم|هوية|والتي|الذي|التي)|$)','gm');
  function NAME_PASS(t,names,bump){
    const T='[اسم_مخفي]';
    t=t.replace(LABEL,(m,pre,rest)=>{ const lead=rest.match(/^\s*/)[0], r2=rest.slice(lead.length), n=clean(r2); if(!okName(n)) return m; names.add(n); bump(T); return pre+lead+T+r2.slice(n.length); });
    t=t.replace(TITLE,(m,pre,rest)=>{ let w=clean(rest).split(/\s+/); const k=w.findIndex((x,i)=>i>0&&/^(?:و|في|من|على|الذي)/.test(x)); if(k>0) w=w.slice(0,k); const n=w.join(' '); if(!n||/^ال/.test(n)||n.length<3) return m; names.add(n); bump(T); return pre+T+rest.slice(n.length); });
    t=t.replace(LINE,m=>{ names.add(m.trim()); bump(T); return T; });
    t=t.replace(CORP,m=>{ names.add(m.trim()); bump('[جهة_مخفية]'); return '[جهة_مخفية]'; });
    return t;
  }
  function mask(){
    const t=contractEl.value; if(!t.trim()){toast('لا يوجد نص لإخفائه');return;}
    let out=t,total=0; const per={};
    const bump=(tag)=>{total++;per[tag]=(per[tag]||0)+1;};
    /* 1) أسماء الأشخاص والجهات: تحديد يدوي ثم الأنماط الذكية */
    const sel=Dom.sel(); const names=new Set();
    if(sel&&sel.text.trim().length>=2&&sel.text.length<=60&&!/\n/.test(sel.text)) names.add(sel.text.trim());
    out=NAME_PASS(out,names,bump);
    names.forEach(n=>{ if(n.length<3) return; const parts=out.split(n); if(parts.length>1){ for(let i=1;i<parts.length;i++) bump('[اسم_مخفي]'); out=parts.join('[اسم_مخفي]'); } });
    RULES.forEach(r=>{ out=out.replace(r.re,()=>{total++;per[r.tag]=(per[r.tag]||0)+1;return r.tag;}); });
    if(!total){ Dom.show('privNote',true); $('privNote').textContent='لم تُرصد بيانات حساسة في النص.'; return; }
    if(original===null) original=t;
    contractEl.value=out; updateCount();
    $('privNote').innerHTML='أُخفيت تلقائياً قبل الإرسال <b>'+total.toLocaleString('ar-SA')+'</b> عنصراً: '+Object.entries(per).map(([k,v])=>k+' ×'+v).join(' · ');
    Dom.show('privNote',true);
  }
  function restore(){ if(original===null){toast('لا يوجد نص أصلي لاستعادته');return;} contractEl.value=original; original=null; updateCount(); Dom.show('privNote',false); toast('تمت استعادة النص الأصلي'); }
  $('btnHighlight').onclick=()=>{ if(!memoDone){toast('أرسل العقد للتدقيق أولاً لتظليل مواضع المرئية');return;} showHighlighted({}); };
  return {mask,restore};
})();

/* ---------- قياس توازن العقد ---------- */
const BalanceModule=(()=>{
  const F1=/يحق\s+للطرف\s+الأول|يلتزم\s+الطرف\s+الثاني|لا\s+يتحمل\s+الطرف\s+الأول|يتنازل\s+الطرف\s+الثاني|لا\s+يحق\s+للطرف\s+الثاني|(?:يحدده|يراه|يختاره|يقدّره|يقدره)\s+الطرف\s+الأول|الطرف\s+الأول\s+(?:وحده|منفرداً)|يتحمل\s+الطرف\s+الثاني/g;
  const F2=/يحق\s+للطرف\s+الثاني|يلتزم\s+الطرف\s+الأول|لا\s+يتحمل\s+الطرف\s+الثاني|يتنازل\s+الطرف\s+الأول|لا\s+يحق\s+للطرف\s+الأول|(?:يحدده|يراه|يختاره|يقدّره|يقدره)\s+الطرف\s+الثاني|الطرف\s+الثاني\s+(?:وحده|منفرداً)|يتحمل\s+الطرف\s+الأول/g;
  function measure(t){ const a=(t.match(F1)||[]).length,b=(t.match(F2)||[]).length; const p1=Math.round(100*(a+1)/(a+b+2)); return {a,b,p1,p2:100-p1}; }
  function show(){
    const t=contractEl.value||baseContract; if(!t.trim()){toast('أدخل نص العقد أولاً');return;}
    const {a,b,p1,p2}=measure(t); const hi=p1>=p2?1:2, pc=Math.max(p1,p2), lo=100-pc;
    const gap=Math.abs(p1-p2);
    const rec = (a+b)===0 ? 'لم تُرصد مؤشرات انحياز صريحة؛ راجع المذكرة للتأكد.'
      : gap<=20 ? 'العقد متوازن نسبياً؛ يكفي ضبط المدد والإشعارات.'
      : 'يُوصى بإضافة حقوق مقابلة للطرف '+(hi===1?'الثاني':'الأول')+' (إنهاء بإشعار، تعويض متبادل، حد أعلى للغرامة) لتحقيق التوازن العقدي.';
    $('balPanel').innerHTML=`<div class="font-extrabold">توازن العقد</div>
      <div class="bal-bar"><i style="width:${p1}%;background:#2f7a78"></i><i style="width:${p2}%;background:#8DA7C7"></i></div>
      <div class="text-sm">${(a+b)===0?'':'يميل العقد لصالح الطرف '+(hi===1?'الأول':'الثاني')+' بنسبة <b>'+pc+'%</b> مقابل <b>'+lo+'%</b> للطرف '+(hi===1?'الثاني':'الأول')+'. '}<span style="color:#5d6a8a">(الأول ${p1}% · الثاني ${p2}%)</span></div>
      <div class="text-sm mt-2">${rec}</div>`;
    Dom.show('balPanel',true);
  }
  $('btnBalance').onclick=show;
  return {measure,show};
})();

/* ---------- مُحسِّن الصياغة ---------- */
const BUSY_MSG='الخدمة مشغولة حالياً، يرجى المحاولة بعد قليل.';
function friendlyErr(res,msg){
  const m=String(msg||'');
  if((res&&(res.status===429||res.status>=500))||/quota|limit|token|rate|exceed|insufficient|طاقة|حصة|الحد|انتهت|رصيد/i.test(m)) return BUSY_MSG;
  return m;
}
const DraftingImproverModule=(()=>{
  function parse(ans){
    const s=String(ans||'').replace(/\*\*|__/g,''); const i2=s.search(/مواطن\s+التحسين/), i3=s.search(/الأساس\s+النظامي/);
    const clean=x=>x.replace(/^[\s\d.\-*#:«»]+/,'').trim();
    const head=(i2>0?s.slice(0,i2):s).replace(/^\s*(?:#+\s*|\*+\s*)?1?\.?\s*\**\s*الصياغة\s+القانونية\s+المحكمة[^\n]*\n?/,'').replace(/\n[\s\d.#*]*$/,'');
    const notes=i2>=0?(s.slice(i2,i3>i2?i3:undefined).split('\n').slice(1).map(l=>l.replace(/^[\s\-*•]+/,'').trim()).filter(Boolean)):[];
    const basis=i3>=0?clean(s.slice(i3).split('\n').slice(1).join(' ')):'';
    return {rewrite:clean(head)||s.trim(),notes,basis};
  }
  /* يتحقق أن الناتج بند واحد صالح للاستبدال وليس دراسة كاملة */
  function valid(p,src){
    const r=(p.rewrite||'').trim();
    if(!r) return false;
    if(/مواطن\s+التحسين|الأساس\s+النظامي|مذكرة\s+التدقيق|^\s*#/m.test(r)) return false;
    if(r.length>Math.max(src.length*3,src.length+500)||r.length>1500) return false;
    return true;
  }
  async function improve(text){
    try{
      const r=await fetch(PROXY_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_role:'الطرف الأول',contract_text:text,query:SAUDI_DRAFTING_SYSTEM_PROMPT+'\n\nالنص المطلوب تحسينه:\n'+text,conversation_id:'',user_id:USER_ID,want_flaws:false})});
      const d=await r.json().catch(()=>({}));
      if(!r.ok||!d.answer) return {error:true};
      const p=parse(d.answer);
      if(!valid(p,text)) return {error:true};
      return {...p,error:false};
    }catch{ return {error:true}; }
  }
  function card(r,adoptId){
    if(r.error) return `<div class="text-sm" style="line-height:1.9">تعذّر تحسين الصياغة الآن. ${BUSY_MSG}</div>`;
    return `<div class="font-extrabold mb-1">الصياغة القانونية المحكمة</div><div class="impr-res">${esc(r.rewrite)}</div>
      <div class="font-extrabold mt-3 mb-1">مواطن التحسين والضبط الصياغي</div><ul class="text-sm" style="list-style:disc;margin-right:1.2rem;line-height:1.9">${(r.notes.length?r.notes:['تم ضبط الصياغة.']).map(n=>'<li>'+esc(n)+'</li>').join('')}</ul>
      ${r.basis?'<div class="text-sm mt-2"><b>الأساس:</b> '+esc(r.basis)+'</div>':''}
      <div class="mt-3 flex gap-2"><button type="button" class="btn-main px-4 py-2 text-sm" id="${adoptId}">اعتماد الصياغة في العقد</button></div>`;
  }
  let sel=null;
  async function openChat(){
    const s=Dom.sel(); const text=(s?s.text:contractEl.value).trim();
    if(!text){toast('حدد بنداً أو الصق نصاً أولاً');return;}
    if(text.length>4000){toast('حدد بنداً واحداً (حتى 4000 حرف)');return;}
    sel=s; const p=$('imprPanel'); Dom.show('imprPanel',true);
    p.innerHTML='<span class="dots"><span></span><span></span><span></span></span> جارٍ تحسين الصياغة…';
    const r=await improve(text); p.innerHTML=card(r,'adoptChat');
    const ad=$('adoptChat'); if(!ad) return;
    ad.onclick=()=>{
      if(sel){ contractEl.value=contractEl.value.slice(0,sel.s)+r.rewrite+contractEl.value.slice(sel.e); } else contractEl.value=r.rewrite;
      updateCount(); Dom.show('imprPanel',false); toast('تم اعتماد الصياغة في العقد');
    };
  }
  $('btnImprove').onclick=openChat;
  return {improve,card,parse};
})();

/* ---------- مكتبة النماذج: التعبئة الذكية بالخطوات / التعديل اليدوي ---------- */
const TemplatesModule=(()=>{
  let mode='stepper', occ=[], vals=[], step=0;
  const GROUP1=/اسم|هوية|سجل|الطرف|المؤجر|المستأجر|الشريك|البائع|المشتري|عنوان|جوال|هاتف|بريد|تاريخ|مدينة|الاسم/;
  function extract(text){
    occ=[]; const re=/\[([^\]\n]{1,60})\]/g; let m;
    while((m=re.exec(text))){ const ls=text.lastIndexOf('\n',m.index)+1; const ctx=text.slice(ls,m.index).replace(/[:：\s]+$/,'').trim().slice(-40); occ.push({start:m.index,len:m[0].length,label:(ctx?ctx+' — ':'')+m[1],g:GROUP1.test(ctx+' '+m[1])?1:2}); }
    vals=occ.map(()=>'');
  }
  function build(){ let out='',p=0; const t=curTpl.text; occ.forEach((o,i)=>{out+=t.slice(p,o.start)+(vals[i]||t.slice(o.start,o.start+o.len)); p=o.start+o.len;}); return out+t.slice(p); }
  function text(){ return mode==='stepper'?build():($('mText').textContent); }
  function refresh(){ if(mode==='stepper') $('mText').textContent=build(); }
  function render(){
    const box=$('stepBox'), steps=['بيانات الأطراف','التفاصيل المالية والمدة','المعاينة'];
    if(mode!=='stepper'){ Dom.show('stepBox',false); $('mText').contentEditable='plaintext-only'; $('mText').style.maxHeight=''; $('mText').textContent=curTpl.text; return; }
    $('mText').contentEditable='false'; $('mText').style.maxHeight=step===2?'':'28vh';
    Dom.show('stepBox',true);
    const idx=occ.map((o,i)=>i).filter(i=>step===0?occ[i].g===1:step===1?occ[i].g===2:false);
    const fields=step<2?(idx.length?idx.map(i=>`<div class="fld"><label>${esc(occ[i].label)}</label><input data-i="${i}" value="${esc(vals[i]).replace(/"/g,'&quot;')}"></div>`).join(''):'<div class="text-sm" style="color:#5d6a8a;padding:.6rem 0">لا حقول في هذه الخطوة، تابع للتالي.</div>'):'<div class="text-sm" style="color:#166534;padding:.4rem 0">راجع النص النهائي بالأسفل ثم أرسله إلى مساحة التدقيق.</div>';
    box.innerHTML=`<div class="stp">${steps.map((s,i)=>`<span class="${i===step?'on':''}">${i+1}. ${s}</span>`).join('')}</div>${occ.length?'':'<div class="text-sm" style="color:#5d6a8a">لا توجد حقول [ ] في هذا النموذج؛ استخدم التعديل اليدوي.</div>'}<div style="max-height:30vh;overflow:auto">${fields}</div>
      <div class="flex justify-between mt-3"><button type="button" class="btn-ghost px-4 py-1.5 text-sm" data-nav="-1" ${step===0?'disabled style="opacity:.4"':''}>السابق</button><button type="button" class="btn-ghost px-4 py-1.5 text-sm" data-nav="1" ${step===2?'disabled style="opacity:.4"':''}>التالي</button></div>`;
    refresh();
  }
  $('stepBox').addEventListener('input',e=>{ const i=e.target.dataset.i; if(i===undefined) return; vals[+i]=e.target.value; refresh(); });
  $('stepBox').addEventListener('click',e=>{ const n=e.target.dataset.nav; if(n===undefined) return; step=Math.max(0,Math.min(2,step+(+n))); render(); });
  $('tplMode').addEventListener('click',e=>{ const m=e.target.dataset.mode; if(!m) return; mode=m; step=0; [...$('tplMode').querySelectorAll('[data-mode]')].forEach(b=>b.classList.toggle('on',b.dataset.mode===m)); render(); });
  function open(i){ curTpl=TPL[i]; $('mTitle').textContent=curTpl.title; $('tplModal').classList.remove('hidden'); extract(curTpl.text); step=0; render(); }
  function send(){
    const t=text(); closeTpl(); NavModule.go('assistant');
    if(memoDone&&!busy){ resetChat(); welcome(); }
    contractEl.value=t; updateCount(); setTimeout(()=>$('assistant').scrollIntoView({behavior:'smooth'}),50); toast('أُرسل العقد إلى مساحة التدقيق');
  }
  /* ربط النافذة الأصلية */
  openTpl=open;
  $('mUse').textContent='أرسل إلى مساحة التدقيق';
  $('mUse').onclick=send;
  $('mCopy').onclick=async()=>{try{await navigator.clipboard.writeText(text());toast('تم نسخ النموذج');}catch{toast('تعذّر النسخ');}};
  $('mPrint').onclick=()=>{ const w=window.open('','_blank'); w.document.write('<html dir="rtl" lang="ar"><head><meta charset="utf-8"><link rel="icon" href="logo.jpg"><title>'+curTpl.title+'</title><style>body{font-family:Tajawal,sans-serif;padding:40px;line-height:2.1;white-space:pre-wrap}</style></head><body>'+esc(text())+'</body></html>'); w.document.close(); w.focus(); w.print(); };
  /* زر «دقّق» في البطاقة يمر بنفس المسار */
  useTpl=function(i){ const t=TPL[i].text; closeTpl(); NavModule.go('assistant'); if(memoDone&&!busy){resetChat();welcome();} contractEl.value=t; updateCount(); setTimeout(()=>$('assistant').scrollIntoView({behavior:'smooth'}),50); toast('أُدرج النموذج في مساعد مُحكَم'); };
  return {send};
})();

/* ---------- لوحة التحكم: عقودي السابقة ---------- */
const DashboardModule=(()=>{
  const KEY='muhkam_dash_v2';
  const SEED=[];
  function load(){ try{ let d=JSON.parse(localStorage.getItem(KEY)||'null'); if(!Array.isArray(d)){ d=SEED; localStorage.setItem(KEY,JSON.stringify(d)); } return d; }catch{ return SEED.slice(); } }
  function save(d){ try{localStorage.setItem(KEY,JSON.stringify(d));}catch{} }
  function record(md){
    const fl=Array.isArray(lastFlaws)?lastFlaws:[];
    const hi=fl.filter(f=>f.severity==='high').length, me=fl.filter(f=>f.severity==='medium').length, te=fl.filter(f=>f.severity==='term').length;
    const score=fl.length?Math.max(20,100-hi*15-me*8-te*3):70, risk=hi?'high':(me?'medium':'low');
    const first=(baseContract.split('\n').map(x=>x.trim()).find(x=>x.length>3)||'عقد بدون عنوان').slice(0,60);
    const d=load(); d.unshift({ref:'MHK-'+String(d.length+1).padStart(4,'0'),title:first,date:new Date().toISOString().slice(0,10),score,risk,flaws:fl.map(f=>f.title).filter(Boolean),memo:md}); save(d);
  }
  const RK={high:'عالٍ',medium:'متوسط',low:'منخفض'};
  function render(){
    const d=load(), cnt={}; d.forEach(x=>(x.flaws||[]).forEach(f=>cnt[f]=(cnt[f]||0)+1));
    const top=Object.entries(cnt).sort((a,b)=>b[1]-a[1])[0];
    const k=(t,v)=>`<div class="card stat"><div class="num" style="font-size:${String(v).length>8?'1.1rem':'2.3rem'}">${v}</div><div class="lbl">${t}</div></div>`;
    $('kpis').innerHTML=k('إجمالي العقود المدققة',d.length.toLocaleString('ar-SA'))+k('العقود المعتمدة (امتثال ≥ 80%)',d.filter(x=>x.score>=80).length.toLocaleString('ar-SA'))+k('أكثر الثغرات شيوعاً',top?esc(top[0]):'—');
    $('hist').innerHTML=d.length?d.map((x,i)=>`<tr><td>${esc(x.ref)}</td><td>${esc(x.title)}</td><td>${esc(x.date)}</td><td><b>${x.score}%</b></td><td><span class="rk rk-${x.risk}">${RK[x.risk]}</span></td><td><button class="btn-ghost px-3 py-1.5 text-xs" data-i="${i}">استعراض المذكرة</button></td></tr>`).join(''):'<tr><td colspan="6" style="text-align:center;color:#5d6a8a">لا توجد عقود محفوظة.</td></tr>';
  }
  $('hist').addEventListener('click',e=>{ const i=e.target.dataset.i; if(i===undefined) return; const x=load()[+i]; $('mmTitle').textContent=''+x.title+' · '+x.ref; $('mmBody').innerHTML=DOMPurify.sanitize(marked.parse(x.memo||'')); $('memoModal').classList.remove('hidden'); });
  $('mmClose').onclick=()=>$('memoModal').classList.add('hidden');
  $('memoModal').addEventListener('click',e=>{ if(e.target.id==='memoModal') $('memoModal').classList.add('hidden'); });
  $('clearHist').onclick=()=>{ if(confirm('مسح كل سجل العقود؟')){ save([]); render(); } };
  load();
  return {render,record};
})();
/* ربط الحفظ التلقائي بعد كل مذكرة تدقيق */
(()=>{ const _am=addMemo; addMemo=function(md){ _am(md); try{DashboardModule.record(md);}catch{} }; })();
/* ---------- مُشغّل مُحكَم الصوتي ---------- */
const SpeakModule=(()=>{
  const TTS_ENDPOINT='https://muhkam-tts.s445001732.workers.dev';
  const MAX_CHARS=1800, TIMEOUT_MS=60000;
  let active=null, generation=0;

  // تنظيف النص المستخرج من DOM المعروض فقط؛ لا يعاد تحرير الصياغة أو حذف الأرقام.
  function extractText(root){
    const clone=root.cloneNode(true);
    clone.querySelectorAll('button,script,style,.tts-player,[aria-hidden="true"]').forEach(n=>n.remove());
    const visibleText=(clone.innerText&&clone.innerText.trim())?clone.innerText:clone.textContent;
    return (visibleText||'')
      .replace(/\u00a0/g,' ')
      .replace(/[ \t]+\n/g,'\n')
      .replace(/\n[ \t]+/g,'\n')
      .replace(/\n{3,}/g,'\n\n')
      .trim();
  }

  // تقسيم متصل بلا إسقاط أو تكرار لأي حرف؛ تفضيل حدود الفقرات والجمل.
  function splitText(text){
    const out=[]; let rest=text;
    while(rest.length>MAX_CHARS){
      let cut=rest.lastIndexOf('\n',MAX_CHARS);
      if(cut<Math.floor(MAX_CHARS*.55)) cut=-1;
      if(cut<0){
        const candidates=['. ','؟ ','! ','؛ ','، ',' '];
        for(const sep of candidates){ const n=rest.lastIndexOf(sep,MAX_CHARS); if(n>Math.floor(MAX_CHARS*.55)){cut=n+sep.length;break;} }
      }
      if(cut<0) cut=MAX_CHARS;
      out.push(rest.slice(0,cut)); rest=rest.slice(cut);
    }
    if(rest.length) out.push(rest);
    return out;
  }

  function revoke(item){ if(item?.url){URL.revokeObjectURL(item.url);item.url=null;} }
  function stopCurrent(){
    generation++;
    if(active){
      active.cancelled=true;
      if(active.controller) active.controller.abort();
      if(active.audio){active.audio.pause();active.audio.removeAttribute('src');active.audio.load();}
      revoke(active.current);
      active.urls.forEach(x=>revoke(x));
      active.player?.remove();
      if(active.button){active.button.textContent='استمع';active.button.disabled=false;}
      active=null;
    }
  }
  function makeButton(label,handler,cls=''){
    const b=document.createElement('button'); b.type='button'; b.className='chip '+cls; b.textContent=label; b.addEventListener('click',handler); return b;
  }
  function renderPlayer(ctx){
    const box=ctx.player; box.replaceChildren();
    const status=document.createElement('span'); status.className='text-sm font-bold'; status.textContent=ctx.status;
    const controls=document.createElement('div'); controls.className='flex flex-wrap items-center gap-2 mt-2';
    const play=makeButton(ctx.paused?'▶ استئناف':'تشغيل',()=>resume(ctx));
    const pause=makeButton('إيقاف مؤقت',()=>pausePlayback(ctx)); pause.disabled=!ctx.audio;
    const stop=makeButton('إيقاف',()=>stopCurrent());
    const restart=makeButton('↻ إعادة التشغيل',()=>restartPlayback(ctx));
    const rate=document.createElement('select'); rate.className='chip'; rate.setAttribute('aria-label','سرعة القراءة');
    ['0.75','1','1.25','1.5'].forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v+'x';if(Number(v)===ctx.rate)o.selected=true;rate.appendChild(o);});
    rate.addEventListener('change',()=>{ctx.rate=Number(rate.value);if(ctx.audio)ctx.audio.playbackRate=ctx.rate;});
    controls.append(play,pause,stop,restart,rate); box.append(status,controls);
  }
  async function requestChunk(ctx,index){
    const controller=new AbortController(); ctx.controller=controller;
    const timer=setTimeout(()=>controller.abort(),TIMEOUT_MS);
    try{
      const response=await fetch(TTS_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({text:ctx.chunks[index]}),signal:controller.signal});
      if(!response.ok) throw new Error('تعذّر تحويل النص إلى صوت (HTTP '+response.status+').');
      const blob=await response.blob();
      if(!blob.size || !(blob.type.includes('audio') || blob.type==='application/octet-stream'))
        throw new Error('لم تصل استجابة صوتية صالحة من خدمة التحويل.');
      const item={url:URL.createObjectURL(blob)};ctx.urls.push(item);return item;
    }catch(err){
      if(err.name==='AbortError') throw new Error('انتهت مهلة الاتصال بخدمة الصوت. حاول مرة أخرى.');
      if(err instanceof TypeError) throw new Error('تعذّر الاتصال بخدمة الصوت. تحقق من اتصالك بالإنترنت.');
      throw err;
    }finally{clearTimeout(timer);if(ctx.controller===controller)ctx.controller=null;}
  }
  function waitForPlayback(ctx,audio,myGen){
    return new Promise((resolve,reject)=>{
      let settled=false;
      const done=(err)=>{if(settled)return;settled=true;audio.onended=audio.onerror=audio.onpause=null;err?reject(err):resolve();};
      audio.onended=()=>done();
      audio.onerror=()=>done(new Error('تعذّر تشغيل المقطع الصوتي.'));
      audio.onpause=()=>{if(ctx.cancelled||myGen!==generation)done(new Error('__cancelled__'));};
      audio.play().catch(e=>done(e));
    });
  }
  async function playFrom(ctx,start){
    const myGen=generation;
    ctx.paused=false;
    try{
      for(let i=start;i<ctx.chunks.length;i++){
        if(ctx.cancelled||myGen!==generation)return;
        ctx.index=i;ctx.status=`جارٍ تجهيز المقطع ${i+1} من ${ctx.chunks.length}…`;renderPlayer(ctx);
        const item=await requestChunk(ctx,i);
        if(ctx.cancelled||myGen!==generation){revoke(item);return;}
        ctx.current=item;ctx.audio=new Audio(item.url);ctx.audio.playbackRate=ctx.rate;
        ctx.status=`جارٍ تشغيل المقطع ${i+1} من ${ctx.chunks.length}`;renderPlayer(ctx);
        try{await waitForPlayback(ctx,ctx.audio,myGen);}
        catch(e){if(ctx.cancelled||myGen!==generation)return;throw e;}
        ctx.audio=null;revoke(item);ctx.current=null;
      }
      if(!ctx.cancelled&&myGen===generation){ctx.status='اكتمل تشغيل الإجابة.';renderPlayer(ctx);setTimeout(()=>{if(active===ctx)stopCurrent();},5000);}
    }catch(err){
      if(ctx.cancelled||myGen!==generation)return;
      ctx.status=err.message||'تعذّر تحويل النص إلى صوت.';renderPlayer(ctx);
      toast(ctx.status);
    }
  }
  function pausePlayback(ctx){
    if(active!==ctx||!ctx.audio)return;
    ctx.paused=true;ctx.status='متوقف مؤقتاً';ctx.audio.pause();renderPlayer(ctx);
  }
  function resume(ctx){
    if(active!==ctx)return;
    if(ctx.audio&&ctx.paused){ctx.paused=false;ctx.status='جارٍ استئناف القراءة';renderPlayer(ctx);ctx.audio.play().catch(()=>toast('تعذّر استئناف التشغيل.'));return;}
    if(ctx.paused){playFrom(ctx,ctx.index);return;}
    if(!ctx.started){ctx.started=true;playFrom(ctx,0);}
  }
  function restartPlayback(ctx){
    if(active!==ctx)return;
    if(ctx.controller)ctx.controller.abort();
    if(ctx.audio){ctx.audio.pause();ctx.audio=null;}
    revoke(ctx.current);ctx.current=null;ctx.paused=false;ctx.cancelled=false;
    generation++;ctx.index=0;ctx.started=true;ctx.status='جارٍ إعادة التشغيل…';renderPlayer(ctx);playFrom(ctx,0);
  }
  function toggle(text,button){
    if(active?.button===button){stopCurrent();return;}
    stopCurrent();
    const clean=String(text||'').trim();
    if(!clean){toast('لا يوجد نص قابل للاستماع.');return;}
    const chunks=splitText(clean);
    const player=document.createElement('div');player.className='tts-player mt-3 p-3 rounded-xl';player.style.cssText='background:#EEF3FA;border:1px solid #C9D4EA;color:#263065';
    const ctx={button,player,chunks,urls:[],audio:null,current:null,controller:null,index:0,rate:1,paused:false,cancelled:false,started:false,status:chunks.length>1?`جارٍ تجهيز النص (${chunks.length} مقاطع)…`:'جارٍ تجهيز الصوت…'};
    active=ctx;button.textContent='جارٍ تجهيز الصوت…';button.disabled=true;
    button.closest('.bub')?.appendChild(player);
    renderPlayer(ctx);
    // زر الإجابة يتحول إلى أداة إظهار المشغل؛ بدء الطلب يتم مباشرة بعد النقر.
    ctx.started=true;playFrom(ctx,0);
    button.textContent='مشغل الصوت';button.disabled=false;
  }
  return {toggle,stop:stopCurrent,extractText};
})();

// قراءة نص العقد الملصق في صندوق التحرير مباشرة، لا نص إجابة المساعد فقط.
$('readContractBtn').addEventListener('click',()=>{
  const text=String(contractEl.value||'').trim();
  if(!text){toast('الصق نص العقد أولاً ثم اضغط زر القراءة.');return;}
  SpeakModule.toggle(text,$('readContractBtn'));
});

const MicModule=(()=>{
  let recognition=null, activeButton=null, finalText='';
  const SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
  function toggle(btn,onText){
    if(!SpeechRecognition){
      toast('الإملاء الصوتي غير مدعوم في هذا المتصفح. جرّب متصفحاً يدعم التعرف الصوتي أو أرسل لنا واجهة خدمة STT المخصصة.');
      return;
    }
    if(recognition&&activeButton===btn){
      recognition.stop();
      return;
    }
    if(recognition){ try{recognition.stop();}catch{} }
    finalText=''; activeButton=btn;
    const rec=new SpeechRecognition(); recognition=rec;
    rec.lang='ar-SA'; rec.continuous=true; rec.interimResults=true;
    btn.classList.add('rec'); btn.innerHTML=STOP_SVG;
    toast('جارٍ الاستماع… اضغط الزر مرة أخرى عند الانتهاء');
    rec.onresult=e=>{
      let interim='';
      for(let i=e.resultIndex;i<e.results.length;i++){
        const piece=e.results[i][0]?.transcript||'';
        if(e.results[i].isFinal) finalText+=(finalText?' ':'')+piece.trim();
        else interim+=piece;
      }
      btn.title=interim?'جارٍ التعرف: '+interim:'اضغط لإيقاف الإملاء';
    };
    rec.onerror=e=>{
      const messages={ 'not-allowed':'اسمح للمتصفح باستخدام الميكروفون.','audio-capture':'تعذّر الوصول إلى الميكروفون.','network':'تعذّر الاتصال بخدمة التعرف الصوتي.','no-speech':'لم يُلتقط كلام واضح.' };
      toast(messages[e.error]||'تعذّر التعرف على الصوت: '+e.error);
    };
    rec.onend=()=>{
      if(recognition!==rec)return;
      recognition=null; activeButton=null;
      btn.classList.remove('rec'); btn.innerHTML=MIC_SVG; btn.title='إملاء صوتي';
      const result=finalText.trim();
      if(result) onText(result);
      else toast('لم يتم التعرف على كلام. حاول مرة أخرى.');
    };
    try{rec.start();}catch(err){
      recognition=null;activeButton=null;btn.classList.remove('rec');btn.innerHTML=MIC_SVG;
      toast('تعذّر بدء الإملاء الصوتي. '+(err.message||''));
    }
  }
  $('micBtn').onclick=()=>{ if(!busy) toggle($('micBtn'),t=>{ contractEl.value=(contractEl.value?contractEl.value+' ':'')+t; updateCount(); contractEl.focus(); }); };
  return {toggle};
})();

/* ---------- الواجهة الرئيسية v3 ---------- */
(function HomeUI(){
  const jp=[...document.querySelectorAll('#jr .jp')]; let cur=0,tm;
  const set=i=>{cur=i;jp.forEach((p,k)=>{p.classList.remove('on');if(k===i){void p.offsetWidth;p.classList.add('on');}});clearTimeout(tm);tm=setTimeout(()=>set((cur+1)%jp.length),5000);};
  jp.forEach((p,i)=>p.onclick=()=>set(i)); set(0);
  const row=(c,t)=>`<div class="alert-i ${c}">${t}</div>`;
  const SV=[
   {n:'01',t:'التدقيق التعاقدي الاستباقي',s:'تحليل العقد وكشف المخاطر قبل التوقيع',st:'متاح',go:'assistant',cta:'ابدأ التدقيق',
    b:['تحليل البنود واكتشاف التعارضات والبنود الناقصة وغير المتوازنة','ملخص ذكي للحقوق والالتزامات والدفعات والمواعيد','اختبار تحمّل العقد أمام سيناريوهات الإخلال','تحليل المخاطر القانونية والتعاقدية والمالية والضريبية','تعديلات مقترحة مسندة إلى الأنظمة السعودية وإعادة اختبارها'],
    pv:()=>'<b class="block mt-2">شكل المخرجات (مثال توضيحي)</b>'+row('high','<b>خطورة عالية</b> إنهاء منفرد دون إخطار')+row('medium','<b>متوسطة</b> مدة سداد غير منضبطة')+row('','<b>التحقق:</b> التعديل المقترح «عالج الثغرة»')},
   {n:'02',t:'مكتبة القوالب التعاقدية',s:'نماذج جاهزة وتعبئة موجّهة',st:'متاح',go:'library',cta:'افتح المكتبة',
    b:['قوالب لأنواع العقود التجارية ونماذج الشركات','تعبئة البيانات والمتغيرات بالخطوات','إرسال العقد الناتج للتدقيق مباشرة','مكتبة خاصة بكل منشأة وحفظ القوالب المعتمدة <span class="tag soon">قريباً</span>'],
    pv:()=>'<b class="block mt-2">من المكتبة الآن</b>'+TPL.filter(t=>t.text).slice(0,5).map(t=>row('',esc(t.title))).join('')},
   {n:'03',t:'مستشارو مُحكم',s:'حجز موعد مع مختص تدقيق أو استشارة قانونية',st:'تجريبي',go:'advisors',cta:'احجز موعداً',
    b:['حجز موعد لمراجعة عقدك مع مختص بالتدقيق','استشارات قانونية في العقود التجارية والشركات والعمل والعقارات','اختيار التخصص ونوع الاتصال والموعد المناسب','إرفاق العقد (بعد حجب بياناته) بموافقتك'],
    pv:()=>'<b class="block mt-2">مسار الحجز</b>'+row('','١. اختيار الخدمة والتخصص')+row('','٢. اختيار اليوم والوقت')+row('','٣. بياناتك وإرسال الطلب')}];
  const L=$('svl'),P=$('svp');
  L.innerHTML=SV.map((x,i)=>`<button type="button" class="svb" data-i="${i}">${x.n} · ${x.t}<small>${x.s}</small></button>`).join('');
  const show=i=>{const x=SV[i];[...L.children].forEach((b,k)=>b.classList.toggle('on',k===i));
    P.innerHTML=`<h3 class="font-extrabold text-xl">${x.t}<span class="tag ${x.st==='متاح'?'ok':'soon'}">${x.st}</span></h3><ul>${x.b.map(y=>'<li>'+y+'</li>').join('')}</ul><div class="pvx">${x.pv()}</div><button type="button" class="btn-gold px-5 py-2.5 mt-4" data-go="${x.go}">${x.cta}</button>`;};
  L.onclick=e=>{const b=e.target.closest('.svb'); if(b) show(+b.dataset.i);}; show(0);
  const PN=[['NLP','فهم النص والسياق'],['NER','استخراج الأطراف والمبالغ والتواريخ'],['RAG','ربط النتائج بالمصادر النظامية'],['محرك القواعد','فحص الشروط والمتطلبات'],['اختبار السيناريوهات','تغطية حالات الإخلال'],['الحسابات المالية','أثر مالي بمعادلات محددة'],['التحقق التكراري','إعادة اختبار التعديلات']];
  $('pipe').innerHTML=PN.map((n,i)=>`<div class="pn rv"><b>${n[0]}</b><span>${n[1]}</span></div>`+(i<PN.length-1?'<span class="pa">←</span>':'')).join('');
  const io=new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}}),{threshold:.15});
  document.querySelectorAll('.rv').forEach(e=>io.observe(e));
})();

/* ---------- تحرير العقد (ضمن المساعد) ---------- */
(function EditModule(){
  const m=$('editModal'),t=$('edText'),close=()=>m.classList.add('hidden');
  $('btnEdit').onclick=()=>{ const x=(memoDone?baseContract:contractEl.value).trim(); if(!x){toast('أدخل نص العقد أولاً');return;} t.value=x; $('edImpr').classList.add('hidden'); m.classList.remove('hidden'); };
  $('edClose').onclick=close; m.addEventListener('click',e=>{ if(e.target===m) close(); });
  $('edImprove').onclick=async()=>{
    const s=t.selectionStart,e=t.selectionEnd; if(e<=s){toast('حدد بنداً أولاً');return;}
    const x=t.value.slice(s,e); if(x.length>4000){toast('حدد بنداً واحداً (حتى 4000 حرف)');return;}
    const p=$('edImpr'); p.classList.remove('hidden'); p.innerHTML='<span class="dots"><span></span><span></span><span></span></span> جارٍ تحسين الصياغة…';
    const r=await DraftingImproverModule.improve(x); p.innerHTML=DraftingImproverModule.card(r,'adoptEd');
    const a=$('adoptEd'); if(a) a.onclick=()=>{ t.value=t.value.slice(0,s)+r.rewrite+t.value.slice(e); p.classList.add('hidden'); toast('تم اعتماد الصياغة'); };
  };
  $('edApply').onclick=()=>{ if(busy) return; const x=t.value.trim(); if(x.length<120){toast('النص قصير للتدقيق');return;} close(); NavModule.go('assistant'); resetChat(); welcome(); contractEl.value=x; updateCount(); send(); };
  $('edDown').onchange=e=>{
    const f=e.target.value; e.target.value=''; if(!f) return; const x=t.value;
    if(f==='pdf'){ const w=window.open('','_blank'); if(!w){toast('اسمح بالنوافذ المنبثقة');return;} w.document.write('<html dir="rtl" lang="ar"><head><meta charset="utf-8"><style>body{font-family:Tajawal,sans-serif;padding:40px;line-height:2.1;white-space:pre-wrap}</style></head><body>'+esc(x)+'</body></html>'); w.document.close(); setTimeout(()=>w.print(),300); return; }
    const doc=f==='doc', b=new Blob(['\ufeff'+(doc?'<html dir="rtl"><head><meta charset="utf-8"></head><body style="white-space:pre-wrap;line-height:2">'+esc(x)+'</body></html>':x)],{type:doc?'application/msword':'text/plain;charset=utf-8'});
    const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='muhkam-contract.'+(doc?'doc':'txt'); document.body.appendChild(a); a.click(); a.remove();
  };
  $('btnHighlight'); 
})();

/* ---------- مستشارو مُحكم: حجز المواعيد ---------- */
(function AdvisorsModule(){
  const BK_URL='', KEY='muhkam_bookings_v1'; /* ضع هنا رابط خدمة استقبال الحجوزات (Worker) ليصل الطلب لفريقكم */
  const SPEC=['عقود تجارية','عقود الشركات','عقود العمل','العقارات','التوريد والمقاولات','التحكيم وتسوية المنازعات'];
  const SVC={audit:'مراجعة عقد مع مختص تدقيق',consult:'استشارة قانونية'}, MODE=['اتصال مرئي','اتصال هاتفي'];
  const TIMES=[]; for(let h=9;h<16;h++){ const p=String(h).padStart(2,'0'); TIMES.push(p+':00',p+':30'); }
  const st={step:0,svc:'audit',spec:SPEC[0],mode:MODE[0],date:'',time:'',name:'',phone:'',email:'',note:'',att:false,ok:false,done:null};
  const load=()=>{ try{return JSON.parse(localStorage.getItem(KEY)||'[]');}catch{return[];} };
  const save=d=>{ try{localStorage.setItem(KEY,JSON.stringify(d));}catch{} };
  const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  const fmt=d=>new Date(d+'T00:00').toLocaleDateString('ar-EG',{weekday:'long',day:'numeric',month:'long'});
  const days=()=>{ const o=[],d=new Date(); d.setHours(0,0,0,0); while(o.length<10){ d.setDate(d.getDate()+1); if(d.getDay()!==5&&d.getDay()!==6) o.push(iso(d)); } return o; };
  const opt=(k,v,t,dis)=>`<button type="button" class="opt ${st[k]===v?'on':''}" data-k="${k}" data-v="${v}" ${dis?'disabled':''}>${t}</button>`;
  const box=$('bk');
  function render(){
    if(st.done){ box.innerHTML=`<div class="text-center" style="line-height:2.2"><div class="fnum" style="margin:0 auto .6rem">✓</div><h3 class="font-extrabold text-xl">استُلم طلب الحجز</h3><p>رقم المرجع: <b>${st.done.ref}</b><br>${esc(SVC[st.done.svc])} · ${esc(st.done.spec)}<br>${fmt(st.done.date)} · ${st.done.time} · ${esc(st.done.mode)}</p><p style="color:#cbd8ea">سيتواصل معك فريق مُحكم لتأكيد الموعد. هذه المرئيات لا تُغني عن المحامي ولا تُعد استشارة قانونيَّة.</p><button type="button" class="btn-gold px-5 py-2.5 mt-3" data-new="1">حجز موعد آخر</button></div>`; return; }
    const booked=load().filter(b=>b.date===st.date&&b.spec===st.spec).map(b=>b.time);
    const steps=['الخدمة والتخصص','الموعد','بياناتك'];
    let body='';
    if(st.step===0) body=`<h4>نوع الخدمة</h4><div class="flex flex-wrap gap-2">${Object.keys(SVC).map(k=>opt('svc',k,SVC[k])).join('')}</div><h4>التخصص</h4><div class="flex flex-wrap gap-2">${SPEC.map(x=>opt('spec',x,x)).join('')}</div><h4>نوع الاتصال</h4><div class="flex flex-wrap gap-2">${MODE.map(x=>opt('mode',x,x)).join('')}</div>`;
    if(st.step===1) body=`<h4>اليوم (الأحد – الخميس)</h4><div class="flex flex-wrap gap-2">${days().map(d=>opt('date',d,fmt(d))).join('')}</div><h4>الوقت (جلسة 30 دقيقة)</h4><div class="flex flex-wrap gap-2">${st.date?TIMES.map(x=>opt('time',x,x,booked.includes(x))).join(''):'<span style="color:#cbd8ea">اختر اليوم أولاً</span>'}</div>`;
    if(st.step===2) body=`<div class="fld"><label>الاسم الكامل *</label><input data-f="name" value="${esc(st.name)}"><label>رقم الجوال *</label><input data-f="phone" placeholder="05XXXXXXXX" value="${esc(st.phone)}"><label>البريد الإلكتروني</label><input data-f="email" value="${esc(st.email)}"><label>نبذة عن حاجتك</label><textarea data-f="note" rows="3">${esc(st.note)}</textarea></div>
      <label class="flex gap-2 mt-3 text-sm items-start"><input type="checkbox" data-c="att" ${st.att?'checked':''} ${baseContract?'':'disabled'}> إرفاق العقد الحالي من المساعد (بعد حجب بياناته الحساسة)${baseContract?'':' — لا يوجد عقد مدقَّق حالياً'}</label>
      <label class="flex gap-2 mt-2 text-sm items-start"><input type="checkbox" data-c="ok" ${st.ok?'checked':''}> أوافق على مشاركة هذه البيانات مع فريق مُحكم لغرض الحجز والتواصل.</label>`;
    box.innerHTML=`<div class="stp">${steps.map((x,i)=>`<span class="${i===st.step?'on':''}">${i+1}. ${x}</span>`).join('')}</div>${body}<div class="flex justify-between mt-5"><button type="button" class="btn-ghost px-4 py-2 text-sm" data-nav="-1" ${st.step===0?'disabled style="opacity:.4"':''}>السابق</button>${st.step<2?'<button type="button" class="btn-gold px-5 py-2 text-sm" data-nav="1">التالي</button>':'<button type="button" class="btn-gold px-5 py-2 text-sm" data-send="1">إرسال طلب الحجز</button>'}</div>`;
  }
  function list(){
    const d=load(); $('bkList').innerHTML=d.length?d.map(b=>`<div class="bki"><div><b>${b.ref}</b> · ${esc(SVC[b.svc])}<br>${esc(b.spec)} · ${fmt(b.date)} · ${b.time}</div><div><span class="rk rk-medium">بانتظار التأكيد</span> <button type="button" class="btn-ghost px-3 py-1 text-xs" data-x="${b.ref}">إلغاء</button></div></div>`).join(''):'<div class="text-sm" style="color:#5d6a8a">لا توجد حجوزات بعد.</div>';
  }
  box.addEventListener('input',e=>{ const f=e.target.dataset.f; if(f) st[f]=e.target.value; });
  box.addEventListener('change',e=>{ const c=e.target.dataset.c; if(c) st[c]=e.target.checked; });
  box.addEventListener('click',async e=>{
    const o=e.target.closest('.opt'), b=e.target;
    if(o){ st[o.dataset.k]=o.dataset.v; if(o.dataset.k==='date') st.time=''; render(); return; }
    if(b.dataset.new){ Object.assign(st,{step:0,done:null,date:'',time:'',ok:false}); render(); return; }
    if(b.dataset.nav){ const n=st.step+(+b.dataset.nav); if(n===2&&(!st.date||!st.time)){toast('اختر اليوم والوقت');return;} st.step=Math.max(0,Math.min(2,n)); render(); return; }
    if(b.dataset.send){
      const ph=st.phone.replace(/\s/g,'');
      if(st.name.trim().length<3){toast('أدخل الاسم الكامل');return;}
      if(!/^(\+?966|0)?5\d{8}$/.test(ph)){toast('رقم الجوال غير صحيح');return;}
      if(st.email&&!/^\S+@\S+\.\S+$/.test(st.email)){toast('البريد الإلكتروني غير صحيح');return;}
      if(!st.ok){toast('يلزم الموافقة على مشاركة البيانات');return;}
      const bk={ref:'MSH-'+Date.now().toString(36).toUpperCase().slice(-5),svc:st.svc,spec:st.spec,mode:st.mode,date:st.date,time:st.time};
      if(BK_URL){ try{ const r=await fetch(BK_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...bk,name:st.name,phone:ph,email:st.email,note:st.note,contract:st.att?baseContract:''})}); if(!r.ok) throw 0; }catch{ toast('تعذّر إرسال الطلب، حاول مرة أخرى'); return; } }
      const d=load(); d.unshift(bk); save(d); st.done=bk; render(); list(); return;
    }
  });
  $('bkList').addEventListener('click',e=>{ const r=e.target.dataset.x; if(r){ save(load().filter(b=>b.ref!==r)); list(); render(); } });
  window.AdvisorsRefresh=()=>{ render(); list(); };
  render(); list();
})();

/* روابط الأقسام (بطاقات المزايا والتذييل) */
document.addEventListener('click',e=>{ const b=e.target.closest('[data-go]'); if(b) NavModule.go(b.dataset.go,b.dataset.anchor); });
</script>
<button type="button" id="toTop" aria-label="الصعود إلى أعلى الصفحة"><svg viewBox="0 0 56 56" aria-hidden="true"><circle class="tr" cx="28" cy="28" r="24"/><circle class="pg" cx="28" cy="28" r="24"/></svg><svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="transform:none" aria-hidden="true"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg></button>
<script>
(function(){
  var b=document.getElementById('toTop'),pg=b.querySelector('.pg');
  function u(){var h=document.documentElement.scrollHeight-innerHeight,y=scrollY,p=h>0?Math.min(1,y/h):0;pg.style.strokeDashoffset=151*(1-p);b.classList.toggle('show',y>400);}
  addEventListener('scroll',u,{passive:true});addEventListener('resize',u);u();
  b.addEventListener('click',function(){scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'});});
  document.addEventListener('click',function(e){var t=e.target.closest('[data-tool]');if(!t)return;var x=document.getElementById(t.dataset.tool);if(x)x.click();});
  try{var s=document.getElementById('tplSel'),g={};TPL.forEach(function(t,i){var c=t.cat||'أخرى';(g[c]=g[c]||[]).push([i,t.title]);});
    Object.keys(g).forEach(function(c){var og=document.createElement('optgroup');og.label=c;g[c].forEach(function(a){var o=document.createElement('option');o.value=a[0];o.textContent=a[1];og.appendChild(o);});s.appendChild(og);});
    s.addEventListener('change',function(){if(s.value!==''){openTpl(+s.value);s.value='';}});}catch(err){console.warn(err);}
})();
</script>
</body>
</html>
